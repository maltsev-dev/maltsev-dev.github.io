---
import { DEFAULT_RAMP, THEMES } from '../data/themes';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// The theme list lives in src/data/themes.ts, together with the ramps the
// stylesheet defines and the chrome color of each one. It used to be
// written out here as well as in the boot script in the head and in the
// table of ramps in os.js — three copies of the same four names, free to
// drift apart.

const SOURCES = [
  { href: '/experience/', label: 'Experience', key: '1', desc: 'the road so far' },
  { href: '/freelance/', label: 'Engagements', key: '2', desc: 'fixed-scope work' },
  { href: '/projects/', label: 'Projects', key: '3', desc: 'shipped systems' },
  { href: '/about/', label: 'Profile', key: '4', desc: 'who and what I do' },
];

const isActive = (href: string) => currentPath.startsWith(href);
---

<nav class="menu-bar" aria-label="Site">
  <div class="wrap">
    <!-- The glyph is the brand, but "A|M" is not a name: a screen reader read
         it out as "A vertical bar M". The home link says what it is. -->
    <a href="/" class="menu-brand" aria-label="Maltsev — home">A|M</a>

    <div class="menu-group">
    <div class="menu">
      <!--
        The panel is a disclosure, not a menu: it is a list of links, and it
        does not implement the arrow-key menu interaction. Saying `menu` here
        promised an interaction the site does not have, so the button says what
        it actually controls instead.
      -->
      <button class="menu-btn" data-menu="sources" aria-expanded="false" aria-controls="menu-sources">
        Sources <span class="caret" aria-hidden="true">▾</span>
      </button>
      <div class="dropdown" id="menu-sources" data-panel="sources" hidden>
        <p class="dropdown-title">Index</p>
        {
          SOURCES.map((s) => (
            <a
              class="dd-item"
              href={s.href}
              data-goto={s.key}
              aria-current={isActive(s.href) ? 'page' : undefined}
            >
              <span class="fig" aria-hidden="true">{s.key}</span>
              <span>
                {s.label}
                <span class="desc">{s.desc}</span>
              </span>
              <kbd>{s.key}</kbd>
            </a>
          ))
        }
      </div>
    </div>

    <a
      href="/blog/"
      class="menu-btn menu-link"
      aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Writing</a
    >

    <div class="menu">
      <button class="menu-btn" data-menu="system" aria-expanded="false" aria-controls="menu-system">
        System <span class="caret" aria-hidden="true">▾</span>
      </button>
      <div class="dropdown dropdown-right" id="menu-system" data-panel="system" hidden>
        <p class="dropdown-title" id="theme-group-label">Appearance</p>
        <!--
          The themes are one of several, so they are a radio group and not a
          row of buttons. The role used to be `menuitemradio` inside a panel
          with no `menu` role, which left a screen reader announcing a menu
          item radio that belonged to no menu, and the panel's own `menu` role
          would have implied arrow-key navigation that was not implemented.
          `radio` in a `radiogroup` says exactly what this is; os.js gives the
          group the arrow-key behavior that goes with it.
        -->
        <div role="radiogroup" aria-labelledby="theme-group-label" data-theme-group>
          {
            THEMES.map((theme) => (
              <button
                class="dd-item"
                data-set-theme={theme.id}
                role="radio"
                aria-checked={theme.id === DEFAULT_RAMP ? 'true' : 'false'}
                tabindex={theme.id === DEFAULT_RAMP ? '0' : '-1'}
              >
                {/* The glyph is drawn by CSS so the selected theme can show a
                    filled mark instead of the hollow one. */}
                <span class="fig" aria-hidden="true" />
                <span>
                  {theme.label}
                  <span class="desc">{theme.desc}</span>
                </span>
              </button>
            ))
          }
        </div>
        <div class="dd-sep"></div>
        <a class="dd-item" href="/llms.txt">
          <span class="fig" aria-hidden="true">≡</span>
          <span>
            llms.txt
            <span class="desc">for agents</span>
          </span>
        </a>
        <!--
          The visible way into the command palette. Ctrl+K is the shortcut,
          but a shortcut is not a way in for a reader on a phone or a screen
          reader, so the palette keeps a real control here — next to the
          theme picker, which it belongs with.
        -->
        <button class="dd-item" type="button" data-open-palette>
          <span class="fig" aria-hidden="true">⌘</span>
          <span>
            Command palette
            <span class="desc">Ctrl+K</span>
          </span>
        </button>
      </div>
    </div>
    </div>

    <nav class="social" aria-label="Elsewhere">
      <!--
        The command palette has no permanent trigger in the header. It used to
        have one — a magnifier in the social row — and the row is the one
        place on the page that means "here are my other identities": a
        search box is not one of them, and it sat among five links to places
        where the work actually is.

        The palette keeps a visible entry inside the System menu, next to the
        theme picker it belongs with, and Ctrl+K still opens it from anywhere.
      -->

      <a
        class="social-link"
        href="https://github.com/maltsev-dev"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56
               0-.28-.01-1.02-.02-2-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68
               -1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96
               .1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09
               -.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49
               3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09
               0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18
               0 .31.2.68.8.56C20.71 21.39 24 17.08 24 12c0-6.27-5.23-11.5-11.5-11.5Z"
          ></path>
        </svg>
      </a>

      <a
        class="social-link"
        href="https://www.linkedin.com/in/a-maltsev"
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85
               3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22
               0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"
          ></path>
        </svg>
      </a>

      <a
        class="social-link"
        href="https://t.me/a_maltsev_dev"
        target="_blank"
        rel="noopener"
        aria-label="Telegram — @a_maltsev_dev"
        title="@a_maltsev_dev"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M21.94 4.3 19.2 19.1c-.2 1.06-.83 1.32-1.68.82l-4.66-3.44-2.25 2.17c-.25.25-.46.46-.94.46l.33-4.78
               8.7-7.84c.38-.34-.08-.53-.59-.19L6.98 13.1 2.4 11.7c-1-.31-1.02-1 .21-1.48L20.55 2.9c.83-.3 1.56.2 1.39 1.4Z"
          ></path>
        </svg>
      </a>

      <a
        class="social-link"
        href="mailto:mr.a.maltsev@gmail.com"
        aria-label="Email — mr.a.maltsev@gmail.com"
        title="mr.a.maltsev@gmail.com"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM4 6.8l8 6 8-6v1.6l-8 6-8-6V6.8Z"
            clip-rule="evenodd"
          ></path>
        </svg>
      </a>

      <!-- `download` is same-origin, so the browser saves the file instead of
           navigating to it. Drop the PDF at static/resume.pdf.

           The saved name is spelled one way and one way only: the name of the
           author, hyphenated, with the document named after it. The repo used
           to carry three spellings of the same file — `Anatolii-Maltsev-resume.pdf`
           at the root, `Anatolii_Maltsev_Resume.pdf` beside it, and `resume.pdf`
           in `static/` — and the one the browser used did not match any of the
           other two. -->
      <a
        class="social-link"
        href="/resume.pdf"
        download="Anatolii-Maltsev-Resume.pdf"
        aria-label="Profile as PDF"
        title="Profile as PDF"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M6 2h8l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2ZM14 2v4a1 1 0 0 0 1 1h4L14 2ZM7 12h8v1.5H7V12Zm0 3.5h5V17H7v-1.5Z"
            clip-rule="evenodd"
          ></path>
        </svg>
      </a>
    </nav>

    <!-- Flat list for narrow screens, where dropdowns are not worth the space. -->
    <ul class="menu-quick">
      {
        SOURCES.map((s) => (
          <li>
            <a href={s.href} class="nav-link" aria-current={isActive(s.href) ? 'page' : undefined}>
              {s.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/blog/" class="nav-link" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>
          Writing
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .menu-link {
    text-decoration: none;
  }

  .menu-link:hover,
  .menu-link[aria-current='page'] {
    border-color: var(--braise);
    background: var(--rouille);
    color: var(--fort);
  }

  .dropdown-right {
    left: auto;
    right: 0;
  }
</style>