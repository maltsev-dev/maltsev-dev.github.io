---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Keep the theme names in sync with the ramps in global.css and the boot
// script in Base.astro. A name missing from any one of the three falls back
// to the default.
const THEMES = [
  ['phosphore', 'amber on black'],
  ['acidule', 'green on teal'],
  ['pierre', 'warm light'],
];

const SOURCES = [
  { href: '/projects/', label: 'Projects', key: '1', desc: 'shipped systems' },
  { href: '/experience/', label: 'Experience', key: '2', desc: 'the road so far' },
  { href: '/about/', label: 'Profile', key: '3', desc: 'who and what I do' },
  { href: '/contact/', label: 'Contact', key: '4', desc: 'write to me' },
];

const isActive = (href: string) => currentPath.startsWith(href);
---

<nav class="menu-bar" aria-label="Site">
  <div class="wrap">
    <a href="/" class="menu-brand">A|M</a>

    <div class="menu-group">
    <div class="menu">
      <button class="menu-btn" data-menu="sources" aria-expanded="false" aria-haspopup="true">
        Sources <span class="caret" aria-hidden="true">▾</span>
      </button>
      <div class="dropdown" data-panel="sources" hidden>
        <p class="dropdown-title">Index</p>
        {
          SOURCES.map((s) => (
            <a
              class="dd-item"
              href={s.href}
              data-goto={s.key}
              aria-current={isActive(s.href) ? 'page' : undefined}
            >
              <span class="fig" aria-hidden="true">{s.key}</span>
              <span>
                {s.label}
                <span class="desc">{s.desc}</span>
              </span>
              <kbd>{s.key}</kbd>
            </a>
          ))
        }
      </div>
    </div>

    <a
      href="/blog/"
      class="menu-btn menu-link"
      aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Blog</a
    >

    <div class="menu">
      <button class="menu-btn" data-menu="system" aria-expanded="false" aria-haspopup="true">
        Theme <span class="caret" aria-hidden="true">▾</span>
      </button>
      <div class="dropdown dropdown-right" data-panel="system" hidden>
        <p class="dropdown-title">Appearance</p>
        {
          THEMES.map(([id, desc]) => (
            <button class="dd-item" data-set-theme={id} role="menuitemradio" aria-checked="false">
              <span class="fig" aria-hidden="true">◆</span>
              <span>
                {id}
                <span class="desc">{desc}</span>
              </span>
            </button>
          ))
        }
        <div class="dd-sep"></div>
        <button class="dd-item" data-action="crt">
          <span class="fig" aria-hidden="true">◐</span>
          <span>
            Scanlines
            <span class="desc" data-crt-label>on</span>
          </span>
        </button>
        <button class="dd-item" data-action="palette">
          <span class="fig" aria-hidden="true">⌘</span>
          <span>
            Command palette
            <span class="desc">find anything</span>
          </span>
          <kbd>Ctrl K</kbd>
        </button>
      </div>
    </div>

    <a
      class="gh-link"
      href="https://github.com/maltsev-dev"
      target="_blank"
      rel="noopener"
      aria-label="GitHub — maltsev-dev"
      title="GitHub"
      hidden
    ></a>
    </div>

    <nav class="social" aria-label="Elsewhere">
      <a
        class="social-link"
        href="https://github.com/maltsev-dev"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56
               0-.28-.01-1.02-.02-2-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68
               -1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96
               .1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09
               -.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49
               3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09
               0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18
               0 .31.2.68.8.56C20.71 21.39 24 17.08 24 12c0-6.27-5.23-11.5-11.5-11.5Z"
          ></path>
        </svg>
      </a>

      <a
        class="social-link"
        href="https://www.linkedin.com/in/a-maltsev"
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85
               3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22
               0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"
          ></path>
        </svg>
      </a>

      <a
        class="social-link"
        href="https://t.me/a_maltsev_dev"
        target="_blank"
        rel="noopener"
        aria-label="Telegram — @a_maltsev_dev"
        title="@a_maltsev_dev"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M21.94 4.3 19.2 19.1c-.2 1.06-.83 1.32-1.68.82l-4.66-3.44-2.25 2.17c-.25.25-.46.46-.94.46l.33-4.78
               8.7-7.84c.38-.34-.08-.53-.59-.19L6.98 13.1 2.4 11.7c-1-.31-1.02-1 .21-1.48L20.55 2.9c.83-.3 1.56.2 1.39 1.4Z"
          ></path>
        </svg>
      </a>
    </nav>

    <!-- Flat list for narrow screens, where dropdowns are not worth the space. -->
    <ul class="menu-quick">
      {
        SOURCES.map((s) => (
          <li>
            <a href={s.href} class="nav-link" aria-current={isActive(s.href) ? 'page' : undefined}>
              {s.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/blog/" class="nav-link" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>
          Blog
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .menu-link {
    text-decoration: none;
  }

  .menu-link:hover,
  .menu-link[aria-current='page'] {
    border-color: var(--braise);
    background: var(--rouille);
    color: var(--fort);
  }

  .gh-link {
    display: inline-flex;
    align-items: center;
    align-self: center;
    padding: 0.4rem;
    color: var(--encre);
    transition: color 160ms ease, transform 160ms ease;
  }

  .gh-link:hover {
    color: var(--braise);
    transform: translateY(-1px);
  }

  .dropdown-right {
    left: auto;
    right: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gh-link {
      transition: none;
    }
  }
</style>