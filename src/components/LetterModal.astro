---
/**
 * The contact dialog. Any element with [data-open-letter] opens it.
 *
 * There is no form in here. A form is a request for the visitor to write a
 * message, to send it through a mail client that may not open, and to wait
 * for a reply that has to arrive by email. Four links to four channels do
 * the same job without the middle step, and the visitor picks the channel
 * that suits them: a message for a brief, a profile for a look at the work.
 */
const CHANNELS = [
  {
    name: 'Telegram',
    value: '@a_maltsev_dev',
    href: 'https://t.me/a_maltsev_dev',
    desc: 'The fastest way to reach me. A couple of lines is enough to start.',
  },
  {
    name: 'GitHub',
    value: 'github.com/maltsev-dev',
    href: 'https://github.com/maltsev-dev',
    desc: 'The code, the notes behind it, and the issues that are still open.',
  },
  {
    name: 'LinkedIn',
    value: 'linkedin.com/in/a-maltsev',
    href: 'https://www.linkedin.com/in/a-maltsev',
    desc: 'The work history, if you would rather read it than read the code.',
  },
  {
    name: 'Email',
    value: 'mr.a.maltsev@gmail.com',
    href: 'mailto:mr.a.maltsev@gmail.com',
    desc: 'For a brief with detail in it: scope, timeline, what breaks today.',
  },
];
---

<div class="letter" id="letterModal" hidden role="dialog" aria-modal="true" aria-labelledby="letterTitle">
  <div class="letter-backdrop" data-close-letter></div>

  <!--
    No `role="document"` on the box: inside a dialog it switches the screen
    reader into browse mode for the whole panel, and the reader then has to
    switch back to links mode to follow one. The dialog owns its contents.
  -->
  <div class="letter-box">
    <div class="letter-head">
      <span id="letterTitle">contact</span>
      <button type="button" class="letter-x" data-close-letter aria-label="Close">✕</button>
    </div>

    <div class="letter-body">
      <ul class="letter-channels">
        {
          CHANNELS.map((channel) => (
            <li>
              <a
                class="letter-channel"
                href={channel.href}
                rel={channel.href.startsWith('http') ? 'noopener' : undefined}
              >
                <span class="letter-channel-name">{channel.name}</span>
                <span class="letter-channel-value">{channel.value}</span>
                <span class="letter-channel-desc">{channel.desc}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
