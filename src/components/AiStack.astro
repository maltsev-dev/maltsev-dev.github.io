---
// ASCII architecture of an AI automation system.
//
// The drawing is plain text lines so column alignment is exact and nothing
// depends on font metrics beyond monospace. The figure is 119 columns wide
// and every box edge, arrow and junction lands on a fixed column.
//
// LINES is a list of rows, and a row is a list of segments. A row that holds
// several stages (06 / 07 / 08) or a stage plus the vertical line running past
// it is split into several segments, and so is every row whose stage sits away
// from column 0: the spaces in front of a box are their own z: null segment, so
// a zone spans exactly its box and neither the highlight nor the measured hit
// area bleeds back to the left edge. Three more rules keep the drawing intact:
//   - a segment with z: null is a connector, so hovering a stage lights its
//     block only and never the paths around it;
//   - it renders in --font-art, not --font-mono, because the Google Fonts
//     subsets of JetBrains Mono have no box-drawing glyphs and a mixed advance
//     width shears the whole drawing apart;
//   - the glyphs live in <code>, which a global `code, pre, kbd` reset points
//     at the UI font, so os.css re-asserts --font-art on `.stack-art code`.
//
// Every vertical run is continuous: a branch that passes a box on its way down
// the drawing carries its `│` through the rows that box occupies, and an arrow
// sits immediately above the box it points at.
//
// The glyphs stay non-interactive. A box drawn in text cannot be a button, so
// RECTS measures each stage back out of LINES and the real <button>s are laid
// over the drawing on top — that keeps the ASCII look and gives keyboard users
// something focusable with an accessible name.
//
// ZONES below is only what the drawing needs: a label, the one-line readout and
// the chips. Everything the modal says about a stage lives in src/data/stages.ts
// and is merged in here, so prose edits never disturb the figure.
import { STAGE_COPY } from '../data/stages';

const DRAWING_ZONES = [
  {
    id: 'backend',
    name: '01 · BACKEND FOUNDATION',
    desc: 'FastAPI, Pydantic, AsyncIO, Pytest. The service skeleton every later stage plugs into.',
    stack: ['FastAPI', 'Pydantic', 'AsyncIO', 'Pytest'],
  },
  {
    id: 'llm',
    name: '02 · LLM API & TOOL CALLING',
    desc: 'Structured outputs and streaming. Every tool call is schema-checked before it is allowed to run.',
    stack: ['Structured Outputs', 'Streaming'],
  },
  {
    id: 'agents',
    name: '03 · AGENT ORCHESTRATION',
    desc: 'LangGraph state machine. Explicit transitions, so a run can be replayed and compared step by step.',
    stack: ['LangGraph', 'State Machine'],
  },
  {
    id: 'api',
    name: '04 · API & BUSINESS INTEGRATIONS',
    desc: 'REST, webhooks, OAuth 2.0, reconciliation. The layer where the agent meets the systems of record.',
    stack: ['REST', 'Webhooks', 'OAuth 2.0', 'Reconciliation'],
  },
  {
    id: 'rag',
    name: '05 · RAG ENGINEERING',
    desc: 'Hybrid search, reciprocal rank fusion, reranking. Retrieval quality before prompt quality.',
    stack: ['Hybrid Search', 'RRF', 'Rerank'],
  },
  {
    id: 'reliability',
    name: '06 · RELIABILITY & RESILIENCE',
    desc: 'Circuit breakers and idempotency keys. An upstream failure degrades the run instead of cascading.',
    stack: ['Circuit Breakers', 'Idempotency'],
  },
  {
    id: 'security',
    name: '07 · SECURITY & AUTHORIZATION',
    desc: 'Deterministic RBAC and a sandboxed tool runtime. Permissions decided in code, never by the model.',
    stack: ['Deterministic RBAC', 'Sandbox'],
  },
  {
    id: 'eval',
    name: '08 · EVALUATION & REGRESSION',
    desc: 'Trajectory tests over golden datasets. Every prompt or model change is measured before it ships.',
    stack: ['Trajectory Tests', 'Golden Datasets'],
  },
  {
    id: 'sql',
    name: '09 · SQL & STATE PERSISTENCE',
    desc: 'Postgres, Redis, checkpointing. Agent state survives a crash, a deploy and a restart.',
    stack: ['Postgres', 'Redis', 'Checkpointing'],
  },
  {
    id: 'obs',
    name: '10 · OBSERVABILITY',
    desc: 'Tracing and OpenTelemetry. Every run is inspectable from first tool call to final answer.',
    stack: ['Tracing', 'OpenTelemetry', 'Alerting'],
  },
];

// Long-form panel copy, merged in. `desc` wins over nothing here: the readout
// under the figure keeps the one-liner, the modal opens with the full lede.
const ZONES = DRAWING_ZONES.map((z) => ({
  ...z,
  ...STAGE_COPY[z.id as keyof typeof STAGE_COPY],
}));

const LINES = [
  [{ z: null, t: '                                   ' }, { z: 'backend', t: '┌───────────────────────────────────────────────┐' }],
  [{ z: null, t: '                                   ' }, { z: 'backend', t: '│            01. Backend Foundation             │' }],
  [{ z: null, t: '                                   ' }, { z: 'backend', t: '│     FastAPI • Pydantic • AsyncIO • Pytest     │' }],
  [{ z: null, t: '                                   ' }, { z: 'backend', t: '└───────────────────────┬───────────────────────┘' }],
  [{ z: null, t: '                                                           │                                                           ' }],
  [{ z: null, t: '                   ┌───────────────────────────────────────┴───────────────────────────────────────┐                   ' }],
  [{ z: null, t: '                   ▼                                                                               ▼                   ' }],
  [{ z: 'llm', t: '┌─────────────────────────────────────┐' }, { z: null, t: '                                         ' }, { z: 'sql', t: '┌─────────────────────────────────────┐' }],
  [{ z: 'llm', t: '│     02. LLM API & Tool Calling      │' }, { z: null, t: '                                         ' }, { z: 'sql', t: '│     09. SQL & State Persistence     │' }],
  [{ z: 'llm', t: '│   Structured Outputs • Streaming    │' }, { z: null, t: '                                         ' }, { z: 'sql', t: '│  Postgres • Redis • Checkpointing   │' }],
  [{ z: 'llm', t: '└──────────────────┬──────────────────┘' }, { z: null, t: '                                         ' }, { z: 'sql', t: '└──────────────────┬──────────────────┘' }],
  [{ z: null, t: '                   │                                                                               │                   ' }],
  [{ z: null, t: '                   ▼                                                                               ▼                   ' }],
  [{ z: 'agents', t: '┌─────────────────────────────────────┐' }, { z: null, t: '                                         ' }, { z: 'rag', t: '┌─────────────────────────────────────┐' }],
  [{ z: 'agents', t: '│       03. Agent Orchestration       │' }, { z: null, t: '                                         ' }, { z: 'rag', t: '│         05. RAG Engineering         │' }],
  [{ z: 'agents', t: '│      LangGraph • State Machine      │' }, { z: null, t: '                                         ' }, { z: 'rag', t: '│    Hybrid Search • RRF • Rerank     │' }],
  [{ z: 'agents', t: '└──────────────────┬──────────────────┘' }, { z: null, t: '                                         ' }, { z: 'rag', t: '└──────────────────┬──────────────────┘' }],
  [{ z: null, t: '                   └───────────────────────────────────────┬───────────────────────────────────────┘                   ' }],
  [{ z: null, t: '                                                           │                                                           ' }],
  [{ z: null, t: '                                                           ▼                                                           ' }],
  [{ z: 'api', t: '┌─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐' }],
  [{ z: 'api', t: '│                                           04. API & Business Integrations                                           │' }],
  [{ z: 'api', t: '│                                    REST • Webhooks • OAuth 2.0 • Reconciliation                                     │' }],
  [{ z: 'api', t: '└──────────────────────────────────────────────────────────┬──────────────────────────────────────────────────────────┘' }],
  [{ z: null, t: '                                                           │                                                           ' }],
  [{ z: null, t: '                   ┌───────────────────────────────────────┼───────────────────────────────────────┐                   ' }],
  [{ z: null, t: '                   ▼                                       ▼                                       ▼                   ' }],
  [{ z: 'reliability', t: '┌─────────────────────────────────────┐' }, { z: null, t: ' ' }, { z: 'security', t: '┌─────────────────────────────────────┐' }, { z: null, t: ' ' }, { z: 'eval', t: '┌─────────────────────────────────────┐' }],
  [{ z: 'reliability', t: '│    06. Reliability & Resilience     │' }, { z: null, t: ' ' }, { z: 'security', t: '│    07. Security & Authorization     │' }, { z: null, t: ' ' }, { z: 'eval', t: '│     08. Evaluation & Regression     │' }],
  [{ z: 'reliability', t: '│   Circuit Breakers • Idempotency    │' }, { z: null, t: ' ' }, { z: 'security', t: '│    Deterministic RBAC • Sandbox     │' }, { z: null, t: ' ' }, { z: 'eval', t: '│ Trajectory Tests • Golden Datasets  │' }],
  [{ z: 'reliability', t: '└──────────────────┬──────────────────┘' }, { z: null, t: ' ' }, { z: 'security', t: '└──────────────────┬──────────────────┘' }, { z: null, t: ' ' }, { z: 'eval', t: '└──────────────────┬──────────────────┘' }],
  [{ z: null, t: '                   └───────────────────────────────────────┼───────────────────────────────────────┘                   ' }],
  [{ z: null, t: '                                                           │                                                           ' }],
  [{ z: null, t: '                                                           ▼                                                           ' }],
  [{ z: null, t: '                      ' }, { z: 'obs', t: '┌─────────────────────────────────────────────────────────────────────────┐' }],
  [{ z: null, t: '                      ' }, { z: 'obs', t: '│                            10. Observability                            │' }],
  [{ z: null, t: '                      ' }, { z: 'obs', t: '│                     Tracing • OpenTelemetry • Alert                     │' }],
  [{ z: null, t: '                      ' }, { z: 'obs', t: '└─────────────────────────────────────────────────────────────────────────┘' }],
];

// Measure each stage back out of the drawing: which rows it spans and which
// columns it covers. Derived rather than hand-written, so moving a box in
// LINES moves its hit area with it instead of silently detaching.
const RECTS = {};
LINES.forEach((segs, row) => {
  let col = 0;
  segs.forEach((s) => {
    if (s.z) {
      const r = RECTS[s.z];
      if (r) {
        r.r1 = row;
        r.c0 = Math.min(r.c0, col);
        r.c1 = Math.max(r.c1, col + s.t.length - 1);
      } else {
        RECTS[s.z] = { r0: row, r1: row, c0: col, c1: col + s.t.length - 1 };
      }
    }
    col += s.t.length;
  });
});
---

<div class="stack" data-stack>
  <div class="stack-head">
    <span class="stack-dot"></span>
    <span class="stack-title">architecture</span>
    <span class="stack-meta" data-stack-meta>click a stage</span>
  </div>

  <div class="stack-view">
    {/* The drawing itself is hidden from assistive tech — it is 119 columns of
        box-drawing characters, which reads as noise. The buttons below carry
        the same information properly. They live inside the <pre> so they are
        positioned in the same scrolling content box as the glyphs they cover,
        and so they travel with the art when a narrow screen scrolls it. */}
    <pre class="stack-art"><code aria-hidden="true">{
      LINES.map((segs, row) =>
        segs.map((s, i) => {
          const last = i === segs.length - 1;
          const text = s.t + (last ? '\n' : '');
          return s.z ? (
            <span class="stack-zone" data-zone={s.z} data-row={row}>{text}</span>
          ) : (
            <span class="stack-line" data-row={row}>{text}</span>
          );
        })
      )
    }</code>{
      ZONES.map((z) => {
        const r = RECTS[z.id];
        return (
          <button
            type="button"
            class="stack-hit-box"
            style={`--c0:${r.c0}; --r0:${r.r0}; --w:${r.c1 - r.c0 + 1}; --h:${r.r1 - r.r0 + 1}`}
            data-open-stage={z.id}
            data-zone={z.id}
            aria-label={`${z.name.replace(/ · /, ' ')}. ${z.desc}`}
          />
        );
      })
    }</pre>
  </div>

  <div class="stack-read" id="stackRead" aria-live="polite">
    <p class="stack-read-idle">Hover a stage, click it for detail.</p>
    {
      ZONES.map((z) => (
        <p class="stack-read-item" data-read={z.id} hidden>
          <strong>{z.name}</strong>
          <span>{z.desc}</span>
        </p>
      ))
    }
  </div>

  <span class="stack-scan" aria-hidden="true"></span>
</div>

{/* One dialog for all ten stages. Every panel is rendered up front and the
    script shows the right one, so the copy lives next to the drawing instead
    of being duplicated in JavaScript. Same shape as LetterModal: backdrop,
    focus trap, Escape, focus returned to the trigger. */}
<div class="stage-modal" id="stageModal" hidden role="dialog" aria-modal="true">
  <div class="stage-modal-backdrop" data-close-stage></div>
  <div class="stage-modal-box" role="document">
    {
      ZONES.map((z) => (
        <section class="stage-modal-panel" data-stage-panel={z.id} hidden aria-labelledby={`stage-title-${z.id}`}>
          <div class="stage-modal-head">
            <span id={`stage-title-${z.id}`}>{z.name}</span>
            <button type="button" class="stage-modal-x" data-close-stage aria-label={`Close ${z.name}`}>✕</button>
          </div>
          <div class="stage-modal-body">
            <p class="stage-modal-lede">{z.lede}</p>
            {/* The stage drawn on its own. It is a diagram, not decoration:
                it is the same shape the block has inside the big figure, so a
                reader who wants the detail still recognises the geometry. */}
            <pre class="stage-modal-art" aria-hidden="true"><code>{z.art}</code></pre>
            <ul class="stage-modal-stack">
              {z.stack.map((s) => <li>{s}</li>)}
            </ul>
            <div class="stage-modal-cols">
              <section class="stage-modal-sec">
                <h3 class="stage-modal-h">Key aspects</h3>
                <ul class="stage-modal-list">
                  {z.key.map(([label, text]) => (
                    <li>
                      <b>{label}.</b>{' '}
                      {text.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}
                    </li>
                  ))}
                </ul>
              </section>
              <section class="stage-modal-sec">
                <h3 class="stage-modal-h">Pro tips and best practices</h3>
                <ul class="stage-modal-list">
                  {z.tips.map(([label, text]) => (
                    <li>
                      <b>{label}.</b>{' '}
                      {text.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}
                    </li>
                  ))}
                </ul>
              </section>
              <section class="stage-modal-sec">
                <h3 class="stage-modal-h">Pitfalls</h3>
                <ol class="stage-modal-list stage-modal-num">
                  {z.pitfalls.map(([label, text]) => (
                    <li>
                      <b>{label}.</b>{' '}
                      {text.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}
                    </li>
                  ))}
                </ol>
              </section>
              <section class="stage-modal-sec">
                <h3 class="stage-modal-h">Production checklist</h3>
                <ul class="stage-modal-list stage-modal-check">
                  {z.check.map((text) => (
                    <li>
                      {text.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          </div>
        </section>
      ))
    }
  </div>
</div>
