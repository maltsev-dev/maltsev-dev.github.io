---
const year = new Date().getFullYear();

/*
  One bar, everywhere.

  The footer used to have two forms: a four-column panel with a directory, a
  call to action and a "Built with" line, and a compact one for the projects
  page. The panel version was three times the height of the content it sat
  under — on a long article it pushed the writing down the page — and the
  call to action repeated a button already on the page, in a place the reader
  reaches only after they have finished reading.

  What is left is the line that says who the site belongs to, the one sentence
  that says what the work is, and the four ways out of the site. One line,
  one bar, on every page.
*/

const ELSEWHERE = [
  { href: 'mailto:mr.a.maltsev@gmail.com', label: 'email', external: false },
  { href: 'https://github.com/maltsev-dev', label: 'github', external: true },
  { href: 'https://www.linkedin.com/in/a-maltsev', label: 'linkedin', external: true },
  { href: '/rss.xml', label: 'rss', external: false },
];
---

<!--
  The end of the page. Until this was connected, every route ended in blank
  space: no way on from a finished article, and no <footer> landmark for a
  screen reader to jump to.
-->
<footer class="site-footer">
  <div class="wrap footer-bar">
    <span class="footer-copy">© {year} Anatolii Maltsev</span>

    <!--
      The one sentence the site makes about itself. It is a line of type, not
      a headline: the claim belongs in the hero, and the footer only has to
      repeat it for a reader who scrolled the whole way down.
    -->
    <p class="footer-line">
      Agentic systems that carry real work, built to be measured.
    </p>

    <nav class="footer-links" aria-label="Elsewhere">
      {
        ELSEWHERE.map((s, i) => (
          <>
            {i > 0 && <span class="footer-sep" aria-hidden="true">│</span>}
            <a href={s.href} rel={s.external ? 'noopener' : undefined} target={s.external ? '_blank' : undefined}>
              {s.label}
            </a>
          </>
        ))
      }
    </nav>
  </div>
</footer>
