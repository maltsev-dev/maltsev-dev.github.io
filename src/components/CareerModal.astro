---
/**
 * The career dialog. One dialog serves every stop in the log.
 *
 * The listing on /experience/ carries the record of a stop — when it ran, how
 * long, the role, what it was about, the company, the form of the
 * engagement. The dialog carries the rest: the paragraph that says what the
 * step was, the points, the stacks. Nothing of the record is repeated here.
 *
 * All the panels are rendered up front and the script shows the requested
 * one, so the copy lives in the markup instead of being duplicated in
 * JavaScript. Same shape as the project panels: backdrop, focus trap,
 * Escape, and the focus returned to the stop that opened it.
 */
import { type Stop } from '../data/stops';

interface Props {
  stops: Stop[];
}

const { stops } = Astro.props;
---

<!--
  aria-labelledby points at the first stop's title and is repointed by os.js
  whenever another stop opens: every stop shares this one dialog, so only the
  one on screen can give it a name.
-->
<div
  class="panel-modal"
  id="expModal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby={`exp-title-${stops[0]?.hash ?? ''}`}
>
  <div class="panel-modal-backdrop" data-close-exp></div>

  <!--
    `role="document"` switched the screen reader into browse mode for the
    whole panel, which took the keyboard away from the reader inside the
    dialog. A named group says the same thing without that: os.js repoints
    the label at the stop that is on screen.
  -->
  <div class="panel-modal-box" role="group" aria-labelledby={`exp-title-${stops[0]?.hash ?? ''}`}>
    {
      stops.map((s) => (
        <section
          class="panel-modal-panel"
          data-exp-panel={s.hash}
          hidden
          aria-labelledby={`exp-title-${s.hash}`}
        >
          <div class="panel-modal-head">
            <span class="panel-modal-path" aria-hidden="true">~/career</span>
            <button
              type="button"
              class="panel-modal-x"
              data-close-exp
              aria-label={`Close ${s.role} at ${s.company}`}
            >
              ✕
            </button>
          </div>

          <div class="panel-modal-body">
            <h2 class="panel-modal-title" id={`exp-title-${s.hash}`}>
              {s.role}
            </h2>

            {s.body && <p class="panel-modal-lede">{s.body}</p>}

            <ul class="panel-modal-points">
              {s.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>

            <p class="panel-modal-tags">
              {s.skills.map((skill) => (
                <span class="panel-modal-tag">{skill}</span>
              ))}
              {s.more && <span class="panel-modal-tag panel-modal-tag--more">+{s.more} more</span>}
            </p>
          </div>
        </section>
      ))
    }
  </div>
</div>
