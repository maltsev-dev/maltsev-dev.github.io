---
/*
  The top strip: the status line of the machine.

  A terminal status line is a row of fields, each field a name and a value.
  What is left is the one field that says where you are — `host` — with the
  clock and the availability lamp at the right end, because that is the one
  thing on the strip that means an action is available.
*/
---

<div class="status-bar">
  <div class="wrap">
    <div class="status-left">
      <span class="status-item">
        <span class="k" aria-hidden="true">host</span>
        <span class="v">maltsev-01</span>
      </span>
    </div>

    <div class="status-right">
      <!--
        No `datetime` in the markup: an empty value is not a valid date/time
        string, and the one the script writes has to be the visitor's local
        time, which is only known in the browser.
      -->
      <span class="status-item clock">
        <span class="k" aria-hidden="true">time</span>
        <time id="clock">—</time>
      </span>

      <span class="status-sep" aria-hidden="true">│</span>

      <!--
        The one contact entry point on the page, so it has to say what it does
        and be big enough to hit. The visible word is kept inside the
        accessible name, which is what Label in Name asks for.
      -->
      <button
        class="status-item status-cta"
        type="button"
        data-open-letter
        aria-label="available, open the contact options"
        title="Available, open the contact options"
      >
        <span class="led led-blink" aria-hidden="true"></span>
        <span>available</span>
      </button>
    </div>
  </div>
</div>

<style>
  /* The strip is one line tall. The button keeps the 24px floor WCAG 2.2 asks
     for; a finger gets the 44px it needs from the overlay in os.css, which
     grows the hit area without growing the layout. */
  .status-bar .status-cta {
    min-height: 24px;
    padding-block: 0;
  }
</style>
