<!--
  Rendered on every page but inert until opened, so Ctrl+K works from anywhere
  without a framework.

  The list is empty in the markup on purpose: the index of every post and
  project used to be built into all 79 pages, and it was the fifth of a post
  page's bytes for a list nobody had asked for. It is fetched from
  /palette-index.json the first time the palette opens.
-->
<div class="palette" id="palette" hidden role="dialog" aria-modal="true" aria-label="Command palette">
  <div class="palette-box">
    <label class="sr-only" for="paletteInput">Search</label>
    <input
      class="palette-input"
      id="paletteInput"
      type="search"
      placeholder="Jump to…"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="paletteList"
      aria-autocomplete="list"
      aria-haspopup="listbox"
    />

    <ul class="palette-list" id="paletteList" role="listbox" aria-label="Results"></ul>

    <p class="palette-empty" id="paletteEmpty" hidden>No match.</p>
  </div>
</div>
