---
import Minimal from '../layouts/Minimal.astro';
---

<!--
  The error page carries no site chrome, so it uses the chrome-free layout.
  It also drops the reveal animation: the reveal is un-hidden by the site's
  script, and this page ships no script — so the text would stay at opacity
  zero.
-->
<Minimal
  title="Not found"
  description="That page isn't here. The link may be old, or the page may have moved."
>
  <section class="hero">
    <span class="eyebrow">Error 404</span>
    <h1>That page isn't here</h1>
    <p class="lede">
      The link may be old, or the page may have moved.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="btn" href="/blog/">Browse writing</a>
    </div>
  </section>
</Minimal>

<style>
  /* The one page a reader lands on by accident has nothing to line up with:
     it is a signpost, not a document. So it stands in the middle of the
     screen — centred, with the two ways out under the line that says what
     happened — instead of hanging in the top-left corner of an empty page. */
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    padding-block: 2rem;
  }

  .hero h1 {
    margin-bottom: 0.3em;
  }

  .hero .lede {
    margin-bottom: 1.8rem;
  }

  .hero .btn-row {
    justify-content: center;
  }
</style>
