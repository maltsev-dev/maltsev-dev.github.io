---
import Minimal from '../layouts/Minimal.astro';
---

<!--
  The error page carries no site chrome, so it uses the chrome-free layout.
  It also drops the reveal animation: the reveal is un-hidden by the site's
  script, and this page ships no script — so the text would stay at opacity
  zero.
-->
<Minimal
  title="Not found"
  description="That page isn't here. The link may be old, or the page may have moved."
>
  <section class="hero">
    <span class="eyebrow">Error 404</span>
    <h1>That page isn't here</h1>
    <p class="lede">
      The link may be old, or the page may have moved.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="btn" href="/blog/">Browse writing</a>
    </div>
  </section>
</Minimal>
