---
import '../../styles/track.css';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MILESTONES, type Milestone } from '../../data/milestones';

const cases = await getCollection('projects');

interface Panel extends Milestone {
  linked: boolean;
}

/**
 * The short name of a panel.
 *
 * The full titles are sentences — "AI Social Media Agent: 7-Platform
 * Publishing with Human-in-the-Loop" — and they belong on the cards, where
 * there is room for a sentence. The index under the track names twelve
 * things in two rows, so it needs a name that fits: the milestone's own
 * short field, or, for a case study, its title with the "AI " taken off.
 */
const shortName = (panel: Panel): string =>
  panel.short ?? panel.title.replace(/^AI\s+/, '');

// One track, two sources: the deep-dive cases (each with a page of its own) and
// the milestone history.
//
// Calendar order, newest first. What is being built now leads — `period:
// 'Current'` is the top of the list — and the case studies follow it, since
// their source entries carry no dates to interleave with the history. The rest
// is the milestone list, already newest first.
//
// A panel is an <a> only when it has somewhere to go. A milestone without an
// href renders as an <article>, so the track never shows a link that leads
// nowhere.
const panels: Panel[] = [
  ...MILESTONES.filter((m) => m.period === 'Current').map((m) => ({ ...m, linked: !!m.href })),
  ...cases.map((p) => ({
    linked: true,
    slug: p.data.slug,
    title: p.data.title,
    period: 'Case study',
    summary: p.data.description ?? '',
    tags: p.data.tags,
    href: `/projects/${p.data.slug}/`,
  })),
  ...MILESTONES.filter((m) => m.period !== 'Current').map((m) => ({ ...m, linked: !!m.href })),
];

// The chips under the subtitle are the skills that recur: counted across every
// panel, so a stack that shows up twice is a thread worth naming, while a
// one-off detail stays on the card where it belongs. Sorted alphabetically —
// the reader is scanning for a name, not learning an order.
const counts = new Map<string, number>();
for (const p of panels) {
  for (const t of p.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const RECURRING = [...counts.entries()]
  .filter(([, n]) => n > 1)
  .map(([t]) => t)
  .sort((a, b) => a.localeCompare(b));

// What a panel's link is, and what it is called.
//
// A panel is a link that wraps the whole card, so without a name of its own
// the link takes the card as its name: the title, the summary, the skills and
// the arrow at the foot — forty words for a screen reader to walk past, once
// per panel of the row. The heading stays inside the link, so the outline of
// the page is unchanged; the name says what the link is and what it does.
//
// The name and the cue at the foot of the panel come from the same rule, so
// what a reader sees and what a reader hears are the same sentence. The rule
// follows what the link is — a post to read, a case study to view, another
// site to open — and not one hardcoded URL: the old rule switched on the
// string '/blog/', so two links that looked the same were labeled with two
// different verbs.
type LinkKind = 'post' | 'writing' | 'case' | 'external';

const linkKind = (href: string): LinkKind => {
  if (/^https?:\/\//.test(href)) return 'external';
  if (href === '/blog/') return 'writing';
  if (href.startsWith('/blog/')) return 'post';
  return 'case';
};

const LINK: Record<LinkKind, { cue: string; verb: string }> = {
  post: { cue: 'Read →', verb: 'Read the post' },
  writing: { cue: 'Browse →', verb: 'Browse the writing' },
  case: { cue: 'View →', verb: 'View the project' },
  external: { cue: 'Open →', verb: 'Open the project' },
};
---

<Base title="Projects" description="Case studies in agentic AI and automation.">
  <!-- One viewport, no vertical scroll: the wheel drives the row sideways, the
       same as /experience/ but through this page's own wrapper. -->
  <div class="prj-page">
  <section class="hero prj-hero">
    <span class="eyebrow" data-reveal>Catalog</span>

    {/*
      The masthead is one row, not one column. Stacked, it left two thirds of
      the band empty: a short title, a line under it, a row of chips under
      that, and nothing at all on the right. Now the copy and the chips share
      the row — the claim on the left, the stacks it was built from on the
      right — and the band has two ends rather than one.

      The line about moving along the row is here for the same reason the
      figure on the front page says how to swipe it: on a desktop this page
      does not scroll down, it scrolls sideways, and a page that swallows the
      wheel without saying so reads as a broken page.
    */}
    <div class="prj-hero-main">
      <div class="prj-hero-lead">
        <h1 data-reveal data-reveal-delay="60">Projects</h1>
        <p class="lede" data-reveal data-reveal-delay="120">
          Production systems, not demos. Each one shipped, measured, and left running.
        </p>
        <p class="prj-hint" data-reveal data-reveal-delay="160" aria-hidden="true">
          Scroll, or use ← →, to move along the row
        </p>
      </div>

      {
        RECURRING.length > 0 && (
          <ul class="recurring prj-chips" data-reveal data-reveal-delay="200">
            {RECURRING.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <div class="track-scroll projects-track" data-track-scroll data-track-mode="wheel">
    <div class="track" data-track>
      <div class="track-row" data-track-row>
        {
          panels.map((m) => {
            const kind = m.href ? linkKind(m.href) : null;
            const body = (
              <>
                <p class="track-meta">
                  <span class="track-when">{m.period}</span>
                </p>

                <h2>{m.title}</h2>
                <p class="panel-body">{m.summary}</p>

                <ul class="track-skills">
                  {m.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>

                {kind && (
                  <span class="panel-foot">{LINK[kind].cue}</span>
                )}
              </>
            );
            return m.linked ? (
              <a
                class="track-panel panel-project"
                href={m.href}
                aria-label={kind ? `${m.title} — ${LINK[kind].verb}` : undefined}
              >
                {body}
              </a>
            ) : (
              <article class="track-panel panel-project">{body}</article>
            );
          })
        }
      </div>

      {/*
        The index. The row is a carousel and a carousel hides things: at any
        moment a reader can see two of the twelve panels and no way to know
        what the other ten are. This is the whole catalog in two rows — the
        name of every project, in order, with the one the row is holding
        marked. It fills the band the row leaves under itself and it is the
        only place on the page where all twelve are on screen at once.

        The items are links where the panel has somewhere to go and plain
        text where it does not, exactly as the panels themselves are.
      */}
      <nav class="panel-index" aria-label="All projects">
        {
          panels.map((m, i) => {
            const inner = (
              <>
                <span class="panel-index-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="panel-index-name">{shortName(m)}</span>
                <span class="panel-index-when">{m.period}</span>
              </>
            );
            return m.linked ? (
              <a
                class="panel-index-item"
                href={m.href}
                data-panel-index-item={i}
              >
                {inner}
              </a>
            ) : (
              <span class="panel-index-item" data-panel-index-item={i}>
                {inner}
              </span>
            );
          })
        }
      </nav>

      <div class="panel-hud" aria-hidden="true">
        <span data-hud-current>01</span>
        <span class="panel-hud-bar"><i data-hud-bar /></span>
        <span>{String(panels.length).padStart(2, '0')}</span>
      </div>
    </div>
  </div>
  </div>

  <script>
    import '../../scripts/track.js';
  </script>
</Base>

<style>
  /* The masthead: the claim on the left, the stacks on the right. Below the
     breakpoint the two stack, and the chips keep their own margin so they do
     not sit against the line above them. */
  .prj-hero-main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.7rem 2.5rem;
  }

  .prj-hero-lead {
    max-width: 36rem;
  }

  .prj-hero-lead h1 {
    margin: 0 0 0.35rem;
  }

  .prj-hero-lead .lede {
    margin: 0;
  }

  /* The line that says how the row moves. Decorative: every panel is in the
     index below the row, so nothing here is reachable only by scrolling
     sideways.

     It is shown only when the row actually moves sideways. The condition is
     the one `isHorizontal()` uses in track.js and the one the layout in
     track.css is written against — below that width, or without a fine
     pointer, or under reduced motion, the panels are a column and the line
     would be telling the reader to do something the page does not do. */
  .prj-hint {
    display: none;
    margin: 0.55rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--braise);
  }

  @media (min-width: 52.1rem) and (hover: hover) and (pointer: fine)
    and (prefers-reduced-motion: no-preference) {
    .prj-hint {
      display: block;
    }
  }

  /* Named through the wrapper so the rule outranks the one in track.css,
     which gives the chips a margin of their own inside the wheel-mode
     layout. */
  .prj-hero-main .prj-chips {
    margin-top: 0;
  }

  @media (max-width: 52rem) {
    .prj-hero-main .prj-chips {
      margin-top: 0.7rem;
    }
  }
</style>