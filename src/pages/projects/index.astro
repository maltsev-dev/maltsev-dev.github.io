---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MILESTONES, type Milestone } from '../../data/milestones';

const cases = await getCollection('projects');

interface Panel extends Milestone {
  linked: boolean;
}

/**
 * One catalog, two sources: the deep-dive cases (each with a page of its own)
 * and the milestone history.
 *
 * Calendar order, newest first. What is being built now leads — `period:
 * 'Current'` is the top of the list — and the case studies follow it, since
 * their source entries carry no dates to interleave with the history. The rest
 * is the milestone list, already newest first.
 *
 * A panel is an <a> only when it has somewhere to go. A milestone without an
 * href renders as an <article>, so the listing never shows a link that leads
 * nowhere.
 */
const panels: Panel[] = [
  ...MILESTONES.filter((m) => m.period === 'Current').map((m) => ({ ...m, linked: !!m.href })),
  ...cases.map((p) => ({
    linked: true,
    slug: p.data.slug,
    title: p.data.title,
    period: 'Case study',
    summary: p.data.description ?? '',
    tags: p.data.tags,
    href: `/projects/${p.data.slug}/`,
  })),
  ...MILESTONES.filter((m) => m.period !== 'Current').map((m) => ({ ...m, linked: !!m.href })),
];

// The chips under the subtitle are the skills that recur: counted across every
// panel, so a stack that shows up twice is a thread worth naming, while a
// one-off detail stays on the card where it belongs. Sorted alphabetically —
// the reader is scanning for a name, not learning an order.
const counts = new Map<string, number>();
for (const p of panels) {
  for (const t of p.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const RECURRING = [...counts.entries()]
  .filter(([, n]) => n > 1)
  .map(([t]) => t)
  .sort((a, b) => a.localeCompare(b));

/**
 * The mode of an entry.
 *
 * A case study has a directory of its own — a page you descend into — so it
 * is listed as a directory. A milestone is a file: shipped work, recorded,
 * with nothing behind it but a summary. The listing says which is which
 * before you read a word of it.
 */
const mode = (p: Panel): string =>
  p.href?.startsWith('/projects/') ? 'drwxr-xr-x' : '-rw-r--r--';

/**
 * The when column.
 *
 * The source periods are written for a reader — "Jul 2025 — Nov 2025" — and
 * they are longer than a listing column can be without pushing the name out
 * of the way. In a listing a date is a date: `2025-07 → 2025-11`. The long
 * form is still in the data, and it is still what the reader gets on the
 * case page.
 */
const MONTHS: Record<string, string> = {
  jan: '01', feb: '02', mar: '03', apr: '04', may: '05', jun: '06',
  jul: '07', aug: '08', sep: '09', oct: '10', nov: '11', dec: '12',
};

const when = (period: string): string => {
  if (period === 'Current') return 'current';
  if (period === 'Case study') return 'case';

  return period
    .split('—')
    .map((part) => {
      const m = /^([A-Za-z]{3})\s+(\d{4})$/.exec(part.trim());
      const month = m ? MONTHS[m[1].toLowerCase()] : undefined;
      return m && month ? `${m[2]}-${month}` : part.trim();
    })
    .join(' → ');
};

// What a panel's link is, and what it is called.
//
// A panel is a link that wraps the whole card, so without a name of its own
// the link takes the card as its name: the title, the summary, the skills and
// the arrow at the foot — forty words for a screen reader to walk past, once
// per panel of the row. The heading stays inside the link, so the outline of
// the page is unchanged; the name says what the link is and what it does.
//
// The name and the cue at the foot of the panel come from the same rule, so
// what a reader sees and what a reader hears are the same sentence. The rule
// follows what the link is — a post to read, a case study to view, another
// site to open — and not one hardcoded URL: the old rule switched on the
// string '/blog/', so two links that looked the same were labeled with two
// different verbs.
type LinkKind = 'post' | 'writing' | 'case' | 'external';

const linkKind = (href: string): LinkKind => {
  if (/^https?:\/\//.test(href)) return 'external';
  if (href === '/blog/') return 'writing';
  if (href.startsWith('/blog/')) return 'post';
  return 'case';
};

const LINK: Record<LinkKind, { cue: string; verb: string }> = {
  post: { cue: 'Read →', verb: 'Read the post' },
  writing: { cue: 'Browse →', verb: 'Browse the writing' },
  case: { cue: 'View →', verb: 'View the project' },
  external: { cue: 'Open →', verb: 'Open the project' },
};
---

<Base title="Projects" description="Case studies in agentic AI and automation.">
  <!--
    The catalog, as a directory listing.

    It used to be a carousel: twelve panels in a row, the wheel driving it
    sideways, with an index underneath to say what was off-screen. Two things
    were wrong with that. The row hid ten of the twelve, so the index had to
    exist to compensate — and the index was the only place on the page where
    all of them were visible at once, which made it the real catalog and the
    row the decoration. And a page that swallows the wheel without scrolling
    down reads as a broken page.

    A listing puts all twelve on the page, in order, with the same
    information each of them had. The wheel goes back to scrolling.
  -->
  <div class="prj-page">
    <section class="hero">
      <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Catalog</span>
      <h1 data-reveal data-reveal-delay="60" data-anim="type">Projects</h1>

      <p class="tty-prompt" data-reveal data-reveal-delay="100">
        <span class="who">root</span><span class="sep">@</span><span
          >amaltsev</span>
        ><span class="sep">:</span><span class="path">~/projects</span><span class="sep"
          >$</span
        >
        <span class="tty-cmd">ls -la</span>
      </p>

      <p class="lede" data-reveal data-reveal-delay="120">
        Production systems, not demos. Each one shipped, measured, and left
        running.
      </p>

      {
        RECURRING.length > 0 && (
          <ul class="recurring prj-chips" data-reveal data-reveal-delay="160">
            {RECURRING.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="section">
      <div class="tty tty-fit tty-prj" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-on"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/projects</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span>
            ><span class="sep">:</span><span class="path">~/projects</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">ls -la</span>
          </p>

          <div class="ls ls-head ls-prj">
            <div class="ls-row ls-row--cat">
              <span class="ls-mode">mode</span>
              <span class="ls-when">when</span>
              <span class="ls-name">name</span>
              <span class="ls-cue"></span>
            </div>
          </div>

          <div class="ls ls-prj">
            {
              panels.map((m, i) => {
                const kind = m.href ? linkKind(m.href) : null;
                const name = (
                  <span class="ls-row ls-row--cat">
                    <span class="ls-mode">{mode(m)}</span>
                    <span class="ls-when">{when(m.period)}</span>
                    <span class="ls-name">
                      {m.linked && m.href ? (
                        <a
                          href={m.href}
                          aria-label={kind ? `${m.title} — ${LINK[kind].verb}` : undefined}
                        >
                          {m.title}
                        </a>
                      ) : (
                        m.title
                      )}
                    </span>
                    <span class="ls-cue">{kind ? LINK[kind].cue : ''}</span>
                  </span>
                );

                return (
                  <article class="prj-row" data-reveal data-reveal-delay={Math.min(i, 5) * 40}>
                    <h3 class="prj-title">{name}</h3>
                    <p class="prj-sum">{m.summary}</p>
                    <ul class="prj-tags">
                      {m.tags.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  </article>
                );
              })
            }
          </div>

          <p class="prj-close">
            The long form is on the pages it links to; the summary is the whole
            of it here.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ----- The column --------------------------------------------------------
     One column for the whole page.

     The page sets `--w` once, here, and every window on it takes its width
     from that, so the head of the page and the window under it start at the
     same x and end at the same x.
     ---------------------------------------------------------------------- */
  .prj-page {
    --w: 100%;
  }

  /* ----- The listing -------------------------------------------------------
     One terminal window holding the whole catalog. The header row says what
     the columns are; each entry is a block, because the summary and the
     stacks hang under the name rather than beside it.
     ---------------------------------------------------------------------- */
  .tty-prj .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  /* The header row sits on its own, above the entries, with a rule under it. */
  .ls-head {
    margin-bottom: 0.15rem;
  }

  .ls-head .ls-row {
    padding-bottom: 0.25rem;
    border-bottom: var(--filet) solid var(--grid);
  }

  /* The columns of an entry come from the shared catalogue row in tty.css:
     mode, when, name, cue. */
  .ls-row--cat .ls-name {
    font-size: 0.95rem;
  }

  .ls-row--cat .ls-name a {
    color: var(--encre);
    text-decoration: none;
  }

  .ls-row--cat .ls-name a:hover {
    color: var(--braise);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* One entry. The name is on the first line and the summary and the stacks
     hang under it, the way a long listing puts the description of a file
     under its name. */
  .prj-row {
    padding-block: 0.6rem;
    border-bottom: var(--filet) solid color-mix(in srgb, var(--grid) 55%, transparent);
  }

  .prj-row:last-of-type {
    border-bottom: 0;
  }

  .prj-title {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .prj-sum {
    margin: 0.25rem 0 0 2ch;
    max-width: var(--measure-prose);
    font-family: var(--font-body);
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--fort);
  }

  .prj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.4rem 0 0 2ch;
    padding: 0;
    list-style: none;
  }

  .prj-tags li {
    padding: 0.05rem 0.4rem;
    border: var(--filet) solid var(--grid);
    background: var(--papier);
    color: var(--fort);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }

  /* The line that closes the catalog. */
  .prj-close {
    margin: 1.4rem 0 0;
    padding-top: 1rem;
    border-top: var(--filet) solid var(--grid);
    max-width: var(--measure-prose);
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.88rem;
  }

  /* ----- The stacks --------------------------------------------------------
     The skills that recur across the catalog, named under the headline. They
     are links to the writing about them, so they are drawn like links.
     ---------------------------------------------------------------------- */
  .prj-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .prj-chips li {
    padding: 0.1rem 0.45rem;
    border: var(--filet) solid var(--grid);
    background: var(--papier);
    color: var(--fort);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  /* ----- Narrower screens --------------------------------------------------
     Four columns do not fit on a phone. The mode is the first thing to go —
     it is the least informative — and the rest stack: when, name, cue.
     ---------------------------------------------------------------------- */
  @media (max-width: 52rem) {
    .prj-sum,
    .prj-tags {
      margin-left: 0;
    }
  }
</style>
