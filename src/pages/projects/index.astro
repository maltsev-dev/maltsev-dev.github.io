---
/**
 * The catalog.
 *
 * A listing of what shipped. It used to be a carousel: twelve panels in a
 * row, the wheel driving it sideways, with an index underneath to say what
 * was off-screen. Two things were wrong with that. The row hid ten of the
 * twelve, so the index had to exist to compensate — and the index was the
 * only place on the page where all of them were visible at once, which made
 * it the real catalog and the row the decoration. And a page that swallows
 * the wheel without scrolling down reads as a broken page.
 *
 * A listing puts all twelve on the page, in order. Each panel carries a name
 * and one line, and the paragraph that says what the project was opens in a
 * dialog — a hundred words instead of a page.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectModal from '../../components/ProjectModal.astro';
import { buildPanels } from '../../data/panels';

const cases = await getCollection('projects');
const panels = buildPanels(cases);

// The chips under the subtitle are the skills that recur: counted across every
// panel, so a stack that shows up twice is a thread worth naming, while a
// one-off detail stays on the panel where it belongs. Sorted alphabetically —
// the reader is scanning for a name, not learning an order.
const counts = new Map<string, number>();
for (const p of panels) {
  for (const t of p.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const RECURRING = [...counts.entries()]
  .filter(([, n]) => n > 1)
  .map(([t]) => t)
  .sort((a, b) => a.localeCompare(b));
---

<Base title="Projects" description="Case studies in agentic AI and automation.">
  <div class="prj-page">
    <section class="hero">
      <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Catalog</span>
      <h1 data-reveal data-reveal-delay="60" data-anim="type">Projects</h1>

      <p class="tty-prompt" data-reveal data-reveal-delay="100">
        <span class="who">root</span><span class="sep">@</span><span
          >amaltsev</span
        ><span class="sep">:</span><span class="path">~/projects</span><span class="sep"
          >$</span
        >
        <span class="tty-cmd">ls -la</span>
      </p>

      <p class="lede" data-reveal data-reveal-delay="120">
        Production systems, not demos. Each one shipped, measured, and left
        running.
      </p>

      {
        RECURRING.length > 0 && (
          <ul class="recurring prj-chips" data-reveal data-reveal-delay="160">
            {RECURRING.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="section">
      <div class="tty tty-fit tty-prj" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-on"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/projects</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span
            ><span class="sep">:</span><span class="path">~/projects</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">ls -la</span>
          </p>

          <!--
            The header row says what the columns are. There are two of them:
            when the work was, and what it was called. The mode is gone — a
            column of permissions that says the same thing on every row says
            nothing — and so is the cue, because every panel opens the same
            dialog now.
          -->
          <div class="ls ls-head ls-prj">
            <div class="ls-row ls-row--cat">
              <span class="ls-when">when</span>
              <span class="ls-name">name</span>
            </div>
          </div>

          <div class="ls ls-prj">
            {
              panels.map((p, i) => (
                <article
                  class="ls-row ls-row--cat prj-row"
                  data-prj-row
                  data-reveal
                  data-reveal-delay={Math.min(i, 5) * 40}
                >
                  <span class="ls-when">{p.when}</span>

                  <div class="prj-main">
                    <h3 class="prj-title">
                      <button
                        type="button"
                        class="prj-open"
                        data-prj-open={p.slug}
                        aria-haspopup="dialog"
                      >
                        {p.title}
                      </button>
                    </h3>

                    <p class="prj-sum">{p.line}</p>

                    <ul class="prj-tags">
                      {p.tags.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>

  <ProjectModal panels={panels} />
</Base>

<style>
  /* ----- The column --------------------------------------------------------
     One column for the whole page.

     The page sets `--w` once, here, and every window on it takes its width
     from that, so the head of the page and the window under it start at the
     same x and end at the same x.
     ---------------------------------------------------------------------- */
  .prj-page {
    --w: 100%;
  }

  /* ----- The listing -------------------------------------------------------
     One terminal window holding the whole catalog. The header row says what
     the columns are; each entry is a block, because the summary and the
     stacks hang under the name rather than beside it.
     ---------------------------------------------------------------------- */
  .tty-prj .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  /* The header row sits on its own, above the entries, with a rule under it. */
  .ls-head {
    margin-bottom: 0.15rem;
  }

  .ls-head .ls-row {
    padding-bottom: 0.25rem;
    border-bottom: var(--filet) solid var(--grid);
  }

  /* Two columns: when, and the name. The mode column is gone and so is the
     cue — twelve panels that all open the same dialog do not need a column
     that says so twelve times. */
  .ls-prj .ls-row--cat {
    grid-template-columns: 18ch minmax(0, 1fr);
  }

  /* One entry. The name is on the first line and the summary and the stacks
     hang under it, the way a long listing puts the description of a file
     under its name. The whole block opens the dialog, so it says so with a
     pointer. */
  .prj-row {
    padding-block: 0.6rem;
    border-bottom: var(--filet) solid color-mix(in srgb, var(--grid) 55%, transparent);
    cursor: pointer;
  }

  .prj-row:last-of-type {
    border-bottom: 0;
  }

  /* The name column: the name, the line under it, the stacks. */
  .prj-main {
    min-width: 0;
  }

  .prj-title {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  /* The name is a button, because the block it opens is a dialog and a
     dialog has to be reachable from the keyboard. It is drawn like the links
     the listing had before it: the ink of the name, and the accent on
     hover. */
  .prj-open {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--encre);
    text-align: left;
    cursor: pointer;
  }

  .prj-open:hover,
  .prj-open:focus-visible {
    color: var(--braise);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* The one line. It is a line: the column is wide enough to hold it, so it
     is not wrapped to a measure and broken in two. */
  .prj-sum {
    margin: 0.25rem 0 0;
    font-family: var(--font-body);
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--fort);
  }

  .prj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .prj-tags li {
    padding: 0.05rem 0.4rem;
    border: var(--filet) solid var(--grid);
    background: var(--papier);
    color: var(--fort);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }

  /* ----- The stacks --------------------------------------------------------
     The skills that recur across the catalog, named under the headline. They
     are links to the writing about them, so they are drawn like links.
     ---------------------------------------------------------------------- */
  .prj-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .prj-chips li {
    padding: 0.1rem 0.45rem;
    border: var(--filet) solid var(--grid);
    background: var(--papier);
    color: var(--fort);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  /* ----- Narrower screens --------------------------------------------------
     Two columns do not fit on a phone. The date goes above the name, the
     way the writing listing folds its row.
     ---------------------------------------------------------------------- */
  @media (max-width: 52rem) {
    .ls-prj .ls-row--cat {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
