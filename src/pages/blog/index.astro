---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TOPICS, topicFor } from '../../data/topics';
import { tagSlug, tagLabel } from '../../lib/tags';
import { describe, isShort, readingTime, MAX_DESCRIPTION } from '../../lib/summarize';
import { formatDateShort } from '../../data/dates';
import { displayTitle } from '../../lib/text';

const posts = (await getCollection('posts')).sort((a, b) =>
  (b.data.date ?? '').localeCompare(a.data.date ?? '')
);

/**
 * The one line under a title.
 *
 * A post that writes its own description gets it; the rest get the first
 * real sentences of their body, cut at a sentence or a clause so the line
 * never ends mid-thought. The short ones — the notes rather than the essays —
 * get a line either way, because a listing row with a title and nothing else
 * does not tell a reader whether the post is worth opening.
 */
const summaryOf = (post: (typeof posts)[number]): string =>
  describe(post.data.title, post.body, post.data.description, MAX_DESCRIPTION);

/**
 * The tags worth a chip.
 *
 * Fifty-three tags carry the corpus, and the two most common of them —
 * `project` on twenty posts and `basic` on eighteen — say nothing that the
 * title does not. The rest are named here, in the order they earn it, so the
 * row of chips is a set of subjects rather than a word cloud.
 */
const NO_CHIP = new Set(['project', 'basic']);
const CHIP_TAGS = [
  'rust',
  'embedded',
  'authorization',
  'security',
  'reliability',
  'architecture',
  'cost',
  'budget',
  'enforcement',
  'audit',
  'compliance',
  'operations',
  'testing',
  'mcp',
  'sp',
  'solana',
  'product',
  'nurse',
  'memory',
  'timers',
  'interrupts',
  'registers',
  'peripherals',
  'mmio',
  'gpio',
  'clock',
  'linker',
  'compilers',
  'tui',
  'actix_web',
  'webassembly',
  'cli',
  'graphics',
  'svg',
  'java',
  'android',
  'cpp',
  'gamedev',
  'spring',
  'rp2040',
  'nrf52833',
  'redis',
  'ai',
  'open_ai',
  'engineering',
];

/** A readable name for the tags whose spelling is an abbreviation. */
const TAG_NAMES: Record<string, string> = {
  sp: 'serial',
  nurse: 'tinyml',
  actix_web: 'actix',
  open_ai: 'openai',
  ai: 'AI',
};

/** The chips that are worth showing: the ones posts actually carry. */
const chips = CHIP_TAGS.filter((tag) =>
  posts.some((post) => post.data.tags.includes(tag))
).filter((tag) => !NO_CHIP.has(tag));

/** How many posts carry each chip, for the counter on the chip. */
const chipCounts = new Map<string, number>();
for (const tag of chips) {
  chipCounts.set(tag, posts.filter((post) => post.data.tags.includes(tag)).length);
}

/**
 * The chips that carry enough posts to be worth a row.
 *
 * Twenty-four tags reach two posts or more. All twenty-four would wrap onto
 * three lines — a wall of small squares that says "there is a lot here"
 * without saying what. Fourteen is the number that still fits in two lines
 * at a desktop width and one at a phone width, so the row is the fourteen
 * most-used subjects, in the order they earn it, and the rest of the
 * taxonomy is still one click away on any individual post.
 */
const CHIP_LIMIT = 14;

const POPULAR = chips
  .filter((tag) => (chipCounts.get(tag) ?? 0) > 1)
  .sort((a, b) => {
    const byCount = (chipCounts.get(b) ?? 0) - (chipCounts.get(a) ?? 0);
    if (byCount !== 0) return byCount;
    // A tie keeps the hand-written order of `CHIP_TAGS`, so the row still
    // reads as a curriculum rather than an alphabetical accident.
    return CHIP_TAGS.indexOf(a) - CHIP_TAGS.indexOf(b);
  })
  .slice(0, CHIP_LIMIT);

const cards = posts.map((post) => {
  const topic = topicFor(post.id);
  const summary = summaryOf(post);
  const tagNames = post.data.tags.map((t) => tagLabel(t));

  return {
    href: `/blog/${post.id}/`,
    title: displayTitle(post.data.title),
    date: formatDateShort(post.data.date),
    iso: post.data.date ?? '',
    minutes: readingTime(post.body),
    short: isShort(post.body),
    summary,
    topic,
    topicId: topic?.id ?? '',
    topicShort: topic?.short ?? '',
    tags: post.data.tags.map((t) => ({
      slug: tagSlug(t),
      label: tagLabel(t),
    })),
    // What the search box matches against: the title, the summary and the
    // tags, in one lowercase string.
    text: [displayTitle(post.data.title), summary, tagNames.join(' ')]
      .join(' ')
      .toLowerCase(),
  };
});
---

<Base
  title="Writing"
  description="Notes on agent runtime security, embedded Rust and the parts that break in production. Every post, newest first, filed by topic."
>
  <!--
    The page is one terminal window. The subjects are the directories, the
    posts are the files, and the filter bar is the part of the machine that
    narrows a listing down. A grid of sixty-nine cards was the same content
    wearing a different costume; the listing is what the content actually
    looks like.
  -->
  <section class="hero">
    <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Notes</span>
    <h1 data-reveal data-reveal-delay="60">Writing</h1>

    <p class="tty-prompt" data-reveal data-reveal-delay="100">
      <span class="who">root</span><span class="sep">@</span><span
        >amaltsev</span>
      ><span class="sep">:</span><span class="path">~/writing</span><span
        class="sep"
        >$</span
      >
      <span class="tty-cmd">ls -la</span>
    </p>

    <p class="lede" data-reveal data-reveal-delay="120">
      {posts.length} notes on agent runtime security, embedded Rust, and the
      parts of a system that break in production.
    </p>
  </section>

  <section class="section">
    <div class="tty tty-index" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/writing</span>
        <span class="tty-right" aria-hidden="true">{posts.length} entries</span>
      </div>

      <div class="tty-body">
        <!--
          The subjects first. A reader who came for one thread — the
          authorization argument, or the firmware series — should be able to
          see that the thread exists without reading the listing. Each one is
          a link into the filtered view, so the directory listing and the
          filter are the same thing seen from two sides.
        -->
        <h2 class="index-h">Subjects</h2>

        <div class="ls ls-topics">
          <div class="ls-row ls-head">
            <span class="ls-mode">mode</span>
            <span class="ls-count">posts</span>
            <span class="ls-name">name</span>
            <span class="ls-desc">subject</span>
          </div>
          {
            TOPICS.map((topic) => (
              <div class="ls-row is-dir">
                <span class="ls-mode">drwxr-xr-x</span>
                <span class="ls-count">{topic.posts.length}</span>
                <span class="ls-name">
                  <a href={`/blog/?topic=${topic.id}`}>{topic.short}/</a>
                </span>
                <span class="ls-desc">{topic.desc}</span>
              </div>
            ))
          }
        </div>

        <hr class="tty-rule" />

        <!--
          The filter bar is hidden until the script runs. A page without
          JavaScript shows every post and no controls that do nothing, which is
          better than a search box that silently never matches.
        -->
        <script is:inline>
          document.documentElement.classList.add('js-filters');
        </script>

        <div class="filters" data-filters>
          <div class="filters-search">
            <label class="sr-only" for="blogSearch">Search the writing</label>
            <input
              id="blogSearch"
              type="search"
              placeholder="grep -i …"
              autocomplete="off"
              data-search
            />
          </div>

          <div class="filters-row">
            <span class="filters-legend" id="filterTopics">Subject</span>
            <div class="filters-chips" role="group" aria-labelledby="filterTopics">
              <button class="filter-chip is-on" type="button" data-topic="" aria-pressed="true">
                All<span class="filter-chip-count">{posts.length}</span>
              </button>
              {
                TOPICS.map((topic) => (
                  <button class="filter-chip" type="button" data-topic={topic.id} aria-pressed="false">
                    {topic.short}
                    <span class="filter-chip-count">{topic.posts.length}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="filters-row" data-row="tags">
            <span class="filters-legend" id="filterTags">Tags</span>
            <div class="filters-chips" role="group" aria-labelledby="filterTags">
              {
                POPULAR.map((tag) => (
                  <button
                    class="filter-chip filter-chip--tag"
                    type="button"
                    data-tag={tag}
                    aria-pressed="false"
                  >
                    {TAG_NAMES[tag] ?? tagLabel(tag)}
                    <span class="filter-chip-count">{chipCounts.get(tag)}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <h2 class="index-h">
          All writing
          <span class="card-meta" data-count>{posts.length} posts</span>
        </h2>

        <div class="ls ls-posts" data-grid>
          <div class="ls-row ls-head">
            <span class="ls-mode">mode</span>
            <span class="ls-date">date</span>
            <span class="ls-size">min</span>
            <span class="ls-topic">topic</span>
            <span class="ls-name">name</span>
          </div>
          {
            cards.map((post, i) => (
              <article
                class="post-row"
                data-card
                data-topic={post.topicId}
                data-tags={post.tags.map((t) => t.slug).join(',')}
                data-text={post.text}
                data-reveal
                data-reveal-delay={Math.min(i, 8) * 30}
              >
                <h3 class="post-title">
                  <span class="ls-row ls-row--post">
                    <span class="ls-mode">-rw-r--r--</span>
                    <span class="ls-date">
                      <time datetime={post.iso}>{post.date}</time>
                    </span>
                    <span class="ls-size">{post.minutes}m</span>
                    <span class="ls-topic">{post.topicShort}</span>
                    <span class="ls-name">
                      <a href={post.href}>{post.title}</a>
                      {post.short && <span class="card-flag">note</span>}
                    </span>
                  </span>
                </h3>

                {post.summary && <p class="post-sum">{post.summary}</p>}

                <div class="post-tags">
                  {post.tags.map((t) => (
                    <a class="tag" href={`/tags/${t.slug}/`}>
                      {t.label}
                    </a>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <p class="filter-empty" data-empty hidden>
          Nothing matches that. Clear the search, or pick another subject.
        </p>
      </div>
    </div>

    <script>
      import '../../scripts/blog-filters.js';
    </script>
  </section>
</Base>

<style>
  /* ----- The window --------------------------------------------------------
     The whole index lives inside one terminal window: the subjects are the
     directories, the posts are the files, and the filter bar is a control
     panel set into the same box.
     ---------------------------------------------------------------------- */
  .tty-index .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  .index-h {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--braise);
  }

  .index-h .card-meta {
    letter-spacing: 0.1em;
  }

  .index-note {
    margin: 0.6rem 0 0;
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--fort);
    max-width: 76ch;
  }

  /* The subject of a directory, in the last column: the one line that says
     what the thread is, so the reader does not have to open it to find out. */
  .ls-topics .ls-row {
    grid-template-columns: 9.5ch 6ch 15ch minmax(0, 1fr);
  }

  .ls-desc {
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.45;
    white-space: normal;
  }

  /* ----- The listing ------------------------------------------------------- */
  .ls-topics {
    margin-bottom: 0;
  }

  .ls-count {
    color: var(--faible);
    font-variant-numeric: tabular-nums;
  }

  /* ----- The filter bar ----------------------------------------------------
     Set into the window rather than floating above it: the controls belong
     to the same machine as the listing they narrow.
     ---------------------------------------------------------------------- */
  .filters {
    display: none;
  }

  :global(html.js-filters) .filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.7rem;
    margin: 0 0 1.5rem;
    padding: 0.85rem 0.9rem 0.9rem;
    border: var(--filet) solid var(--grid);
    background: var(--rouille);
  }

  .filters-search input {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: var(--filet) solid var(--grid);
    background: var(--papier);
    color: var(--encre);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }

  .filters-search input::placeholder {
    color: var(--faible);
  }

  .filters-search input:focus-visible {
    outline: var(--trait) solid var(--braise);
    outline-offset: 1px;
  }

  .filters-row {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .filters-legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--braise);
    flex: 0 0 3.6rem;
  }

  .filters-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    flex: 1 1 18rem;
    min-width: 0;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border: var(--filet) solid var(--grid);
    background: none;
    color: var(--fort);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .filter-chip:hover {
    color: var(--braise);
    border-color: var(--braise);
  }

  .filter-chip.is-on {
    background: var(--braise);
    border-color: var(--braise);
    color: var(--papier);
  }

  .filter-chip-count {
    opacity: 0.7;
    font-size: 0.95em;
  }

  .filter-chip.is-on .filter-chip-count {
    opacity: 0.85;
  }

  /* On a phone the chips are the controls the whole index is filtered by, so
     they get a taller box — forty-four pixels, the height of a thumb's
     target. The type stays the same size — only the padding around it grows,
     so the row of chips keeps its rhythm. */
  @media (max-width: 40rem) {
    .filter-chip {
      padding: 0.7rem 0.7rem;
      font-size: 0.78rem;
    }
  }

  /* The tag row is a strip, not a block, on a phone.
     Fourteen tags wrapped onto six lines put half a screen of controls
     between the reader and the posts they came for. Laid out in one line
     that scrolls sideways, the row costs a finger's height instead of a
     thumb's, and every tag is still one swipe away. The subjects stay
     wrapped: there are five of them, and they are the filter the whole
     index is filed by. */
  @media (max-width: 40rem) {
    .filters-row[data-row='tags'] .filters-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      /* The row continues past the edge, and the fade says so: a chip cut off
         square looks like a mistake, a chip fading out looks like more. */
      mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 2rem), transparent 100%);
    }

    .filters-row[data-row='tags'] .filters-chips::-webkit-scrollbar {
      display: none;
    }

    .filters-row[data-row='tags'] .filter-chip {
      flex: 0 0 auto;
    }
  }

  /* ----- Narrow screens ----------------------------------------------------
     Below the breakpoint the subject of a directory folds under its name,
     the way the title of a file does.
     ---------------------------------------------------------------------- */
  @media (max-width: 52rem) {
    .ls-topics .ls-row {
      grid-template-columns: 9.5ch 5ch minmax(0, 1fr);
      grid-template-areas:
        'mode count name'
        'desc desc desc';
      row-gap: 0.15rem;
    }

    .ls-topics .ls-mode {
      grid-area: mode;
    }

    .ls-topics .ls-count {
      grid-area: count;
    }

    .ls-topics .ls-name {
      grid-area: name;
    }

    .ls-topics .ls-desc {
      grid-area: desc;
    }
  }

  .filter-empty {
    margin: 1.2rem 0 0;
    padding: 0.9rem;
    border: var(--filet) dashed var(--braise);
    color: var(--fort);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }
</style>
