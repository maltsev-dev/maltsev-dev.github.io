---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TOPICS, topicFor } from '../../data/topics';
import { tagSlug, tagLabel } from '../../lib/tags';
import { describe, isShort, readingTime, MAX_DESCRIPTION } from '../../lib/summarize';
import { formatDate } from '../../data/dates';

const posts = (await getCollection('posts')).sort((a, b) =>
  (b.data.date ?? '').localeCompare(a.data.date ?? '')
);

/**
 * The one line under a title.
 *
 * A post that writes its own description gets it; the rest get the first
 * real sentences of their body, cut at a sentence or a clause so the line
 * never ends mid-thought. The short ones — the notes rather than the essays —
 * get a line either way, because a card with a title and nothing else does
 * not tell a reader whether the post is worth opening.
 */
const summaryOf = (post: (typeof posts)[number]): string =>
  describe(post.data.title, post.body, post.data.description, MAX_DESCRIPTION);

/**
 * The emoji that open the older titles.
 *
 * A post page keeps its own title exactly as it was written. In a grid of
 * sixty-nine cards of the same shape they read as noise: one card opens with
 * a robot, the next with a game controller, the next with nothing at all, and
 * the reader ends up reading the pictograms instead of the titles. The grid
 * drops them; the post keeps them.
 */
const bare = (title: string): string =>
  title.replace(/^\p{Extended_Pictographic}\s*/u, '').trim() || title;

/**
 * The tags worth a chip.
 *
 * Fifty-three tags carry the corpus, and the two most common of them —
 * `project` on twenty posts and `basic` on eighteen — say nothing that the
 * title does not. The rest are named here, in the order they earn it, so the
 * row of chips is a set of subjects rather than a word cloud.
 */
const NO_CHIP = new Set(['project', 'basic']);
const CHIP_TAGS = [
  'rust',
  'embedded',
  'authorization',
  'security',
  'reliability',
  'architecture',
  'cost',
  'budget',
  'enforcement',
  'audit',
  'compliance',
  'operations',
  'testing',
  'mcp',
  'sp',
  'solana',
  'product',
  'nurse',
  'memory',
  'timers',
  'interrupts',
  'registers',
  'peripherals',
  'mmio',
  'gpio',
  'clock',
  'linker',
  'compilers',
  'tui',
  'actix_web',
  'webassembly',
  'cli',
  'graphics',
  'svg',
  'java',
  'android',
  'cpp',
  'gamedev',
  'spring',
  'rp2040',
  'nrf52833',
  'redis',
  'ai',
  'open_ai',
  'engineering',
];

/** A readable name for the tags whose spelling is an abbreviation. */
const TAG_NAMES: Record<string, string> = {
  sp: 'serial',
  nurse: 'tinyml',
  actix_web: 'actix',
  open_ai: 'openai',
  ai: 'AI',
};

/** The chips that are worth showing: the ones posts actually carry. */
const chips = CHIP_TAGS.filter((tag) =>
  posts.some((post) => post.data.tags.includes(tag))
).filter((tag) => !NO_CHIP.has(tag));

/** How many posts carry each chip, for the counter on the chip. */
const chipCounts = new Map<string, number>();
for (const tag of chips) {
  chipCounts.set(tag, posts.filter((post) => post.data.tags.includes(tag)).length);
}

/**
 * The chips that carry enough posts to be worth a row.
 *
 * Twenty-four tags reach two posts or more. All twenty-four would wrap onto
 * three lines — a wall of small squares that says "there is a lot here"
 * without saying what. Fourteen is the number that still fits in two lines
 * at a desktop width and one at a phone width, so the row is the fourteen
 * most-used subjects, in the order they earn it, and the rest of the
 * taxonomy is still one click away on any individual post.
 */
const CHIP_LIMIT = 14;

const POPULAR = chips
  .filter((tag) => (chipCounts.get(tag) ?? 0) > 1)
  .sort((a, b) => {
    const byCount = (chipCounts.get(b) ?? 0) - (chipCounts.get(a) ?? 0);
    if (byCount !== 0) return byCount;
    // A tie keeps the hand-written order of `CHIP_TAGS`, so the row still
    // reads as a curriculum rather than an alphabetical accident.
    return CHIP_TAGS.indexOf(a) - CHIP_TAGS.indexOf(b);
  })
  .slice(0, CHIP_LIMIT);

const cards = posts.map((post) => {
  const topic = topicFor(post.id);
  const summary = summaryOf(post);
  const tagNames = post.data.tags.map((t) => tagLabel(t));

  return {
    href: `/blog/${post.id}/`,
    title: bare(post.data.title),
    date: formatDate(post.data.date),
    iso: post.data.date ?? '',
    minutes: readingTime(post.body),
    short: isShort(post.body),
    summary,
    topic,
    topicId: topic?.id ?? '',
    tags: post.data.tags.map((t) => ({
      slug: tagSlug(t),
      label: tagLabel(t),
    })),
    // What the search box matches against: the title, the summary and the
    // tags, in one lowercase string.
    text: [post.data.title, summary, tagNames.join(' ')].join(' ').toLowerCase(),
  };
});
---

<Base
  title="Writing"
  description="Notes on agent runtime security, embedded Rust and the parts that break in production — every post, newest first, filed by topic."
>
  <section class="hero">
    <span class="eyebrow" data-reveal>Notes</span>
    <h1 data-reveal data-reveal-delay="60">Writing</h1>
    <p class="lede" data-reveal data-reveal-delay="120">
      {posts.length} notes on agent runtime security, embedded Rust, and the
      parts of a system that break in production.
    </p>

    <!--
      The subjects, before the list. A reader who came for one thread — the
      authorization argument, or the firmware series — should be able to see
      that the thread exists without reading the index.
    -->
    <ul class="topic-strip" data-reveal data-reveal-delay="180">
      {
        TOPICS.map((topic) => (
          <li class="topic-strip-item">
            <span class="topic-strip-name">{topic.label}</span>
            <span class="topic-strip-count">{topic.posts.length}</span>
            <span class="topic-strip-desc">{topic.desc}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">All writing</h2>
      <span class="card-meta" data-count>{posts.length} posts</span>
    </div>

    <!--
      The filter bar is hidden until the script runs. A page without
      JavaScript shows every post and no controls that do nothing, which is
      better than a search box that silently never matches.
    -->
    <script is:inline>
      document.documentElement.classList.add('js-filters');
    </script>

    <div class="filters" data-filters>
      <div class="filters-search">
        <label class="sr-only" for="blogSearch">Search the writing</label>
        <input
          id="blogSearch"
          type="search"
          placeholder="Search titles and summaries…"
          autocomplete="off"
          data-search
        />
      </div>

      <div class="filters-row">
        <span class="filters-legend" id="filterTopics">Subject</span>
        <div class="filters-chips" role="group" aria-labelledby="filterTopics">
          <button class="filter-chip is-on" type="button" data-topic="" aria-pressed="true">
            All<span class="filter-chip-count">{posts.length}</span>
          </button>
          {
            TOPICS.map((topic) => (
              <button class="filter-chip" type="button" data-topic={topic.id} aria-pressed="false">
                {topic.short}
                <span class="filter-chip-count">{topic.posts.length}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="filters-row" data-row="tags">
        <span class="filters-legend" id="filterTags">Tags</span>
        <div class="filters-chips" role="group" aria-labelledby="filterTags">
          {
            POPULAR.map((tag) => (
              <button
                class="filter-chip filter-chip--tag"
                type="button"
                data-tag={tag}
                aria-pressed="false"
              >
                {TAG_NAMES[tag] ?? tagLabel(tag)}
                <span class="filter-chip-count">{chipCounts.get(tag)}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="blog-grid" data-grid>
      {
        cards.map((post, i) => (
          <article
            class="card post-card"
            data-card
            data-topic={post.topicId}
            data-tags={post.tags.map((t) => t.slug).join(',')}
            data-text={post.text}
            data-reveal
            data-reveal-delay={Math.min(i, 8) * 30}
          >
            <div class="post-card-head">
              <p class="post-card-meta">
                <time datetime={post.iso}>{post.date}</time>
                <span class="post-card-dot" aria-hidden="true">·</span>
                <span>{post.minutes} min</span>
                {post.short && <span class="card-flag">note</span>}
              </p>

              {/*
                The topic on a line of its own. It used to be the third item
                in the meta row, after the date and the reading time — and
                because the row wraps at this width, the separator before it
                was left dangling at the end of the first line on most cards:
                "19 SEPTEMBER 2026 · 10 MIN ·" and then the subject on the
                line below. The subject is also the thing the whole index is
                filed by, so it gets its own line and the meta row is left
                to say when and how long.
              */}
              {post.topic && <p class="post-card-topic">{post.topic.label}</p>}
            </div>

            <h3 class="post-card-title">
              {/*
                The anchor carries the title and nothing else, so the link's
                name is the title. A card that wraps its whole contents in the
                link makes a screen reader walk past the summary and every tag
                to get to the name.
              */}
              <a class="card-link" href={post.href}>
                {post.title}
              </a>
            </h3>

            {post.summary && <p class="post-card-sum">{post.summary}</p>}

            {/*
              The chips used to be spans: styled exactly like links, and
              leading nowhere. They are links now, and every tag has a page
              behind it.
            */}
            <div class="tag-row">
              {post.tags.map((t) => (
                <a class="tag" href={`/tags/${t.slug}/`}>
                  {t.label}
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <p class="filter-empty" data-empty hidden>
      Nothing matches that. Clear the search, or pick another subject.
    </p>
  </section>

  <script>
    import '../../scripts/blog-filters.js';
  </script>
</Base>

<style>
  /* ----- The subjects, above the list ------------------------------------- */
  /*
    Five subjects, laid out as a strip rather than a grid of columns.

    A grid of three columns cannot hold five tiles without leaving a hole in
    the last row — and the hole was visible, because the strip's own background
    was set to `var(--filet)`, which is a length, not a colour, so the gap
    fell through to the page and the empty cell showed the grid pattern
    behind it. Flex has no such hole: the tiles share the row between them
    and the last row stretches to fill whatever is left. The one-pixel gap
    over an accent-coloured ground draws the separators, the same way the
    three panels under "What I do" do on the front page.
  */
  .topic-strip {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--braise);
    border: var(--filet) solid var(--braise);
  }

  .topic-strip-item {
    /* Grow to share the row; the last row of two stretches to the full width
       rather than leaving a third of the strip empty. */
    flex: 1 1 21rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 0.6rem;
    padding: 0.75rem 0.9rem;
    background: var(--papier);
  }

  .topic-strip-name {
    font-family: var(--font-display);
    font-size: 0.98rem;
    letter-spacing: 0.01em;
    color: var(--encre);
  }

  .topic-strip-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--braise);
    padding-top: 0.2em;
  }

  .topic-strip-desc {
    grid-column: 1 / -1;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--fort);
  }

  /* ----- The filter bar --------------------------------------------------- */
  /*
    Hidden without JavaScript: a search box that never matches is worse than
    no search box, and a row of chips that do nothing is a row of lies. The
    inline script on the page adds `js-filters` before the first paint.
  */
  .filters {
    display: none;
  }

  :global(html.js-filters) .filters {
    display: grid;
    /* The one column is capped at the width of the panel. Without the cap a
       row of chips that cannot shrink — the scrolling tag strip on a phone —
       stretches the track to its own width and takes the whole page sideways
       with it. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.7rem;
    margin-bottom: 1.6rem;
    padding: 0.9rem 1rem 1rem;
    border: var(--filet) solid var(--braise);
    background: var(--papier);
    box-shadow: var(--ombre-sm);
  }

  .filters-search input {
    width: 100%;
    padding: 0.65rem 0.7rem;
    border: var(--filet) solid var(--braise);
    background: var(--papier);
    color: inherit;
    font: inherit;
    font-size: var(--fs-small);
  }

  .filters-search input::placeholder {
    color: var(--fort);
    opacity: 0.75;
  }

  .filters-search input:focus-visible {
    outline: var(--trait) solid var(--braise);
    outline-offset: 1px;
  }

  .filters-row {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .filters-legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--braise);
    flex: 0 0 3.6rem;
  }

  .filters-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    flex: 1 1 18rem;
    min-width: 0;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border: var(--filet) solid var(--braise);
    background: none;
    color: var(--fort);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }

  .filter-chip:hover {
    color: var(--braise);
  }

  .filter-chip.is-on {
    background: var(--braise);
    border-color: var(--braise);
    color: var(--papier);
  }

  .filter-chip-count {
    opacity: 0.7;
    font-size: 0.95em;
  }

  .filter-chip.is-on .filter-chip-count {
    opacity: 0.85;
  }

  /* On a phone the chips are the controls the whole index is filtered by, so
     they get a taller box — forty-four pixels, the height of a thumb's
     target. The type stays the same size — only the padding around it grows,
     so the row of chips keeps its rhythm. */
  @media (max-width: 40rem) {
    .filter-chip {
      padding: 0.7rem 0.7rem;
      font-size: 0.78rem;
    }
  }

  /* The tag row is a strip, not a block, on a phone.
     Fourteen tags wrapped onto six lines put half a screen of controls
     between the reader and the posts they came for. Laid out in one line
     that scrolls sideways, the row costs a finger's height instead of a
     thumb's, and every tag is still one swipe away. The subjects stay
     wrapped: there are five of them, and they are the filter the whole
     index is filed by. */
  @media (max-width: 40rem) {
    .filters-row[data-row='tags'] .filters-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      /* The row continues past the edge, and the fade says so: a chip cut off
         square looks like a mistake, a chip fading out looks like more. */
      mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 2rem), transparent 100%);
    }

    .filters-row[data-row='tags'] .filters-chips::-webkit-scrollbar {
      display: none;
    }

    .filters-row[data-row='tags'] .filter-chip {
      flex: 0 0 auto;
    }
  }

  /* ----- The grid --------------------------------------------------------- */
  .blog-grid {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .post-card {
    position: relative;
    gap: 0.5rem;
  }

  /* A hidden card has to actually leave the grid: `.card` sets `display: flex`,
     and an author rule beats the user-agent rule for `[hidden]`. */
  .post-card[hidden] {
    display: none;
  }

  /* The head of the card: when it was written, how long it takes, and what
     it is filed under. The subject sits on its own line under the two facts
     rather than trailing them, so nothing wraps into a dangling separator. */
  .post-card-head {
    display: grid;
    gap: 0.18rem;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fort);
  }

  .post-card-dot {
    opacity: 0.6;
  }

  .post-card-topic {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--braise);
  }

  .post-card-title {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card:hover .card-link {
    color: var(--braise);
  }

  .post-card-sum {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--fort);
  }

  .post-card .tag {
    text-decoration: none;
  }

  .post-card .tag-row {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  .post-card .tag:hover {
    color: var(--braise);
    border-color: var(--braise);
  }

  /* A short post is a note, and the index says so rather than letting the
     reader open it expecting an essay. */
  .card-flag {
    margin-left: 0.2rem;
    padding: 0 0.3rem;
    border: 1px solid var(--filet);
    color: var(--fort);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .filter-empty {
    margin: 1.6rem 0 0;
    padding: 1.1rem;
    border: var(--filet) dashed var(--braise);
    color: var(--fort);
    text-align: center;
  }
</style>
