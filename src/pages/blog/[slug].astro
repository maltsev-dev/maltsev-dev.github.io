---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { describe, readingTime } from '../../lib/summarize';
import { blogPostingNode, AUTHOR, postImage, contactMailto } from '../../lib/schema';
import { formatDate } from '../../data/dates';
import { tagSlug, tagLabel } from '../../lib/tags';
import { displayTitle } from '../../lib/text';
import { topicFor } from '../../data/topics';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // Newest first, the order the index lists them in. The neighbors are cut
  // from this list, so the two ends of it have one neighbor instead of two.
  const ordered = [...posts].sort((a, b) =>
    (b.data.date ?? '').localeCompare(a.data.date ?? '')
  );
  return ordered.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      older: ordered[i + 1] ?? null,
      newer: ordered[i - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);

// The meta description used to be the title, so every post advertised itself
// twice and the search snippet was whatever the title happened to be. A post
// that writes its own description gets it; the rest get the first real
// sentence of their body.
const description = describe(post.data.title, post.body, post.data.description);

// The title as the site draws it: the ornament that came with the post is
// left off, so the heading is the same kind of thing as every other heading
// on the site.
const title = displayTitle(post.data.title);

// The subject this post belongs to. The tags below say what it is *about*;
// the topic says which thread it is part of, and it is a door back to the
// rest of that thread rather than a label on this page alone.
const topic = topicFor(post.id);

const siteUrl = new URL(Astro.site ?? 'https://maltsev-dev.github.io');
const schema = [
  blogPostingNode(siteUrl, {
    title,
    description,
    date: post.data.date,
    updated: post.data.updated,
    tags: post.data.tags,
    slug: post.id,
  }),
];

// The social card for this post. Every page on the site used to share one
// picture of the site's homepage, so a preview of a post in a chat said
// nothing about the post. Each post has a card of its own, generated by
// `_gen_og.mjs` into `static/og/`.
const card = postImage(post.id);
const cardAlt = `${title}, a post by Anatolii Maltsev`;

// The posts this one leads to. A reader who lands from search on one of the
// hardware notes used to have nowhere to go: eighteen of the posts carried no
// onward link at all, and the hardware cluster never linked into the agent
// writing that is the site's actual subject. Ranked by how many tags they
// share, then by date, so the nearest neighbor comes first.
const allPosts = await getCollection('posts');
const others = allPosts.filter((p) => p.id !== post.id);

const related = others
  .map((p) => ({
    post: p,
    shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
  }))
  .filter((x) => x.shared > 0)
  .sort(
    (a, b) =>
      b.shared - a.shared ||
      (b.post.data.date ?? '').localeCompare(a.post.data.date ?? '')
  )
  .slice(0, 3)
  .map((x) => x.post);

// A post whose tags belong to it alone — the AI pipeline note is the only one
// tagged `architecture` — would still be a dead end. It falls back to the
// newest writing instead, under a heading that says what it is.
const neighbors = related.length
  ? related
  : [...others]
      .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))
      .slice(0, 3);
const neighborLabel = related.length ? 'Related' : 'Recent writing';

/**
 * A date in the shape a listing uses.
 *
 * The corpus stores `2026-04-07` and the byline says "7 April 2026"; a
 * listing wants neither — it wants a column. The year and the month are
 * enough to place a post in a sequence, and they fit in the width of the
 * column without pushing the title out of the way.
 */
const when = (iso: string | undefined): string => {
  const match = /^(\d{4})-(\d{2})/.exec((iso ?? '').trim());
  return match ? `${match[1]}-${match[2]}` : '';
};

/** The words in the body, for the window's own corner. */
const words = post.body.trim().split(/\s+/).filter(Boolean).length;
---

<Base
  title={title}
  description={description}
  image={card}
  imageAlt={cardAlt}
  type="article"
  schema={schema}
>
  <!--
    The post, as a file being read.

    It used to be a title on a page and a column of prose under it. The
    column is still there — the writing is the writing — but the page now
    says what it is doing: a file in a directory, opened by a command, with
    the command on the line above the output. Everything else on the site
    works this way now, and a post that read differently from the page
    before it broke the pattern the reader had just learned.
  -->
  <article class="post-page">
    <header class="post-head">
      <p class="article-back">
        <a href="/blog/">← Writing</a>
      </p>

      <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Post</span>

      <h1 data-reveal data-reveal-delay="60">{title}</h1>

      <p class="tty-prompt" data-reveal data-reveal-delay="100">
        <span class="who">root</span><span class="sep">@</span><span
          >amaltsev</span>
        ><span class="sep">:</span><span class="path">~/blog</span><span class="sep"
          >$</span
        >
        <span class="tty-cmd">cat {post.id}.md</span>
      </p>

      <p class="lede" data-reveal data-reveal-delay="120">{description}</p>

      <!--
        The metadata line. The date used to be the raw ISO string on all
        sixty-nine posts — machine format on every page of the site. It is
        written the way a reader says it now, and the author and the reading
        time sit beside it, both of which the page did not have at all.
      -->
      <p class="lead-meta" data-reveal data-reveal-delay="140">
        <span>{formatDate(post.data.date)}</span>
        <span class="lead-sep" aria-hidden="true">·</span>
        <span>{AUTHOR.name}</span>
        <span class="lead-sep" aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
        {
          topic && (
            <>
              <span class="lead-sep" aria-hidden="true">·</span>
              <a class="lead-topic" href={`/blog/?topic=${topic.id}`}>
                {topic.label}
              </a>
            </>
          )
        }
        {
          post.data.tags.length > 0 && (
            <>
              <span class="lead-sep" aria-hidden="true">·</span>
              <span class="lead-tags">
                {post.data.tags.map((t) => (
                  <a class="lead-tag" href={`/tags/${tagSlug(t)}/`}>
                    {tagLabel(t)}
                  </a>
                ))}
              </span>
            </>
          )
        }
      </p>
    </header>

    <section class="section">
      <div class="tty tty-fit tty-post" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-off"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/blog/{post.id}.md</span>
          <span class="tty-right" aria-hidden="true">{words} words</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span>
            ><span class="sep">:</span><span class="path">~/blog</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">cat {post.id}.md</span>
          </p>

          <!--
            The body. It keeps the site's prose rules — a measure of about
            seventy characters, headings on the mono face, code in the mono
            face — and it inherits them from the same place every other page
            inherits them from.
          -->
          <div class="prose post-prose">
            <Content />
          </div>
        </div>
      </div>
    </section>

    <!--
      The close of the article. The post used to end with its last line and
      nothing else: no way onward, no way to ask, no way back into the
      writing. Three things close it now — the neighbours in time, the posts
      that share its subject, and the invitation to write about it.
    -->
    <section class="section">
      <div class="tty tty-fit tty-more" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-off"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/blog</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span>
            ><span class="sep">:</span><span class="path">~/blog</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">ls -la</span>
          </p>

          <div class="ls ls-head">
            <div class="ls-row ls-row--when ls-head">
              <span class="ls-when">when</span>
              <span class="ls-name">name</span>
              <span class="ls-cue"></span>
            </div>
          </div>

          <div class="ls ls-more">
            {
              newer && (
                <div class="ls-row ls-row--when">
                  <span class="ls-when">{when(newer.data.date)}</span>
                  <span class="ls-name">
                    <a href={`/blog/${newer.id}/`}>{displayTitle(newer.data.title)}</a>
                  </span>
                  <span class="ls-cue">Read →</span>
                </div>
              )
            }
            {
              older && (
                <div class="ls-row ls-row--when">
                  <span class="ls-when">{when(older.data.date)}</span>
                  <span class="ls-name">
                    <a href={`/blog/${older.id}/`}>{displayTitle(older.data.title)}</a>
                  </span>
                  <span class="ls-cue">Read →</span>
                </div>
              )
            }
          </div>

          <hr class="tty-rule" />

          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span>
            ><span class="sep">:</span><span class="path">~/blog</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">
              grep -l "{post.data.tags[0] ?? 'ai'}" -r ~/blog
            </span>
          </p>

          <div class="ls ls-more">
            {
              neighbors.map((r) => (
                <div class="ls-row ls-row--when">
                  <span class="ls-when">{when(r.data.date)}</span>
                  <span class="ls-name">
                    <a href={`/blog/${r.id}/`}>{displayTitle(r.data.title)}</a>
                  </span>
                  <span class="ls-cue">Read →</span>
                </div>
              ))
            }
          </div>

          <p class="more-close">
            {neighborLabel}: the posts that share this one's subject, and
            where the thread goes next.
          </p>
        </div>
      </div>
    </section>

    <!--
      The close. The invitation stays; the button that repeated one the whole
      site already carries is gone. The status bar's "available" indicator
      opens the message form on every page, so a post that also carried a
      "Write a message" button was the same offer twice on one screen. The
      address in the sentence is the way to write without the script.

      The button under it points at the shipped work rather than at a page
      describing how to hire me: the reader who got this far from a search
      engine wants to see that the claim is real.
    -->
    <section class="section">
      <div class="tty tty-fit tty-contact" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-off"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/contact</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span>
            ><span class="sep">:</span><span class="path">~</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">mail -s "About: {title}" \</span>
          </p>

          <p class="tty-prompt tty-cmd-line tty-cont-line">
            <span class="tty-cont" aria-hidden="true">&gt;</span>
            <a class="post-cta-mail" href={contactMailto(`About: ${title}`)}>
              mr.a.maltsev@gmail.com
            </a>
          </p>

          <p class="contact-note">
            If this is close to the work you are trying to do, I am the person
            who wrote it.
          </p>

          <p class="contact-go">
            <a class="btn" href="/projects/">See the work</a>
          </p>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  /* ----- The column --------------------------------------------------------
     A post is a column of reading. The window around it adds a frame, not a
     width: the frame is wider than the text so the text keeps its own
     measure inside it.

     The column sits at the left edge of the page, like every other window
     on the site, and it sets the width of its own windows once. A terminal
     prints every line from column zero.

     The width is `--measure-doc`: the default width of a window that holds
     a document. The prose inside it keeps its own measure, `--measure-prose`,
     so the two are separate objects — the frame is the page, the measure is
     the sentence.
     ---------------------------------------------------------------------- */
  .post-page {
    --w: 100%;
    margin-inline: 0;
    max-width: var(--measure-doc);
  }

  .post-head {
    margin-bottom: 2rem;
  }

  .post-head h1 {
    margin-top: 0.5rem;
  }

  /* ----- The close of the article -----------------------------------------
     The neighbours are a listing, so they are a listing: one window, one
     command, one header row.
     ---------------------------------------------------------------------- */
  .tty-more .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  .ls-more .ls-row {
    padding-block: 0.22rem;
  }

  .ls-more .ls-name a {
    color: var(--encre);
    text-decoration: none;
  }

  .ls-more .ls-name a:hover {
    color: var(--braise);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .more-close {
    margin: 1.2rem 0 0;
    max-width: var(--measure-prose);
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  /* ----- The invitation ---------------------------------------------------- */
  .tty-contact .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  .tty-contact .post-cta-mail {
    color: var(--creme);
  }

  .contact-note {
    margin: 0.9rem 0 0;
    max-width: var(--measure-prose);
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .contact-go {
    margin: 1.1rem 0 0;
  }

  /* ----- The tag links in the metadata line --------------------------------
     The line is uppercase and mono like the rest of the byline, so the links
     only need to say they are links.
     ---------------------------------------------------------------------- */
  .lead-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .lead-tag {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--filet);
  }

  .lead-tag:hover {
    color: var(--braise);
    border-color: var(--braise);
  }

  /* The topic badge. It sits in the same mono byline as the tags but reads
     as one step louder, because it is the one item in the line that is a
     place rather than a word: the thread this post belongs to. */
  .lead-topic {
    color: var(--braise);
    text-decoration: none;
    border: var(--filet) solid currentColor;
    padding: 0.05rem 0.4rem;
  }

  .lead-topic:hover {
    background: var(--braise);
    color: var(--papier);
  }
</style>
