---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tagSlug, tagLabel } from '../../lib/tags';
import { describe, MAX_DESCRIPTION } from '../../lib/summarize';
import { formatDate } from '../../data/dates';
import { topicFor } from '../../data/topics';

/**
 * One page per tag.
 *
 * The tag chips on the index used to be styled as links and were not links:
 * they looked filterable and did nothing, and the route they implied,
 * `/tags/<tag>/`, did not exist at all — it was a 404 that the legacy
 * generator had once published and the current one did not. So a reader who
 * clicked a tag was told the page was missing.
 *
 * These pages are the fix: every tag in the front matter gets a real
 * address, the chips point at them, and the legacy spellings redirect here.
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts');

  // One entry per tag, with every post that carries it. Two posts that spell
  // the same tag differently would otherwise get two pages for one subject.
  const byTag = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const raw of post.data.tags) {
      const slug = tagSlug(raw);
      if (!slug) continue;
      const entry = byTag.get(slug);
      if (entry) entry.posts.push(post);
      else byTag.set(slug, { tag: raw, posts: [post] });
    }
  }

  return [...byTag.entries()]
    .sort((a, b) => b[1].posts.length - a[1].posts.length || a[0].localeCompare(b[0]))
    .map(([slug, entry]) => ({
      params: { tag: slug },
      props: {
        slug,
        label: tagLabel(entry.tag),
        posts: entry.posts.sort((a, b) =>
          (b.data.date ?? '').localeCompare(a.data.date ?? '')
        ),
      },
    }));
}

const { slug, label, posts } = Astro.props;

const title = `Posts tagged “${label}”`;
const description = `${posts.length} ${
  posts.length === 1 ? 'post' : 'posts'
} on ${label} — writing on embedded Rust, agentic systems and the parts that break in production.`;
---

<Base title={title} description={description}>
  <section class="hero">
    <span class="eyebrow" data-reveal>Tag</span>
    <h1 data-reveal data-reveal-delay="60">{label}</h1>
    <p class="lede" data-reveal data-reveal-delay="120">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} on {label}.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">Writing</h2>
      <span class="card-meta">newest first</span>
    </div>

    <ul class="tag-posts">
      {
        posts.map((post, i) => (
          <li class="tag-post" data-reveal data-reveal-delay={Math.min(i, 4) * 40}>
            <a href={`/blog/${post.id}/`}>
              <span class="card-meta">{formatDate(post.data.date)}</span>
              {/*
                The thread the post belongs to, next to the date. A tag page
                is a cross-section of several threads at once, and saying which
                one each post came from is what makes the list navigable
                rather than just long.
              */}
              {topicFor(post.id) && (
                <span class="tag-post-topic">{topicFor(post.id)?.label}</span>
              )}
              <h3>{post.data.title}</h3>
              <p>{describe(post.data.title, post.body, post.data.description, MAX_DESCRIPTION)}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="tag-back">
      <a class="btn" href="/blog/">← All writing</a>
    </div>
  </section>
</Base>

<style>
  /*
    The index's cards are a horizontal strip, and a tag page is a plain list
    of everything carrying the tag. The list is styled here rather than in
    the shared stylesheet: it belongs to this page alone.
  */
  .tag-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .tag-post a {
    display: block;
    padding: 1.1rem;
    border: var(--filet) solid var(--braise);
    background: var(--papier);
    box-shadow: var(--ombre-sm);
    text-decoration: none;
    color: inherit;
  }

  .tag-post a:hover h3 {
    color: var(--braise);
  }

  /* The thread, beside the date. It is a label, not a link: the whole row is
     already one link to the post, and a link inside a link is not a link. */
  .tag-post-topic {
    margin-left: 0.6rem;
    color: var(--braise);
  }

  .tag-post h3 {
    margin: 0.25rem 0 0.4rem;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .tag-post p {
    margin: 0;
    color: var(--fort);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .tag-back {
    margin-top: 1.5rem;
  }
</style>
