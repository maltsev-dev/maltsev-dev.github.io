---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tagSlug, tagLabel } from '../../lib/tags';
import { describe, isShort, readingTime, MAX_DESCRIPTION } from '../../lib/summarize';
import { formatDateShort } from '../../data/dates';
import { topicFor } from '../../data/topics';
import { displayTitle } from '../../lib/text';

/**
 * One page per tag.
 *
 * The tag chips on the index used to be styled as links and were not links:
 * they looked filterable and did nothing, and the route they implied,
 * `/tags/<tag>/`, did not exist at all — it was a 404 that the legacy
 * generator had once published and the current one did not. So a reader who
 * clicked a tag was told the page was missing.
 *
 * These pages are the fix: every tag in the front matter gets a real
 * address, the chips point at them, and the legacy spellings redirect here.
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts');

  // One entry per tag, with every post that carries it. Two posts that spell
  // the same tag differently would otherwise get two pages for one subject.
  const byTag = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const raw of post.data.tags) {
      const slug = tagSlug(raw);
      if (!slug) continue;
      const entry = byTag.get(slug);
      if (entry) entry.posts.push(post);
      else byTag.set(slug, { tag: raw, posts: [post] });
    }
  }

  return [...byTag.entries()]
    .sort((a, b) => b[1].posts.length - a[1].posts.length || a[0].localeCompare(b[0]))
    .map(([slug, entry]) => ({
      params: { tag: slug },
      props: {
        slug,
        label: tagLabel(entry.tag),
        posts: entry.posts.sort((a, b) =>
          (b.data.date ?? '').localeCompare(a.data.date ?? '')
        ),
      },
    }));
}

const { slug, label, posts } = Astro.props;

const title = `Posts tagged “${label}”`;
const description = `${posts.length} ${
  posts.length === 1 ? 'post' : 'posts'
} on ${label} — writing on embedded Rust, agentic systems and the parts that break in production.`;

/**
 * The posts, prepared for the listing.
 *
 * The same shape as the index: a title, a line about what is in it, and the
 * tags it carries. A tag page is the index with a query on it, so the rows
 * must be the same rows — a reader who moves between the two should not have
 * to learn a second list.
 */
const rows = posts.map((post) => {
  const topic = topicFor(post.id);
  const summary = describe(post.data.title, post.body, post.data.description, MAX_DESCRIPTION);

  return {
    href: `/blog/${post.id}/`,
    title: displayTitle(post.data.title),
    date: formatDateShort(post.data.date),
    iso: post.data.date ?? '',
    minutes: readingTime(post.body),
    short: isShort(post.body),
    summary,
    topicShort: topic?.short ?? '',
    tags: post.data.tags.map((t) => ({
      slug: tagSlug(t),
      label: tagLabel(t),
    })),
  };
});
---

<Base title={title} description={description}>
  <!--
    A tag is a query, so the page is a query.

    The index is `ls -la` over the whole directory; a tag is one file
    argument narrowed down. So this is the same machine with a `grep` on
    it: the same window, the same listing, the same rows. The reader who
    arrives here from a chip in a listing learns one shape and sees it
    again.
  -->
  <section class="hero">
    <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Tag</span>
    <h1 data-reveal data-reveal-delay="60">{label}</h1>

    <p class="tty-prompt" data-reveal data-reveal-delay="100">
      <span class="who">root</span><span class="sep">@</span><span
        >amaltsev</span>
      ><span class="sep">:</span><span class="path">~/blog</span><span class="sep"
        >$</span
      >
      <span class="tty-cmd">grep -l "{slug}" -r ~/blog</span>
    </p>

    <p class="lede" data-reveal data-reveal-delay="120">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} on {label}.
    </p>
  </section>

  <section class="section">
    <div class="tty tty-tag" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/blog</span>
        <span class="tty-right" aria-hidden="true">
          {posts.length} {posts.length === 1 ? 'match' : 'matches'}
        </span>
      </div>

      <div class="tty-body">
        <p class="tty-prompt tty-cmd-line">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/blog</span><span class="sep"
            >$</span
          >
          <span class="tty-cmd">grep -l "{slug}" -r ~/blog</span>
        </p>

        <div class="ls ls-posts">
          <div class="ls-row ls-head">
            <span class="ls-mode">mode</span>
            <span class="ls-date">date</span>
            <span class="ls-size">min</span>
            <span class="ls-topic">topic</span>
            <span class="ls-name">name</span>
          </div>

          {
            rows.map((post, i) => (
              <article
                class="post-row"
                data-reveal
                data-reveal-delay={Math.min(i, 8) * 30}
              >
                <h3 class="post-title">
                  <span class="ls-row ls-row--post">
                    <span class="ls-mode">-rw-r--r--</span>
                    <span class="ls-date">
                      <time datetime={post.iso}>{post.date}</time>
                    </span>
                    <span class="ls-size">{post.minutes}m</span>
                    <span class="ls-topic">{post.topicShort}</span>
                    <span class="ls-name">
                      <a href={post.href}>{post.title}</a>
                      {post.short && <span class="card-flag">note</span>}
                    </span>
                  </span>
                </h3>

                {post.summary && <p class="post-sum">{post.summary}</p>}

                <div class="post-tags">
                  {post.tags.map((t) => (
                    <a class="tag" href={`/tags/${t.slug}/`}>
                      {t.label}
                    </a>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <!--
          The count, the way grep reports it. It is the one line in the
          window that is not a file, and it says what the listing is worth.
        -->
        <p class="grep-count">~/blog: {posts.length} {posts.length === 1 ? 'match' : 'matches'}</p>

        <hr class="tty-rule" />

        <p class="tty-prompt tty-cmd-line">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/blog</span><span class="sep"
            >$</span
          >
          <span class="tty-cmd">cd ~/blog &amp;&amp; ls -la</span>
        </p>

        <p class="tag-close">
          The whole directory is one click away. Every post, filed by
          subject.
        </p>
      </div>
    </div>

    <p class="tag-back">
      <a class="btn" href="/blog/">← All writing</a>
    </p>
  </section>
</Base>

<style>
  .tty-tag .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  /* The count grep prints when it is done. */
  .grep-count {
    margin: 0.8rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--faible);
  }

  .tag-close {
    margin: 0.6rem 0 0;
    max-width: 62ch;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--fort);
  }

  .tag-back {
    margin-top: 1.4rem;
  }
</style>
