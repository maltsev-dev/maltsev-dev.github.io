---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch about a project.">
  <!--
    The letter modal is shared with the status bar. On this route it opens on
    arrival, so the visitor lands on the form itself rather than on a page
    whose only content is a button that opens a form.
  -->
  <section class="hero">
    <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Contact</span>
    <h1 data-reveal data-reveal-delay="60" data-anim="type">Write to me</h1>
    <p class="lede" data-reveal data-reveal-delay="120">
      Tell me what you are trying to automate. If I can help, I will say so
      plainly — and if I cannot, I will point you somewhere better.
    </p>

    <div class="btn-row" data-reveal data-reveal-delay="180">
      <button class="btn btn-primary" type="button" data-open-letter>Open a letter</button>
      <a class="btn" href="mailto:mr.a.maltsev@gmail.com">Email directly</a>
    </div>
  </section>

  <section class="section">
    <div class="os-panel" data-reveal>
      <p class="lede">
        Prefer plain email? <a href="mailto:mr.a.maltsev@gmail.com">mr.a.maltsev@gmail.com</a>
      </p>
    </div>
  </section>

  <script>
    // Open the shared modal once the boot overlay has cleared, so the two
    // never stack on top of each other.
    import '../scripts/open-letter.js';
  </script>
</Base>