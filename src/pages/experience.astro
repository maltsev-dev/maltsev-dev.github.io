---
import Base from '../layouts/Base.astro';

// Presented as a commit log: each stop is one entry with a hash, a branch and a
// date. The hash-shaped values are decoration — they identify a panel, nothing
// more. Replace or extend as the history changes; the page reads from here.
interface Stop {
  hash: string;
  /** Employment type — the branch name in the log framing. */
  kind: string;
  when: string;
  span: string;
  role: string;
  org: string;
  href?: string;
  /** The part of the LinkedIn title after the first separator. */
  tagline?: string;
  body?: string;
  points: string[];
  skills: string[];
  /** Count of skills the source profile collapsed; rendered as a muted chip. */
  more?: number;
  /** Which rung of the career rail below the track this stop belongs to. */
  stage: StageId;
}

/**
 * The career rail at the foot of the track: the five rungs the history climbs,
 * oldest first. The track itself runs the other way — it starts at the present
 * and travels back — so this list is the only place the order is chronological.
 */
interface Stage {
  id: StageId;
  name: string;
  since: string;
}

type StageId = 'founder' | 'independent' | 'sr-sdet' | 'sdet' | 'qa';

const STAGES: Stage[] = [
  { id: 'founder', name: 'Founder', since: '2026' },
  { id: 'independent', name: 'Indie Expert', since: '2025' },
  { id: 'sr-sdet', name: 'Sr SDET', since: '2023' },
  { id: 'sdet', name: 'SDET', since: '2020' },
  { id: 'qa', name: 'QA', since: '2019' },
];

const STOPS: Stop[] = [
