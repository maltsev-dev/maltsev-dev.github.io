---

<Base title="Experience" description="Where I have worked and what I built.">
  <!-- One viewport, no vertical scroll: the wheel drives the row sideways. See
       the .exp-page rules in track.css and track.js. -->
  <div class="exp-page">
  <section class="hero">
    <span class="eyebrow"><span class="pulse-dot"></span>Experience</span>
    <h1 data-anim="type">The road so far</h1>
    <p class="lede">
      Seven years, six stops — from QA automation on banking systems to building
      authorization infrastructure for agents. Scroll, or use the arrow keys: the
      work travels sideways, each stop coming into focus in turn.
    </p>
  </section>

  <div class="track-scroll" data-track-scroll data-track-mode="wheel">
    <div class="track" data-track>
      <div class="track-row" data-track-row>
      {
        STOPS.map((s) => (
          <article class="track-panel track-stop" data-stage={s.stage}>
            <p class="track-meta">
              <span class="track-hash">{s.hash}</span>
              <span class="track-chip">{s.kind}</span>
              <span>{s.when}</span>
              <span class="track-span">{s.span}</span>
            </p>

            <h2>{s.role}</h2>

            <p class="track-org">
              {s.href ? <a href={s.href} rel="noopener">{s.org}</a> : <span>{s.org}</span>}
              {s.tagline && <em> — {s.tagline}</em>}
            </p>

            {s.body && <p class="track-body">{s.body}</p>}

            <ul class="track-points">
              {s.points.map((point) => (
                <li>
                  <span aria-hidden="true">◆</span>
                  <p>{point}</p>
                </li>
              ))}
            </ul>

            <ul class="track-skills">
              {s.skills.map((skill) => (
                <li>{skill}</li>
              ))}
              {s.more && <li class="track-skill-more">+{s.more} more</li>}
            </ul>
          </article>
        ))
      }

      <article class="track-panel">
        <p class="track-meta">
          <span class="track-hash">--graph</span>
          <span class="track-chip">toolkit</span>
        </p>
        <h2>What I reach for</h2>
        <ul class="track-projects">
          {
            TOOLS.map(([label, value]) => (
              <li>
                <span aria-hidden="true">·</span>
                <div>
                  <strong>{label}</strong>
                  <span>{value}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <!--
      The career rail: the five rungs of the history, oldest first. It reads the
      opposite way to the track — the track starts at the present, this starts at
      the first job — so the fill is anchored to the right end and depletes as
      the reader travels back through time. Hidden from assistive tech: it
      repeats the dates already on each panel.
    -->
    <div class="branches" data-branches aria-hidden="true">
      <p class="branches-count">
        <span data-hud-current>01</span> / {String(STOPS.length + 1).padStart(2, '0')}
      </p>

      <ol class="branch-list">
        {
          STAGES.map((stage) => (
            <li data-stage={stage.id}>
              <i class="branch-node" />
              <b>{stage.name}</b>
              <span>{stage.since}</span>
            </li>
          ))
        }
      </ol>
    </div>
    </div>
  </div>
  </div>

  <script>
    import '../scripts/track.js';
  </script>
</Base>