---
import '../styles/skills.css';
import Base from '../layouts/Base.astro';
import CareerModal from '../components/CareerModal.astro';
import { SKILL_TIERS } from '../data/skills';
import { STOPS, period, duration } from '../data/stops';
import { yearsOfExperience, spellNumber, SKILL_COUNT } from '../lib/profile';

// The length of the career and the size of the toolkit, both read from the
// data rather than typed. See lib/profile.ts for where they come from.
//
// The number is written as a word where it opens a sentence, and as a digit
// where it reads better in a headline — the count is the same either way.
const YEARS = yearsOfExperience();
const YEARS_WORD = spellNumber(YEARS);
const YEARS_SENTENCE = spellNumber(YEARS, true);

/**
 * The whole skill set, as a tree.
 *
 * Five tiers, and the widest at the bottom is what everything else is built
 * on: each tier above is narrower and more specific. Ordering is the point —
 * a flat list of equal chips says nothing about where a skill sits.
 *
 * It lives in data/skills.ts rather than here because every skill now carries
 * three facts behind it — the jobs it was used on, its certifications, the
 * projects it shipped in — and the page shows those three counts next to the
 * name. One dataset, one presentation, so they cannot disagree about a
 * number.
 */
const TIERS = SKILL_TIERS.map((tier) => ({
  id: tier.id,
  label: tier.label,
  skills: tier.skills.map((skill) => ({
    id: skill.id,
    name: skill.name,
    jobs: skill.jobs.length,
    certs: skill.certs.length,
    projects: skill.projects.length,
  })),
}));

// How many tiers the tree has. Counted from the same data the tree is
// built from, so the prose above it and the shape below it cannot disagree.
const TIER_COUNT = SKILL_TIERS.length;

/** The counts beside a skill, in words a reader can weigh at a glance. */
const factsOf = (skill: { jobs: number; certs: number; projects: number }): string =>
  [
    skill.jobs ? `${skill.jobs} job${skill.jobs === 1 ? '' : 's'}` : '',
    skill.certs ? `${skill.certs} cert${skill.certs === 1 ? '' : 's'}` : '',
    skill.projects
      ? `${skill.projects} project${skill.projects === 1 ? '' : 's'}`
      : '',
  ]
    .filter(Boolean)
    .join(' · ');
---

<Base title="Experience" description="Where I have worked and what I built.">
  <!--
    The page is a log. The career has an order and a direction — it starts at
    the present and travels back — and a log says both without needing to be
    told about them. Underneath the log is the toolkit, drawn as a tree,
    because that is what a toolkit is: a directory of things, each one with
    what stands behind it.

    The width is set once, on the wrapper below, so the log window starts
    where the column starts and ends where the column ends.
  -->
  <div class="exp-page">
    <section class="hero">
      <span class="eyebrow"><span class="pulse-dot"></span>Experience</span>
      <h1 data-anim="type">The road so far</h1>

      <p class="tty-prompt" data-reveal>
        <span class="who">root</span><span class="sep">@</span><span
          >amaltsev</span
        ><span class="sep">:</span><span class="path">~/career</span><span
          class="sep"
          >$</span
        >
        <span class="tty-cmd">git log --author="maltsev"</span>
      </p>

      <p class="lede" data-reveal data-reveal-delay="60">
        {YEARS_SENTENCE} years, {spellNumber(STOPS.length)} stops. The thread
        runs from QA automation on banking systems to building authorization
        infrastructure for agents. The log reads newest first; the toolkit it
        went into is below.
      </p>
    </section>

    <section class="section">
      <div class="tty tty-log" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-off"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/career</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span
            ><span class="sep">:</span><span class="path">~/career</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">git log</span>
          </p>

          <!--
            The log, folded. A stop is a record of six fields: when it ran, how
            long, the role, what it was about, the company and the form of the
            engagement. The rest of the entry — the commit header, the
            paragraph that says what the step was, the points, the stacks —
            opens in the panel's dialog, in full.
          -->
          {
            STOPS.map((s, i) => (
              <article
                class="exp-row"
                data-exp-row
                data-reveal
                data-reveal-delay={Math.min(i, 5) * 50}
              >
                <p class="exp-field">
                  <span class="exp-key">Date:</span>
                  <span class="exp-val">{period(s)}</span>
                </p>

                <p class="exp-field">
                  <span class="exp-key">Duration:</span>
                  <span class="exp-val">{duration(s.span)}</span>
                </p>

                <h3 class="exp-role">
                  <span class="exp-key">Role:</span>
                  <button
                    type="button"
                    class="exp-open"
                    data-exp-open={s.hash}
                    aria-haspopup="dialog"
                  >
                    {s.role}
                  </button>
                </h3>

                {s.tagline && (
                  <p class="exp-field">
                    <span class="exp-key">Responsibilities:</span>
                    <span class="exp-val">{s.tagline}</span>
                  </p>
                )}

                <p class="exp-field">
                  <span class="exp-key">Company:</span>
                  <span class="exp-val exp-org">
                    {s.href ? <a href={s.href} rel="noopener">{s.company}</a> : s.company}
                  </span>
                </p>

                <p class="exp-field">
                  <span class="exp-key">Form:</span>
                  <span class="exp-val">{s.form}</span>
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!--
      The toolkit, as a tree. A pyramid said where a skill sat; a tree says the
      same thing and is something a reader already knows how to read. The three
      counts beside each name used to be behind a hover card — they are printed
      now, because a number that is only there when you point at it is a number
      most readers never see.
    -->
    <section class="skills" id="skills">
      <div class="skills-head">
        <span class="eyebrow"><span class="pulse-dot"></span>Toolkit</span>
        <h2>What the {YEARS_WORD} years added up to</h2>
        <p>
          {SKILL_COUNT} skills in {spellNumber(TIER_COUNT)} tiers, foundations
          first. Beside each one: the jobs it was used on, what certifies it, and
          where it shipped.
        </p>
      </div>

      <div class="skill-tree" data-reveal>
        {
          TIERS.map((tier) => (
            <div class="skill-tier">
              <p class="skill-tier-name">
                <span class="skill-tier-dir">{tier.label}/</span>
                <span class="skill-tier-count">
                  {tier.skills.length} skill{tier.skills.length === 1 ? '' : 's'}
                </span>
              </p>

              <ul class="tree skill-tree-list">
                {tier.skills.map((skill) => (
                  <li>
                    <span class="skill-name">{skill.name}</span>
                    <span class="skill-facts">{factsOf(skill)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <CareerModal stops={STOPS} />
</Base>

<style>
  /* ----- One column --------------------------------------------------------
     The width of the window on the page, set once. The log used to take the
     width of its longest line and sit in the middle of the column, which put
     its left edge somewhere else entirely.
     ---------------------------------------------------------------------- */
  .exp-page {
    --w: 100%;
  }

  /* ----- The log -----------------------------------------------------------
     The window that holds the career. The frame is the same one the shell
     uses, so the two read as the same machine.
     ---------------------------------------------------------------------- */
  .tty-log .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  /* The log is a window around a log, so it is the width of the log. It used
     to be the width of its longest line and sit in the middle of the column,
     which put its left edge at a different x from everything else on the
     page. A terminal prints every line from column zero, so the window takes
     the width of the column like every other window on the site, and the
     commit messages keep their own measure inside it. */
  .tty-log {
    width: var(--w, fit-content);
    max-width: 100%;
    margin-inline: 0;
  }

  /* The lede is the page's one paragraph of prose, and it was set to the
     site's default measure — sixty characters — under a heading thirteen
     hundred pixels wide. It runs wider here, so the argument at the top of
     the page holds the same ground as the log under it. */
  .hero .lede {
    max-width: 76ch;
  }

  /* ----- One stop ----------------------------------------------------------
     A stop in the log, as a record: six fields, one per line. The rest of the
     entry opens in the panel's dialog.
     ---------------------------------------------------------------------- */
  .exp-row {
    padding-block: 0.7rem;
    border-top: var(--filet) solid color-mix(in srgb, var(--grid) 60%, transparent);
    cursor: pointer;
  }

  .exp-row:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .exp-field {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--fort);
  }

  .exp-key {
    color: var(--faible);
  }

  /* The company is the one value that is a name of a place, and sometimes a
     place a reader can go: NullRun is. */
  .exp-org {
    color: var(--braise);
  }

  .exp-org a {
    color: inherit;
    text-decoration: none;
    border-bottom: var(--filet) solid color-mix(in srgb, var(--braise) 50%, transparent);
  }

  .exp-org a:hover {
    color: var(--creme);
    border-bottom-color: var(--creme);
  }

  /* The role is the head of the record, so it is set larger than the fields
     around it. */
  .exp-role {
    display: flex;
    align-items: baseline;
    gap: 0 0.6ch;
    margin: 0.15rem 0 0;
    font-size: clamp(1.02rem, 2.1vw, 1.18rem);
    line-height: 1.25;
  }

  .exp-role .exp-key {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 400;
  }

  /* The role is a button, because the block opens a dialog and a dialog has
     to be reachable from the keyboard. It is drawn like the text it replaces:
     the same ink, and the accent when the pointer is on it. */
  .exp-open {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .exp-open:hover,
  .exp-open:focus-visible {
    color: var(--braise);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  <!--
    The tree itself is styled in `src/styles/skills.css`, with the rest of
    the toolkit. It used to be styled here, in two rules that only worked
    around the pyramid the section had been before: the trays were centred
    and tapered, so each tree had to be pushed back to the left by hand.
    The tree is not a pyramid — it is five labelled trays with the leaves
    hanging under them — and its appearance belongs in one place with the
    rest of the toolkit's, not in the page that shows it.
  -->
</style>
