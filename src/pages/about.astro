---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { yearsOfExperience } from '../lib/profile';

/**
 * How many notes there are. Counted, never typed: a number written into a
 * sentence cannot be checked by a build, and the writing index is the thing
 * this line points at.
 */
const postCount = (await getCollection('posts')).length;

/*
  The Profile page answers "who is this and what are they like to work with",
  not "what have they shipped" — the projects and the career have pages of
  their own. So what is left below is method and what is on the desk right
  now, kept deliberately short: the page is a portrait, not a CV.
*/

// How the work actually runs. Reuses the scroll-assembled rail the page
// already had: each panel slides in from its own side as it is reached, and
// the rail between them fills.
const METHOD = [
  {
    n: '01',
    title: 'Start with the failure',
    lead: 'Understand what breaks before deciding what to build.',
    body: 'Every engagement starts with the actual problem: a failed workflow, an unreliable agent, or an automation that cannot be trusted in production. The goal is not to add AI to a process. It is to identify the failure, understand its cause, and build the right solution.',
    marks: ['failure', 'cause', 'scope'],
  },
  {
    n: '02',
    title: 'Narrow beats clever',
    lead: 'One responsibility. Explicit tools. Defined boundaries.',
    body: 'An agent that does everything is difficult to reason about, test, and control. I design systems around clear responsibilities, minimal tool access, and explicit execution boundaries. When something fails, the cause should be traceable, the fix should be contained, and the rest of the system should keep working.',
    marks: ['one responsibility', 'explicit tools', 'boundaries'],
  },
  {
    n: '03',
    title: 'Bound everything',
    lead: 'Autonomy with explicit limits.',
    body: 'Every agent operates within defined budgets, timeouts, iteration caps, and tool permissions. Sensitive actions require approval. Every execution leaves a trace. Routine work runs autonomously; consequential actions stay behind explicit control gates. Autonomy should expand only as far as the system can reliably support it.',
    marks: ['budgets', 'timeouts', 'approval'],
  },
  {
    n: '04',
    title: 'Measure what matters',
    lead: 'If you cannot evaluate it, you cannot trust it in production.',
    body: 'Every run should produce evidence: traces, outcomes, failures, and measurable quality signals. Evaluations become regression tests that catch degradation before deployment, not reports that nobody reads. AI-generated output is not finished when it looks correct. It is finished when it has been tested, its failure modes are understood, and someone takes responsibility for what ships.',
    marks: ['traces', 'evals', 'regression'],
  },
];

// Right now. Three questions, answered plainly.
//
// The third answer used to be the five service names, verbatim, from the
// engagements page. The same list twice on one site is two places to update
// and one place to read, so this one points at the page that holds it.
//
// The writing answer used to be two items — "agents" and "authorization, and
// the systems underneath them" — which is one phrase split in half and
// numbered as if it were two.
const NOW = [
  {
    k: 'founding',
    lines: [
      { text: 'NullRun — runtime authorization for agents', href: 'https://nullrun.io' },
      { text: 'Agentic Audit' },
    ],
  },
  {
    k: 'writing',
    lines: [{ text: 'Agents, authorization, and the systems underneath them' }],
  },
  {
    k: 'taking on',
    lines: [{ text: 'Five fixed-scope engagements, one at a time', href: '/freelance/' }],
  },
];
---

<Base
  title="Profile"
  description="How I work, what I care about, and what is on the desk right now."
  rail
>
  <section class="hero hero-scroll about-hero">
    <div class="about-head">
      <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Anatolii Maltsev</span>
      <h1 data-reveal data-reveal-delay="60" data-anim="type">{yearsOfExperience()} years building systems that do real work</h1>
    </div>

    <div class="about-lead">
      <p class="lede" data-reveal data-reveal-delay="120">
        My focus is what happens beyond the happy path.
      </p>
      <ul class="about-points" data-reveal data-reveal-delay="150">
        <li>Failures — whether they are detected, traced, and understood.</li>
        <li>Permissions — what an agent is allowed to access and execute.</li>
        <li>Recovery — how a system handles failure and resumes safely.</li>
        <li>Boundaries — what keeps autonomous execution under control.</li>
      </ul>
    </div>

    <!--
      One image per theme, swapped in CSS rather than JS: the background-image
      rule that matches the active theme is the only one that applies, so the
      browser fetches exactly one file and the switcher changes the picture
      with no reflow and no flash. role="img" with a label carries the meaning,
      since a background image has no alt of its own.
    -->
    <figure class="portrait" data-reveal data-reveal-delay="140">
      <div
        class="portrait-art"
        role="img"
        aria-label="Dithered pixel portrait of me at a desk with a cat, a CRT showing the current theme's palette, and a browser window running a test matrix."
      ></div>
      <figcaption>
        <span class="portrait-kicker">
          chaotic engineer · plant lover · cat person · cyclist · photographer ·
          political exile · solo founder
        </span>
      </figcaption>
    </figure>

    <!--
      The habits underneath the focus used to live here, as a band of four
      under the picture: test-driven development, systematic over ad-hoc,
      complexity reduction, evidence over claims. Each of them is already
      inside one of the four rules further down the page — "evidence over
      claims" is "measure what matters", "systematic over ad-hoc" is "start
      with the failure" — so the band was two lists of four saying the same
      thing twice, one screen apart. The rules below are the longer version;
      this page does not need the short one as well.
    -->

    <p class="about-conclusion" data-reveal data-reveal-delay="180">
      If a system can take action, its actions must be traceable, its failures
      diagnosable, and its execution controllable.
    </p>
  </section>

  <!-- ---- How the work runs ---- -->
  <section class="section" id="method">
    <div class="sticky-head about-sticky">
      <span class="about-sticky-kicker">Method · four rules</span>
      <h2 data-anim="underline">How I work</h2>
    </div>

    <div class="assemble" data-assemble>
      <div class="assemble-rail" aria-hidden="true"><i data-rail-fill></i></div>

      {
        METHOD.map((s) => (
          <article class="stage" data-stage>
            <div class="stage-num">{s.n}</div>
            <div class="stage-main">
              <div class="stage-claim">
                <h3 class="stage-title">{s.title}</h3>
                <p class="stage-lead">{s.lead}</p>
                <ul class="stage-marks">
                  {s.marks.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </div>
              <div class="stage-detail">
                <p class="stage-body">{s.body}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!--
    Right now. Three answers side by side.
  -->
  <section class="section about-now">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">Right now</h2>
      <span class="card-meta">three answers</span>
    </div>

    <div class="now-grid" data-reveal>
      {
        NOW.map((n) => (
          <div class="now-card">
            <span class="now-k">{n.k}</span>
            <ul class="now-lines">
              {n.lines.map((l) => (
                <li>
                  {l.href ? (
                    <a class="now-link" href={l.href}>
                      {l.text}
                      {/* The non-breaking space below binds the arrow to the
                          last word: on a narrow card it used to fall onto a
                          line of its own. */}
                      {'\u00A0'}
                      <span class="now-go" aria-hidden="true">
                        →
                      </span>
                    </a>
                  ) : (
                    l.text
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="now-close" data-reveal>
      The same questions, answered at length: {postCount} notes so far.
      <a class="now-link" href="/blog/">
        Start with the newest{'\u00A0'}
        <span class="now-go" aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</Base>

<style>
  /* Everything here is scoped to this page, so it lives with the page rather
     than in os.css. The tokens are the site's; only the arrangement is new. */

  /* ----- Hero: copy beside the portrait --------------------------------- */
  /* Three rows. The headline spans the full width so it can be set as one
     line — in a 1fr column it would wrap into a ragged stack no matter what
     size it is given. Below the headline the bullets take a narrow column and
     the picture takes the rest; the closing line runs across the full width
     underneath.

     The `hero` class is also a rail panel, and the rail rule
     (`[data-rail='on'] > .hero`) turns it into a flex column. Both selectors
     have the same specificity, so the page has to name itself twice to be
     heard: without `.hero` in front, the rail wins and the grid never
     happens. */
  .hero.about-hero {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2.2rem);
    align-items: center;
    /* The rail gives the hero a screen-height panel and centers its content.
       `safe` keeps that centering without letting a hero taller than the
       panel push its own headline off the top of the screen. */
    align-content: safe center;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr);
  }

  .about-head {
    grid-column: 1 / -1;
    grid-row: 1;
    /* Sized against its own container, not the viewport. The cap is set by
       the narrowest desktop content width (~1340px), where 2.9rem leaves the
       line about 8% of headroom even at a pessimistic 0.5em per glyph; below
       that the cqw term keeps the same margin, and the floor takes over on a
       phone, where wrapping is the right answer anyway.

       The container is safe here only because the hero is a grid: the item
       stretches to the row, so the inline size the query reads is the full
       width. As a flex item it sized itself from its content — and content
       that cannot be measured is zero — which is what collapsed the headline
       into a one-letter column. */
    container-type: inline-size;
  }

  .about-head h1 {
    font-size: clamp(1.5rem, 3.8cqw, 2.9rem);
  }

  /* The subtitle is the accent color, so the headline reads as the headline
     and this reads as commentary under it. */
  .about-lead {
    grid-column: 1;
    grid-row: 2;
  }

  .about-lead .lede {
    color: var(--encre);
  }

  .about-points {
    display: grid;
    gap: 0.4rem;
    margin: 0.2rem 0 1rem;
    padding: 0;
    list-style: none;
  }

  .about-points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    color: var(--fort);
  }

  .about-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: var(--trait);
    background: var(--braise);
  }

  .portrait {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    border: var(--trait) solid var(--braise);
    box-shadow: var(--ombre);
    background: var(--papier);
  }

  /* The artwork itself. One rule per theme, so only the matching file is
     ever fetched — see the note in the markup. */
  .portrait-art {
    aspect-ratio: 1400 / 671;
    background-size: cover;
    background-position: center;
    /* Dithered art at 1:1 on a hidpi screen is soft; a touch of contrast
       keeps the dot pattern from washing out against the panel. */
    filter: contrast(1.04);
    image-rendering: auto;
  }

  :root[data-theme='phosphore'] .portrait-art {
    background-image: url('/images/profile/desk-phosphore.webp');
  }

  :root[data-theme='acidule'] .portrait-art {
    background-image: url('/images/profile/desk-acidule.webp');
  }

  :root[data-theme='pierre'] .portrait-art {
    background-image: url('/images/profile/desk-pierre.webp');
  }

  .portrait figcaption {
    padding: 0.7rem 0.9rem;
    border-top: var(--filet) solid var(--braise);
    background: var(--papier);
  }

  /* ---- The closing line -------------------------------------------------- */
  /* The sentence the page argues for, so it gets the size: it is set larger
     than the commentary around it and given its own rule. */
  .about-conclusion {
    grid-column: 1 / -1;
    grid-row: 3;
    margin: 0;
    max-width: 52ch;
    padding-top: clamp(0.9rem, 2.2vw, 1.4rem);
    border-top: var(--filet) solid var(--grid);
    font-size: clamp(1.1rem, 2.1vw, 1.45rem);
    line-height: 1.45;
    color: var(--encre);
    text-wrap: balance;
  }

  /* ---- The four rules ----------------------------------------------------
     The claim on the left, the argument on the right. The paragraph used to
     sit in a 42rem column inside a panel a third wider, so half of every
     rule was empty page, and the four rules read as a narrow list down the
     middle of the screen. The keywords move up to the claim: they are its
     summary, and the paragraph is what they summarise.
     ---------------------------------------------------------------------- */
  .stage-main {
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 60rem) {
    .stage-main {
      grid-template-columns: minmax(0, 25rem) minmax(0, 1fr);
      column-gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
  }

  .stage-detail {
    min-width: 0;
  }

  /* The keywords sit under the claim now, so they need air above them; the
     paragraph is the last thing in its column, so it needs none below. */
  .stage-claim .stage-marks {
    margin-top: var(--sp-3);
  }

  .stage-detail .stage-body {
    margin-bottom: 0;
  }

  /* A list of selves, not a caption: monospaced but not shouted, and left in
     sentence case so the dots do the separating instead of the capitals. */
  .portrait-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    color: var(--fort);
    text-wrap: balance;
  }

  /* ---- The sticky marker over the assemble block ------------------------ */
  /* It sticks, so it has to earn it. A bare heading on an opaque slab reads
     as a leftover — it chops the panels off with a hard edge every time one
     slides underneath. A kicker gives it a job and a hairline gives it an
     edge to die out along.

     The background behind it is solid rather than a gradient. The gradient
     was there so the panels would fade under the heading instead of being
     cut by it, but a fade is only as good as the band it lives in: the band
     was about thirty pixels, which is one line of type, so a line caught in
     it came out half-visible — the tags of one rule and the last sentence
     of another, sitting side by side in the gap under the heading like a
     rendering fault. Solid paper plus the hairline cuts the panels at a
     line that was drawn to be there. */
  .about-sticky {
    display: grid;
    gap: 0.45rem;
    padding-block: 0.8rem 1.1rem;
    margin-bottom: 1.4rem;
    background: var(--papier);
  }

  .about-sticky-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--braise);
  }

  .about-sticky::after {
    content: '';
    height: var(--trait);
    background: linear-gradient(to right, var(--braise), transparent 78%);
  }

  /* ---- Right now ---------------------------------------------------------
     Three answers side by side, each under its own rule — the same shape as
     the "what this is not" block on the engagements page, because it is the
     same kind of statement.

     The band used to carry the desk artwork again, faded to a third and
     pushed behind the text. The same picture twice on one page, at an opacity
     low enough to read as a stain rather than as a picture, is noise: it took
     the right half of the section and gave the reader nothing to look at.
     The picture is in the hero, where it is the subject.
     ---------------------------------------------------------------------- */
  .now-grid {
    display: grid;
    gap: 1.6rem clamp(1.4rem, 3vw, 2.6rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .now-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .now-card {
    border-top: var(--trait) solid var(--braise);
    padding-top: 0.7rem;
  }

  .now-k {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--braise);
  }

  .now-lines {
    display: grid;
    gap: 0.4rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--fort);
  }

  /* The two answers that are doors. Drawn like links because they are.

     The underline is a text-decoration rather than a border, because the
     longest of these answers — "NullRun — runtime authorization for agents"
     — is 348px wide: on a border with `white-space: nowrap` it could not
     shrink, so between 48rem and 54rem it ran out of its column and into
     the next one. A decoration wraps with the text and breaks with it. */
  .now-link {
    color: var(--braise);
    text-decoration: underline;
    text-decoration-thickness: var(--filet);
    text-decoration-color: var(--braise);
    text-underline-offset: 0.22em;
  }

  .now-link:hover {
    color: var(--fort);
    text-decoration-color: var(--fort);
  }

  .now-go {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform 180ms ease;
  }

  .now-link:hover .now-go {
    transform: translateX(3px);
  }

  /* The way out of the page. It closes the band the way the closing blocks
     on the posts and the cases close their pages. */
  .now-close {
    margin: 2.2rem 0 0;
    padding-top: 1rem;
    border-top: var(--filet) solid var(--grid);
    max-width: 52ch;
    color: var(--fort);
  }

  /* The rail gives every section a screen of its own. This one holds three
     answers: a screen's worth of panel around two hundred pixels of type
     read as an empty screen rather than as a closing band, so it hugs what
     it has. */
  .section.about-now {
    min-height: 0;
  }

  /* ----- Narrower screens ------------------------------------------------ */
  @media (max-width: 56rem) {
    .hero.about-hero {
      grid-template-columns: 1fr;
    }

    /* One column: the explicit rows would put the copy and the picture in
       the same row, so the placement is handed back to the flow. */
    .about-head,
    .about-lead,
    .portrait,
    .about-conclusion {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    /* Stacked, the picture leads — but the headline still has to come first,
       so it is ordered ahead of it explicitly. */
    .about-head {
      order: -2;
    }

    .portrait {
      order: -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-go {
      transition: none;
    }
  }
</style>
