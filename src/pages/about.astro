---
import Base from '../layouts/Base.astro';
import { yearsOfExperience } from '../lib/profile';

/*
  The Profile page answers "who is this and what are they like to work with",
  not "what have they shipped" — the projects and the career have pages of
  their own. So what is left below is how the work runs, on what terms, and
  what is on the desk right now, kept deliberately short: the page is a
  portrait, not a CV.
*/

/**
 * How the work actually runs, and on what terms.
 *
 * Four entries, each a label and the sentence under it: how the work is
 * done, where from, on what terms, and what else is possible.
 *
 * They used to be four rules — "start with the failure", "narrow beats
 * clever" — each with its keywords underneath, which is the method said
 * as slogans. The section is about how the work runs and who it runs for,
 * so it carries the terms instead.
 */
const WORK = [
  {
    k: 'Work Style',
    v: 'Async-first mindset with a focus on clear written communication and structured documentation (Notion, Jira, Slack). Experienced in Agile/Scrum workflows, taking full ownership of tasks from discovery to delivery.',
  },
  {
    k: 'Location & Timezone',
    v: 'Currently based in Tbilisi, Georgia (GMT+4). Flexible schedule allowing 4–6 hours of daily overlap with European (CET/GMT) and US East Coast (EST) teams.',
  },
  {
    k: 'Contract & Setup',
    v: 'Ready for immediate B2B engagement via an active Armenian Sole Proprietorship (IE) with smooth international invoicing (SWIFT, Wise, Payoneer, Deel).',
  },
  {
    k: 'Relocation',
    v: 'Open to relocation and visa sponsorship; hold a valid passport and ready for business travel or team offsites.',
  },
];

/**
 * Right now. Three questions, answered plainly.
 *
 * The writing answer used to be two items — "agents" and "authorization, and
 * the systems underneath them" — which is one phrase split in half and
 * numbered as if it were two.
 */
const NOW = [
  {
    k: 'founding',
    lines: [
      { text: 'NullRun: runtime authorization for agents', href: 'https://nullrun.io' },
      { text: 'Agentic Audit' },
    ],
  },
  {
    k: 'advisory & work',
    lines: [
      {
        text: 'Consulting on agentic systems, runtime security, and auth. Open to full-time roles and new opportunities.',
      },
    ],
  },
  {
    k: 'writing',
    lines: [{ text: 'Agents, authorization, and the systems underneath them' }],
  },
];
---

<Base
  title="Profile"
  description="How I work, where I am, and what is on the desk right now."
>
  <!--
    The page is a person, read the way a machine reads one: a file of notes,
    printed out. The hero is the file itself; the two windows below it are
    the other two files — how the work runs, and what is on the desk right
    now.

    The width is set once, on the wrapper below, so the two windows share a
    left edge and a right edge instead of each taking the width of what is
    inside it.
  -->
  <div class="about-page">
    <section class="hero hero-scroll about-hero">
      <div class="about-head">
        <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Anatolii Maltsev</span>
        <h1 data-reveal data-reveal-delay="60" data-anim="type">{yearsOfExperience()} years building systems that do real work</h1>
      </div>

      <div class="about-lead">
        <p class="tty-prompt" data-reveal data-reveal-delay="100">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/about</span><span class="sep"
            >$</span
          >
          <span class="tty-cmd">cat about.md</span>
        </p>

      </div>

      <!--
        One image per theme, swapped in CSS rather than JS: the background-image
        rule that matches the active theme is the only one that applies, so the
        browser fetches exactly one file and the switcher changes the picture
        with no reflow and no flash. role="img" with a label carries the meaning,
        since a background image has no alt of its own.
      -->
      <figure class="portrait" data-reveal data-reveal-delay="140">
        <div
          class="portrait-art"
          role="img"
          aria-label="Dithered pixel portrait of me at a desk with a cat, a CRT showing the current theme's palette, and a browser window running a test matrix."
        ></div>
        <figcaption>
          <span class="portrait-kicker">
            chaotic engineer · plant lover · cat person · cyclist · photographer ·
            political exile · solo founder
          </span>
        </figcaption>
      </figure>

    </section>

    <!-- ---- How the work runs ---- -->
    <section class="section">
      <div class="tty-fit">
        <div class="section-head">
          <h2 data-reveal data-anim="underline">How I work</h2>
        </div>

        <div class="tty tty-method" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-off"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/about/work.md</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span>
            ><span class="sep">:</span><span class="path">~/about</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">cat work.md</span>
          </p>

          <!--
            One block per term. The four entries used to be four rows of a
            two-column table, and four rows of hairlines read as one long
            list: the reader had to work out where one entry stopped and the
            next began. A block says where it ends by itself.
          -->
          <div class="work-grid">
            {
              WORK.map((w, i) => (
                <article
                  class="work-block"
                  data-reveal
                  data-reveal-delay={Math.min(i, 3) * 60}
                >
                  <h3 class="work-k">
                    <span class="work-k-label">{w.k}</span>
                    <span class="work-n" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                  </h3>
                  <p class="work-v">{w.v}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
      </div>
    </section>

    <!--
      Right now. Three answers, side by side.
    -->
    <section class="section about-now">
      <div class="tty-fit">
        <div class="section-head">
          <h2 data-reveal data-anim="underline">Right now</h2>
        </div>

        <div class="tty tty-now" data-reveal>
        <div class="tty-bar">
          <span class="tty-leds" aria-hidden="true">
            <i class="led led-on"></i>
            <i class="led led-on"></i>
            <i class="led led-off"></i>
          </span>
          <span class="tty-title">~/about/now.md</span>
        </div>

        <div class="tty-body">
          <p class="tty-prompt tty-cmd-line">
            <span class="who">root</span><span class="sep">@</span><span
              >amaltsev</span>
            ><span class="sep">:</span><span class="path">~/about</span><span class="sep"
              >$</span
            >
            <span class="tty-cmd">cat now.md</span>
          </p>

          <div class="ls ls-now">
            {
              NOW.map((n) => (
                <div class="ls-row">
                  <span class="ls-now-k">{n.k}</span>
                  <span class="ls-now-v">
                    <ul class="now-lines">
                      {n.lines.map((l) => (
                        <li>
                          {l.href ? (
                            <a class="now-link" href={l.href}>
                              {l.text}
                              {/* The non-breaking space below binds the arrow to
                                  the last word: on a narrow screen it used to
                                  fall onto a line of its own. */}
                              {' '}
                              <span class="now-go" aria-hidden="true">
                                →
                              </span>
                            </a>
                          ) : (
                            l.text
                          )}
                        </li>
                      ))}
                    </ul>
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Everything here is scoped to this page, so it lives with the page rather
     than in os.css. The tokens are the site's; only the arrangement is new. */

  /* ----- One column --------------------------------------------------------
     The width of every window on the page, set once. Without it each window
     took the width of what was inside it, so the two windows below started
     and ended in different places. The width is the column's: the hero above
     is the column's width too, and a page whose windows stop in the middle
     of it reads as two pages.
     ---------------------------------------------------------------------- */
  .about-page {
    --w: 100%;
  }

  /* ----- Hero: the picture, centred -------------------------------------- */
  /* Three rows in one column. The headline spans the full width so it can be
     set as one line — in a 1fr column it would wrap into a ragged stack no
     matter what size it is given. Under it the command line, and under that
     the picture on its own, centred and as large as the column allows.

     The `hero` class is also a rail panel, and the rail rule
     (`[data-rail='on'] > .hero`) turns it into a flex column. Both selectors
     have the same specificity, so the page has to name itself twice to be
     heard: without `.hero` in front, the rail wins and the grid never
     happens. */
  .hero.about-hero {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2.2rem);
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }

  .about-head {
    grid-column: 1 / -1;
    grid-row: 1;
    /* Sized against its own container, not the viewport. The cap is set by
       the narrowest desktop content width (~1340px), where 2.9rem leaves the
       line about 8% of headroom even at a pessimistic 0.5em per glyph; below
       that the cqw term keeps the same margin, and the floor takes over on a
       phone, where wrapping is the right answer anyway.

       The container is safe here only because the hero is a grid: the item
       stretches to the row, so the inline size the query reads is the full
       width. As a flex item it sized itself from its content — and content
       that cannot be measured is zero — which is what collapsed the headline
       into a one-letter column. */
    container-type: inline-size;
  }

  .about-head h1 {
    font-size: clamp(1.5rem, 3.8cqw, 2.9rem);
  }

  /* The command line that opens the file. It sits between the headline and
     the picture, so it reads as the line that produced what is below it. */
  .about-lead {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
  }

  .about-lead .tty-prompt {
    margin-block: 0 0.9rem;
  }

  /* The picture is the subject of the page, so it takes the room: it spans
     the column and is capped a little short of it, so it sits in the middle
     of the page rather than bleeding off both edges. */
  .portrait {
    grid-column: 1 / -1;
    grid-row: 3;
    justify-self: center;
    width: min(100%, 1180px);
    margin: 0;
    border: var(--trait) solid var(--braise);
    box-shadow: var(--ombre);
    background: var(--papier);
  }

  /* The artwork itself. One rule per theme, so only the matching file is
     ever fetched — see the note in the markup. */
  .portrait-art {
    aspect-ratio: 1400 / 671;
    background-size: cover;
    background-position: center;
    /* Dithered art at 1:1 on a hidpi screen is soft; a touch of contrast
       keeps the dot pattern from washing out against the panel. */
    filter: contrast(1.04);
    image-rendering: auto;
  }

  :root[data-theme='phosphore'] .portrait-art {
    background-image: url('/images/profile/desk-phosphore.webp');
  }

  :root[data-theme='acidule'] .portrait-art {
    background-image: url('/images/profile/desk-acidule.webp');
  }

  :root[data-theme='pierre'] .portrait-art {
    background-image: url('/images/profile/desk-pierre.webp');
  }

  .portrait figcaption {
    padding: 0.7rem 0.9rem;
    border-top: var(--filet) solid var(--braise);
    background: var(--papier);
    text-align: center;
  }

  /* ----- How the work runs ------------------------------------------------
     Four blocks, one for each term.

     The section used to be a table without a table: the label in one column,
     the sentence in the next, and a hairline between the rows. Four rows of
     hairlines read as one long list — the reader had to work out where one
     entry stopped and the next began. A block answers that on its own: the
     border says "this is one thing", and the label sits on its own line above
     the sentence, so the four terms can be taken in at a glance.

     Two columns on a desktop, one on a phone. The sentences are a hundred
     and eighty characters each, and a card narrow enough to hold four of
     them across a monitor breaks them into six lines apiece.
     ---------------------------------------------------------------------- */
  .tty-method .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  /* The panel is one step up from the window it sits in — --rouille against
     the --papier of the frame — so the block is a panel rather than a hole
     cut in the paper. The rule is the window's own, in the window's own
     colour: the block belongs to this terminal, not to another one. */
  .work-block {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem 1rem;
    border: var(--filet) solid var(--grid);
    background: var(--rouille);
  }

  /* The label is a label: the terminal's small caps, with the number of the
     block at the far end of the row, so the four can be counted as well as
     read. */
  .work-k {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    margin: 0 0 0.55rem;
    padding-bottom: 0.45rem;
    border-bottom: var(--filet) solid
      color-mix(in srgb, var(--grid) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--braise);
    text-shadow: none;
  }

  .work-n {
    color: var(--faible);
    font-weight: 400;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .work-v {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--fort);
  }

  /* ---- Right now ---------------------------------------------------------
     Three answers, each under its own rule.

     The band used to carry the desk artwork again, faded to a third and
     pushed behind the text. The same picture twice on one page, at an opacity
     low enough to read as a stain rather than as a picture, is noise: it took
     the right half of the section and gave the reader nothing to look at.
     The picture is in the hero, where it is the subject.
     ---------------------------------------------------------------------- */
  .tty-now .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  /* One grid for the three answers, so every label sits in the same column:
     the rows are `display: contents`, which lets their two cells become
     items of the grid above them. A grid per row would size its label
     column to that row's own label — and "advisory & work" is wider than
     the other two, so the answers would start at three different places. */
  .ls-now {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1.5ch;
    align-items: baseline;
  }

  .ls-now .ls-row {
    display: contents;
  }

  .ls-now-k {
    color: var(--braise);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .ls-now-v {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--fort);
  }

  .now-lines {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The two answers that are doors. Drawn like links because they are.

     The underline is a text-decoration rather than a border, because the
     longest of these answers — "NullRun — runtime authorization for agents"
     — is 348px wide: on a border with `white-space: nowrap` it could not
     shrink, so between 48rem and 54rem it ran out of its column and into
     the next one. A decoration wraps with the text and breaks with it. */
  .now-link {
    color: var(--braise);
    text-decoration: underline;
    text-decoration-thickness: var(--filet);
    text-decoration-color: var(--braise);
    text-underline-offset: 0.22em;
  }

  .now-link:hover {
    color: var(--fort);
    text-decoration-color: var(--fort);
  }

  .now-go {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform 180ms ease;
  }

  .now-link:hover .now-go {
    transform: translateX(3px);
  }

  /* ----- Narrower screens ------------------------------------------------ */
  @media (max-width: 56rem) {
    .hero.about-hero {
      grid-template-columns: 1fr;
    }

    /* One column: the explicit rows would put the picture and the copy in
       the same row, so the placement is handed back to the flow. */
    .about-head,
    .about-lead,
    .portrait {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    /* The headline first, then the command line, then the picture — the
       order they are in in the markup. */
    .about-head {
      order: -3;
    }

    .about-lead {
      order: -2;
    }

    .portrait {
      order: -1;
    }

    /* The blocks fold to one column: the label and the sentence under it
       are a card, and a card that is half the width of a phone holds one
       word per line. */
    .work-grid {
      grid-template-columns: 1fr;
    }

    .ls-now {
      grid-template-columns: 1fr;
      row-gap: 0.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-go {
      transition: none;
    }
  }
</style>
