---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AiStack from '../components/AiStack.astro';
import Terminal from '../components/Terminal.astro';
import Banner from '../components/Banner.astro';
import Portrait from '../components/Portrait.astro';
import { describe, readingTime, MAX_DESCRIPTION } from '../lib/summarize';
import { AUTHOR } from '../lib/schema';
import { tagSlug, tagLabel } from '../lib/tags';
import { formatDateShort } from '../data/dates';
import { MILESTONES } from '../data/milestones';
import { SKILL_COUNT, yearsOfExperience } from '../lib/profile';
import { TOPICS, topicFor } from '../data/topics';
import { displayTitle } from '../lib/text';

const posts = (await getCollection('posts')).sort((a, b) =>
  (b.data.date ?? '').localeCompare(a.data.date ?? '')
);
const recent = posts.slice(0, 6);
const cases = await getCollection('projects');

/**
 * The four numbers at the top of the page.
 *
 * Every one of them is counted, never typed. A number written into a
 * sentence cannot be checked by a build, so it goes stale the next time a
 * post lands or a skill is added — and a portfolio whose own numbers are
 * wrong is arguing against itself. These read from the same collections the
 * rest of the site reads from.
 */
const STATS = [
  { label: 'Years of practice', value: yearsOfExperience() },
  { label: 'Skills in the toolkit', value: SKILL_COUNT },
  { label: 'Systems shipped', value: MILESTONES.length + cases.length },
  { label: 'Notes written', value: posts.length },
];

/**
 * What the work is, in three parts.
 *
 * The three lines are the lede's three clauses, and each one is a door
 * rather than a promise: the number and the destination are both real, so
 * the claim can be checked by following it. The third one is the least
 * glamorous and the most load-bearing — the layer under the two above it is
 * where an agent either survives production or does not.
 */
const topicSize = (id: string): number =>
  TOPICS.find((t) => t.id === id)?.posts.length ?? 0;

const reliabilityNotes = posts.filter((post) =>
  post.data.tags.includes('reliability')
).length;

const PILLARS = [
  {
    num: '01',
    title: 'Agent runtime security',
    body: 'Authority, not prompting. Whether an agent may call a tool or spend a budget is a runtime decision: scoped grants, enforced budgets, durable approvals, and a record of every call.',
    href: '/blog/?topic=agent-runtime',
    proof: `${topicSize('agent-runtime')} notes on the seam between a model and its tools`,
  },
  {
    num: '02',
    title: 'Retrieval that cites',
    body: 'An answer that cannot name its passage is a guess with a bibliography. Grounded retrieval, permission-aware filtering, reranking, and a refusal when the evidence is not there.',
    href: '/projects/',
    proof: 'Case studies, including permission-aware internal search',
  },
  {
    num: '03',
    title: 'The reliability layer',
    body: 'Traces, budgets, retries, and the failure states nobody designs on purpose: what an agent does when the run goes wrong, what it costs, and how anyone finds out.',
    href: '/blog/?tag=reliability',
    proof: `${reliabilityNotes} notes on what happens when the run goes wrong`,
  },
];

// The same line the post index uses: the post's own description when it has
// one, the first real sentence of the body when it does not.
const recentPosts = recent.map((post) => ({
  href: `/blog/${post.id}/`,
  title: displayTitle(post.data.title),
  date: formatDateShort(post.data.date),
  iso: post.data.date ?? '',
  minutes: readingTime(post.body),
  summary: describe(post.data.title, post.body, post.data.description, MAX_DESCRIPTION),
  tags: post.data.tags,
  topic: topicFor(post.id),
}));

const work = cases.map((project) => ({
  href: `/projects/${project.data.slug}/`,
  title: project.data.title,
  description: project.data.description ?? '',
  tags: project.data.tags,
}));
---

<Base
  title="Forward Deployed Engineer"
  description="I build AI systems that survive production: agent runtime security, retrieval quality, and the reliability layer underneath both."
>
  <!--
    The head of the page is the boot: the wordmark drawn in block characters,
    the prompt that says who is typing and where, and the claim in plain
    words underneath. A terminal shows the machine before it shows the work,
    and so does this.
  -->
  <section class="hero home-hero">
    <Banner />

    <p class="tty-prompt home-prompt" data-reveal>
      <span class="who">root</span><span class="sep">@</span><span
        >amaltsev</span>
      ><span class="sep">:</span><span class="path">~</span><span class="sep">$</span>
      <span class="tty-cmd">cat about.md</span>
    </p>

    <h1 data-reveal data-reveal-delay="60">
      I build AI systems that survive production.
    </h1>

    <p class="lede" data-reveal data-reveal-delay="120">
      Agent runtime security, retrieval quality, and the reliability layer
      underneath both, for teams that need it to work.
    </p>

    <div class="btn-row home-cta" data-reveal data-reveal-delay="180">
      <button type="button" class="btn btn-primary" data-open-letter>Work with me</button>
      <a class="btn" href="/projects/">See what shipped</a>
    </div>

    <!--
      The four numbers, each one a cell: the value on top, in the accent and
      as large as the page allows, and the name of the thing underneath it.

      They used to be a table of contents with a dotted leader between the
      label and the value, which is a way of saying "there is a number over
      there" and asking the reader to go and look. A portfolio whose numbers
      are its argument should not have to be hunted for.
    -->
    <dl class="home-stats" data-reveal data-reveal-delay="240">
      {
        STATS.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd class="stat-value">{stat.value}</dd>
          </div>
        ))
      }
    </dl>

    <!--
      The portrait, in the corner of the machine.

      It is drawn in the same block characters as the wordmark above it, on
      the same grid, and it is a window of the same kind as every other
      window on the site — so it reads as something the machine is doing
      rather than as a picture that was pasted in. The photograph itself
      never ships: it is turned into tones at build time, and the page
      carries the tones.
    -->
    <Portrait />
  </section>

  <!--
    The working shell. It is the site's own data behind a prompt, so the
    fastest way to see what is in here is to type at it: `ls`, `skills`,
    `projects`, `neofetch`.
  -->
  <section class="section home-shell">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">The shell</h2>
      <span class="card-meta">type help, it is a real one</span>
    </div>

    <div data-reveal>
      <Terminal />
    </div>
  </section>

  <!--
    What the work is, in three parts. Each card is a door: a claim, the number
    behind it, and a link to the writing or the work that backs it up.
  -->
  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">What I do</h2>
      <span class="card-meta">three things, in order of how often they come up</span>
    </div>

    <div class="pillars">
      {
        PILLARS.map((pillar, i) => (
          <article class="pillar" data-reveal data-reveal-delay={i * 70}>
            <span class="pillar-num" aria-hidden="true">
              {pillar.num}
            </span>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-body">{pillar.body}</p>
            <a class="pillar-link" href={pillar.href}>
              {pillar.proof}
              <span class="pillar-go" aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- The three deep-dive case studies, as a directory listing. -->
  <section class="section home-listing">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">Selected work</h2>
      <a class="card-meta" href="/projects/">All work →</a>
    </div>

    <div class="tty tty-listing" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">/projects</span>
        <span class="tty-right" aria-hidden="true">{work.length} entries</span>
      </div>

      <div class="tty-body">
        <div class="ls">
          <div class="ls-row ls-head">
            <span class="ls-mode">mode</span>
            <span class="ls-size">size</span>
            <span class="ls-date">kind</span>
            <span class="ls-name">name</span>
          </div>
          {
            work.map((w) => (
              <div class="ls-row">
                <span class="ls-mode">drwxr-xr-x</span>
                <span class="ls-size">{w.tags.length} tag</span>
                <span class="ls-date">case</span>
                <span class="ls-name">
                  <a href={w.href}>{w.title}</a>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!--
    The architecture. It used to sit in a column beside a list of links, where
    it was shrunk to fit next to a directory that said less. It gets the whole
    width here: ten stages, from the service skeleton to the edge runtime, and
    a stage can be clicked for the detail behind it.

    The drawing is the section. The claim that stood above it, and the table
    of contents that listed the ten stages as text, said the same thing the
    drawing already says — and the drawing says it in the one form a reader
    can act on, by clicking a stage and reading what is behind it.
  -->
  <section class="section">
    <div class="home-figure" data-reveal>
      <AiStack />
    </div>
  </section>

  <!--
    The newest writing, as a listing rather than as cards: a directory of
    files, newest first. The card row it replaced was three cards of prose
    for three notes, which is a lot of page to say "here are three things".
  -->
  <section class="section home-listing">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">Latest writing</h2>
      <a class="card-meta" href="/blog/">All writing →</a>
    </div>

    <div class="tty tty-listing" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/writing</span>
        <span class="tty-right" aria-hidden="true">{posts.length} notes</span>
      </div>

      <div class="tty-body">
        <div class="ls">
          <div class="ls-row ls-row--write ls-head">
            <span class="ls-mode">mode</span>
            <span class="ls-date">date</span>
            <span class="ls-size">min</span>
            <span class="ls-name">name</span>
          </div>
          {
            recentPosts.map((p) => (
              <div class="ls-row ls-row--write">
                <span class="ls-mode">-rw-r--r--</span>
                <span class="ls-date">{p.date}</span>
                <span class="ls-size">{p.minutes}</span>
                <span class="ls-name">
                  <a href={p.href}>{p.title}</a>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- The head of the page ---------------------------------------------
     The wordmark, the prompt, the claim, the buttons and the numbers. On a
     wide screen the wordmark and the prompt run down the left and the claim
     sits beside them; below the breakpoint everything stacks, because a
     lede beside a headline only works where there is width for both.

     The hero is a query container: the lede is one line, and a line that has
     to fit has to be able to ask how wide the column it is in is.
     ---------------------------------------------------------------------- */
  .home-hero {
    padding-block: clamp(1.6rem, 6vh, 3.4rem) clamp(1.5rem, 4vh, 3rem);
    container-type: inline-size;
  }

  .home-hero :global(.banner-wrap) {
    margin-bottom: clamp(0.9rem, 3vh, 1.6rem);
  }

  .home-prompt {
    margin: 0 0 1.1rem;
    font-size: var(--fs-small);
  }

  .home-prompt .path {
    color: var(--encre);
  }

  /*
    The lede. One line.

    It used to sit in the narrow column beside the shape and break after
    "layer" — a sentence that argues about reliability broken in half by the
    width of a column is a sentence that reads like a caption. It now runs the
    width of the hero and the type scales with it, so the line stays a line
    from a phone in landscape to a wide desktop, and wraps only where there
    is no other way to set it.
  */
  .home-hero .lede {
    max-width: none;
    font-size: clamp(0.8rem, calc((100cqw - 2rem) / 60), 1.1rem);
  }

  @media (min-width: 62rem) {
    .home-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      grid-template-areas:
        'banner  art'
        'prompt  art'
        'title   art'
        'cta     art'
        'lede    lede'
        'stats   stats';
      column-gap: clamp(2rem, 5vw, 4.5rem);
      row-gap: clamp(0.6rem, 1.6vw, 1.2rem);
      /*
        The top of the column, not the bottom.

        The picture in the corner is the tallest thing in the hero, so the
        rows it spans are taller than the text beside it. Aligned to the
        bottom, that difference fell between the wordmark, the prompt and
        the headline as a hundred pixels of empty paper each — the hero
        read as three separate blocks with holes in them. Aligned to the
        top, the wordmark starts on the same line as the window frame and
        the slack gathers below, where the eye reads it as the picture's
        own space.
      */
      align-items: start;
    }

    .home-hero :global(.banner-wrap) {
      grid-area: banner;
      /* The rows of the grid carry the space between the blocks; a margin
         under the wordmark as well would double it. */
      margin-bottom: 0;
    }

    .home-prompt {
      grid-area: prompt;
    }

    .home-hero h1 {
      grid-area: title;
      margin-bottom: 0;
    }

    .home-hero .lede {
      grid-area: lede;
      margin-bottom: 0;
    }

    .home-hero .home-cta {
      grid-area: cta;
      margin-block: 0;
      justify-content: flex-start;
    }

    .home-hero .home-stats {
      grid-area: stats;
    }

    /* The shape, in the corner of the machine. */
    .home-hero :global(.tty-ascii) {
      grid-area: art;
      align-self: start;
    }
  }

  .home-cta {
    margin-block: var(--sp-4) var(--sp-3);
  }

  /* ----- The four numbers --------------------------------------------------
     Four cells on one ground, separated by hairlines rather than by gaps:
     the number and the name of what it counts on one line, the number big
     enough to be read as the number and not as a footnote.

     Counted from the collections, so they cannot drift away from the pages
     they describe.
     ---------------------------------------------------------------------- */
  .home-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--braise);
    border: var(--trait) solid var(--braise);
    box-shadow: var(--ombre);
  }

  @media (min-width: 34rem) {
    .home-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .home-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0 1.1rem;
    padding: 0.8rem 1rem 0.9rem;
    background: var(--papier);
  }

  /* The name of the thing, on the same line as the number and right beside
     it. It used to sit under the number, and then at the far end of the
     cell, which left a hundred and thirty pixels of paper between the two
     words that belong to each other. A number and the name of what it
     counts belong together: the number is in a column of its own, so the
     four numbers line up on their right edge, and the name starts on the
     same line for all four. */
  .stat dt {
    grid-column: 2;
    grid-row: 1;
    justify-self: start;
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fort);
  }

  .stat dd {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--braise);
    text-shadow: var(--glow);
  }

  /* ----- What I do ---------------------------------------------------------
     Three panels on one ground, separated by hairlines rather than by gaps:
     they read as one set of three, not as three separate cards.
     ---------------------------------------------------------------------- */
  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--braise);
    border: var(--trait) solid var(--braise);
    box-shadow: var(--ombre);
  }

  @media (min-width: 48rem) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem 1.25rem 1.35rem;
    background: var(--papier);
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    color: var(--braise);
  }

  .pillar-title {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.2;
  }

  .pillar-body {
    margin: 0;
    color: var(--fort);
    font-size: var(--fs-lead);
  }

  .pillar-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: var(--filet) solid var(--grid);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--braise);
    text-decoration: none;
  }

  .pillar-link:hover {
    color: var(--fort);
  }

  .pillar-go {
    transition: transform 180ms ease;
  }

  .pillar-link:hover .pillar-go {
    transform: translateX(3px);
  }

  /* ----- The windows ------------------------------------------------------
     Every window on this page is eighty columns wide — the shell says so in
     its own title bar, and the two listings are the same machine seen from
     the other side — so every window is eighty columns wide, and every
     window sits in the middle of the column instead of stretching to both
     edges of it. A terminal stretched across a wide screen is a window with
     a third of a terminal in it and two thirds of nothing.

     The heading above a window is the same width as the window, so the two
     edges of the section are the same two lines.

     Eighty columns of the mono face at the small size is 672 pixels, and the
     window's frame and padding take another thirty-four: 706 pixels, or
     forty-four and an eighth of a rem.
     ---------------------------------------------------------------------- */
  .home-shell .section-head,
  .home-shell :global(.tty-term),
  .home-listing .section-head,
  .home-listing .tty-listing {
    max-width: 44.125rem;
    margin-inline: auto;
  }

  /* ----- The listings ------------------------------------------------------
     The window that holds a listing. The frame is the same one the shell
     uses, so the two read as the same machine.
     ---------------------------------------------------------------------- */
  .tty-listing .tty-body {
    padding-block: 1.7rem 1rem;
  }

  .tty-listing .ls-row {
    padding-block: 0.12rem;
  }

  /* ----- The architecture --------------------------------------------------
     The figure gets the whole width of the column, so the art is drawn at the
     size it was drawn to be read at rather than shrunk to fit beside a
     directory.
     ---------------------------------------------------------------------- */
  .home-figure {
    min-width: 0;
    /* The art below sizes itself from this column, so the query container has
       to be the figure, not the page. The name lets the figure's own children
       ask how wide the column is — the swipe hint uses it to appear only when
       the drawing is genuinely wider than the column it sits in. */
    container-type: inline-size;
    container-name: figure;
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-go {
      transition: none;
    }
  }
</style>
