---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AiStack from '../components/AiStack.astro';

const posts = (await getCollection('posts')).sort((a, b) =>
  (b.data.date ?? '').localeCompare(a.data.date ?? '')
);
const recent = posts.slice(0, 3);

// The homepage is a directory, not a summary: the figure shows what the work
// is, and the column beside it opens each part of the site.
const SECTIONS = [
  { n: '01', href: '/experience/', title: 'Experience' },
  { n: '02', href: '/freelance/', title: 'Work Now' },
  { n: '03', href: '/projects/', title: 'Projects' },
  { n: '04', href: '/about/', title: 'Profile' },
];

---

<Base>
  <section class="hero hero-scroll home-hero">
    <span class="eyebrow" data-reveal><span class="pulse-dot"></span>Anatoly Maltsev · applied AI</span>
    <h1 data-reveal data-reveal-delay="60" data-anim="type">Systems that carry real work.</h1>
    <p class="lede" data-reveal data-reveal-delay="120">
      AI automation, embedded Rust, and the reliability layer that keeps both
      honest when production pushes back.
    </p>
  </section>

  <!-- Figure on one side, directory on the other. -->
  <section class="section home-split">
    <div class="home-figure" data-reveal>
      <AiStack />
    </div>

    <nav class="home-dir" aria-label="Sections">
      {
        SECTIONS.map((s, i) => (
          <a class="dir-item" href={s.href} data-reveal data-reveal-delay={i * 70}>
            <span class="dir-num">{s.n}</span>
            <span class="dir-body">
              <strong>{s.title}</strong>
            </span>
            <span class="dir-go" aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>
  </section>
</Base>