---
import Base from '../layouts/Base.astro';

const num = (i: number) => String(i + 1).padStart(2, '0');

/**
 * The five engagements.
 *
 * Each one is a shape of work rather than a product: the symptom that brings
 * someone here, the thing they end up holding, and the tools it is built
 * with. The briefs used to live inside a dialog, one click away and one
 * click from gone — a visitor had to open five boxes to learn what the page
 * was offering, and a search engine saw five empty tiles. They are on the
 * page now, in full, because they are the content.
 */
const ENGAGEMENTS = [
  {
    title: 'AI Agent Reliability Audit & Fix',
    when:
      'The agent already runs, but routes requests to the wrong place, calls the wrong tools, loses state, loops, or gives unstable answers.',
    deliverable:
      'Root-cause audit, reproducible tests, the fixes themselves, error handling, metrics, and a report on the risks that remain.',
    stack: 'LangGraph, Python, OpenAI/Anthropic, pytest, OpenTelemetry, Langfuse.',
  },
  {
    title: 'RAG Quality & Access-Control Audit',
    when:
      'The bot retrieves the wrong documents, hallucinates, cannot cite its sources, or shows information to the wrong user.',
    deliverable:
      'Retrieval diagnostics, access-control verification, an evaluation dataset, an improved pipeline, and regression tests to hold it there.',
    stack: 'PostgreSQL/pgvector or Qdrant, BM25, RRF, reranking, RAGAS, permission-aware retrieval.',
  },
  {
    title: 'AI Workflow & CRM Integration',
    when:
      'Staff sort leads by hand, update the CRM, draft emails, and pass requests along to each other.',
    deliverable:
      'Automation from the incoming event to the agreed action, with error handling, logging, and protection against duplicates.',
    stack: 'n8n, Python, REST, OAuth, CRM APIs, PostgreSQL.',
  },
  {
    title: 'MCP Server & Secure Tool Integration',
    when:
      'A client needs an agent wired into internal APIs, and that requires access limits, validation, audit, and safe execution.',
    deliverable:
      'An MCP server, tool schemas, authorization, tests, and documentation.',
    stack: 'Python/TypeScript, MCP SDK, OAuth, policy enforcement, structured logging.',
  },
  {
    title: 'Production Readiness & Architecture Review',
    when:
      'A company wants to ship an AI feature but does not know which models, components, limits, and operational machinery it actually needs.',
    deliverable:
      'Architecture review, threat model, a quality-evaluation plan, a cost estimate, and a rollout roadmap.',
    stack: 'LLM APIs, LangGraph, RAG, Docker, PostgreSQL, OpenTelemetry.',
  },
].map((e, i) => ({ ...e, num: num(i) }));

/**
 * The run of an engagement.
 *
 * Four steps, and the order matters: the first one is a conversation that
 * can end the engagement before it starts, and the last one is the handover,
 * which is the only step that has an end date.
 */
const STEPS = [
  {
    title: 'Scope call',
    body: "Thirty minutes on what you're actually trying to achieve. If I'm not the right person, you'll know by the end of it.",
  },
  {
    title: 'Written proposal',
    body: 'Fixed scope, fixed price, explicit deliverables. No open-ended hourly billing.',
  },
  {
    title: 'Build in the open',
    body: 'Weekly updates and a working environment you can look at from week one — not a black box at the end.',
  },
  {
    title: 'Handover',
    body: 'Documented, tested, and yours. I leave when the system runs without me.',
  },
].map((s, i) => ({ ...s, num: num(i) }));

/**
 * The terms.
 *
 * Four lines that answer the question every client asks before the scope
 * call: what shape is this, what does it cost, and what do I own at the
 * end. They sit beside the hero because they are the reason to keep reading
 * — the hero says what the work is, and this says what agreeing to it means.
 */
const TERMS = [
  {
    k: 'Fixed scope',
    v: 'One deliverable, agreed in writing before the work starts.',
  },
  {
    k: 'Fixed price',
    v: 'A number, not an hourly meter.',
  },
  {
    k: 'Open build',
    v: 'Weekly updates and a working environment you can look at from week one.',
  },
  {
    k: 'Yours at the end',
    v: 'Code, tests and documentation — and no dependency on me to run it.',
  },
];

/**
 * What this is not.
 *
 * The part of the page that does the selling. Every offer on this kind of
 * page reads the same — "AI solutions for your business" — and the reader
 * has no way to tell one from another. Saying plainly what an engagement is
 * not gives them something to check themselves against, and it is the
 * shortest honest version of the whole pitch.
 */
const NOT_THIS = [
  {
    title: 'Not a demo.',
    body: 'A working prototype is not an outcome. The engagement ends when the system runs without me, and you keep the code, the tests and the documentation.',
  },
  {
    title: 'Not an open-ended retainer.',
    body: 'Fixed scope, fixed price, explicit deliverables. If the scope moves, it moves in writing, on both sides.',
  },
  {
    title: 'Not a fit for everything.',
    body: 'If the honest answer is that your problem is a configuration change, a prompt, or a vendor that already does this — that is what the scope call will tell you.',
  },
];
---

<Base
  title="Engagements"
  description="Fixed-scope AI engineering engagements: agent reliability audits, RAG quality and access control, workflow automation, MCP tool integration, and architecture review."
>
  <section class="hero eng-hero">
    <!--
      The claim, in its own column. The terms panel beside it is taller than
      the claim is, and when the two shared a grid the extra height was
      handed back to the rows between them — which left a band of dead space
      between the lede and the buttons. One column each, and the panel simply
      hangs lower than the paragraph.
    -->
    <div class="eng-lead">
      <span class="eyebrow" data-reveal>Engagements</span>
      <h1 data-reveal data-reveal-delay="60">Fixed-scope AI engineering.</h1>
      <p class="lede" data-reveal data-reveal-delay="120">
        I take on a small number of engagements at a time — usually where AI
        automation and systems reliability overlap, and where the problem is
        hard enough that a template won't do.
      </p>

      <div class="btn-row eng-cta" data-reveal data-reveal-delay="180">
        <button type="button" class="btn" data-open-letter>Start a conversation</button>
        <a class="btn" href="/projects/">See the work</a>
      </div>
    </div>

    <!--
      The terms, beside the hero. The right half of the band was empty on
      every page but this one; here it holds the four facts a client is
      actually looking for before the scope call.
    -->
    <dl class="terms" data-reveal data-reveal-delay="240">
      {
        TERMS.map((term) => (
          <div class="term">
            <dt>{term.k}</dt>
            <dd>{term.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!--
    The offers. A ledger rather than a grid of tiles: each line is a full
    engagement, so it reads as a list of things that get done instead of a
    wall of headings that all have to be opened to be compared.
  -->
  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">The engagements</h2>
      <span class="card-meta">{ENGAGEMENTS.length} shapes of work</span>
    </div>

    <ol class="ledger">
      {
        ENGAGEMENTS.map((e, i) => (
          <li class="eng" data-reveal data-reveal-delay={Math.min(i, 4) * 50}>
            <div class="eng-head">
              <span class="eng-num" aria-hidden="true">
                {e.num}
              </span>
              <h3 class="eng-title">{e.title}</h3>
            </div>

            <dl class="eng-facts">
              <dt>Symptom</dt>
              <dd>{e.when}</dd>
              <dt>You get</dt>
              <dd>{e.deliverable}</dd>
              <dt>Stack</dt>
              <dd class="eng-stack">{e.stack}</dd>
            </dl>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">How an engagement runs</h2>
      <span class="card-meta">Four steps, in order</span>
    </div>

    <ol class="steps" data-reveal data-reveal-delay="60">
      {
        STEPS.map((s) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">
              {s.num}
            </span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!--
    The honest column. Three lines that say what an engagement is not, which
    is the part of the pitch that actually separates one from another.
  -->
  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">What this is not</h2>
    </div>

    <div class="not-grid">
      {
        NOT_THIS.map((n, i) => (
          <div class="not" data-reveal data-reveal-delay={i * 60}>
            <h3 class="not-title">{n.title}</h3>
            <p class="not-body">{n.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!--
    The close. The page says what the work is, what it costs and what the
    reader ends up holding — and then it stops. A page about taking on work
    has to end with a way to start it, so the two ways in sit side by side:
    the form, and the plain address, so it still works with the script
    blocked.
  -->
  <section class="section close-cta">
    <div class="close-inner">
      <h2 data-reveal data-anim="underline">Start a conversation</h2>
      <p data-reveal data-reveal-delay="60">
        Tell me what you are trying to build and where it is stuck. Half an hour
        on a call is enough for both of us to know whether this is work I should
        be doing — and I will say so if it is not.
      </p>
      <div class="btn-row" data-reveal data-reveal-delay="120">
        <button type="button" class="btn" data-open-letter>Write a message</button>
        <a class="btn" href="mailto:mr.a.maltsev@gmail.com">Email directly</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- The hero ----------------------------------------------------------
     Two columns on a wide screen: the claim on the left, the terms on the
     right. Below the breakpoint they stack, because a four-row panel beside
     a headline only works where there is width for both.
     ---------------------------------------------------------------------- */
  .eng-hero {
    padding-block: clamp(2.2rem, 8vh, 5rem) clamp(1.5rem, 4vh, 3rem);
  }

  @media (min-width: 62rem) {
    .eng-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 23rem);
      column-gap: clamp(2rem, 5vw, 4.5rem);
      align-items: start;
    }
  }

  .eng-cta {
    margin-block: var(--sp-5) 0;
  }

  /* The terms panel: four rows on one ground, separated by hairlines. */
  .terms {
    display: grid;
    gap: 1px;
    margin: var(--sp-5) 0 0;
    padding: 0;
    background: var(--grid);
    border: var(--filet) solid var(--grid);
  }

  .term {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 0.9rem 0.85rem;
    background: var(--papier);
  }

  .term dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--braise);
  }

  .term dd {
    margin: 0;
    color: var(--fort);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  /* ----- The engagements ---------------------------------------------------
     Five rows, each one a full-width line: the title on the left, the brief
     on the right. The grid of tiles this replaced showed five headings and
     hid five briefs behind a button; a visitor could not tell which offer
     was theirs without clicking through all five.
     ---------------------------------------------------------------------- */
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--trait) solid var(--braise);
  }

  .eng {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    border-bottom: var(--filet) solid var(--grid);
  }

  @media (min-width: 52rem) {
    .eng {
      grid-template-columns: minmax(13rem, 19rem) 1fr;
      gap: var(--sp-6);
      align-items: start;
    }
  }

  .eng-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .eng-num {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    color: var(--braise);
    flex-shrink: 0;
  }

  .eng-title {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.2;
  }

  .eng-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    margin: 0;
  }

  @media (min-width: 34rem) {
    .eng-facts {
      grid-template-columns: 5.5rem 1fr;
      gap: 0.55rem 0.9rem;
    }
  }

  .eng-facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--braise);
    padding-top: 0.18rem;
  }

  .eng-facts dd {
    margin: 0 0 0.45rem;
    color: var(--fort);
  }

  .eng-facts dd.eng-stack {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--encre);
  }

  /* ----- How an engagement runs --------------------------------------------
     Four across on a wide screen, two on a tablet, one on a phone. The old
     three-column grid held four steps and left the last one stranded on a
     row of its own.
     ---------------------------------------------------------------------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step {
    border-top: var(--trait) solid var(--braise);
    padding-top: 0.7rem;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    color: var(--braise);
  }

  .step-title {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
  }

  .step-body {
    margin: 0.4rem 0 0;
    color: var(--fort);
  }

  /* ----- What this is not --------------------------------------------------
     Three columns with a rule on top, matching the steps above: the two
     blocks say the same kind of thing about the engagement, so they are
     drawn the same way.
     ---------------------------------------------------------------------- */
  .not-grid {
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .not-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .not {
    border-top: var(--trait) solid var(--braise);
    padding-top: 0.7rem;
  }

  .not-title {
    margin: 0;
    font-size: 1.05rem;
    color: var(--braise);
  }

  .not-body {
    margin: 0.4rem 0 0;
    color: var(--fort);
  }

  /* ----- Close ------------------------------------------------------------
     The block that says what to do next. It is the only thing on the page
     that asks for anything, so it is set apart: a rule above it, a measure
     that reads as a paragraph rather than as a banner, and the two ways in
     side by side — the form and the plain address, so the page still works
     with the script blocked.
     ---------------------------------------------------------------------- */
  .close-cta {
    border-top: var(--trait) solid var(--braise);
  }

  .close-inner {
    max-width: 42rem;
  }

  .close-inner p {
    color: var(--fort);
  }
</style>
