---
import Base from '../layouts/Base.astro';
import DetailModal from '../components/DetailModal.astro';

const num = (i: number) => String(i + 1).padStart(2, '0');

const SERVICES = [
  {
    title: 'AI Agent Reliability Audit & Fix',
    problem:
      'The agent already runs, but routes requests to the wrong place, calls the wrong tools, loses state, loops, or gives unstable answers.',
    result:
      'Root-cause audit, reproducible tests, the fixes themselves, error handling, metrics, and a report on the risks that remain.',
    stack: 'LangGraph, Python, OpenAI/Anthropic, pytest, OpenTelemetry, Langfuse.',
  },
  {
    title: 'RAG Quality & Access-Control Audit',
    problem:
      'The bot retrieves the wrong documents, hallucinates, cannot cite its sources, or shows information to the wrong user.',
    result:
      'Retrieval diagnostics, access-control verification, an evaluation dataset, an improved pipeline, and regression tests to hold it there.',
    stack: 'PostgreSQL/pgvector or Qdrant, BM25, RRF, reranking, RAGAS, permission-aware retrieval.',
  },
  {
    title: 'AI Workflow & CRM Integration',
    problem:
      'Staff sort leads by hand, update the CRM, draft emails, and pass requests along to each other.',
    result:
      'Automation from the incoming event to the agreed action, with error handling, logging, and protection against duplicates.',
    stack: 'n8n, Python, REST, OAuth, CRM APIs, PostgreSQL.',
  },
  {
    title: 'MCP Server & Secure Tool Integration',
    problem:
      'A client needs an agent wired into internal APIs, and that requires access limits, validation, audit, and safe execution.',
    result: 'An MCP server, tool schemas, authorization, tests, and documentation.',
    stack: 'Python/TypeScript, MCP SDK, OAuth, policy enforcement, structured logging.',
  },
  {
    title: 'Production Readiness & Architecture Review',
    problem:
      'A company wants to ship an AI feature but does not know which models, components, limits, and operational machinery it actually needs.',
    result:
      'Architecture review, threat model, a quality-evaluation plan, a cost estimate, and a rollout roadmap.',
    stack: 'LLM APIs, LangGraph, RAG, Docker, PostgreSQL, OpenTelemetry.',
  },
].map((s, i) => ({ ...s, id: `svc-${num(i)}`, num: num(i) }));

const PROJECTS = [
  {
    title: 'Autonomous L1/L2 Customer Support & Ticket Resolution',
    gloss: 'Support without a human in the loop',
    body:
      'Replaces simple rules-based chatbots with agents that do not just answer the question but carry out the action inside internal systems.',
  },
  {
    title: 'Inbound Lead Qualification & Enrichment',
    gloss: 'B2B sales',
    body:
      'Replaces the first-contact SDR. The agent enriches the company record, scores the lead against a scoring model, and books the call itself.',
  },
  {
    title: 'Intelligent Document & Invoice Processing',
    gloss: 'Accounts payable automation',
    body:
      'Automates the work of accounting and procurement: reading awkward PDFs, scans, and receipts, and posting the extracted fields into the ERP.',
  },
  {
    title: 'Automated Candidate Screening & HR Sourcing',
    gloss: 'Resume screening and first interviews',
    body:
      'Speeds up hiring — working through hundreds of applications, matching them against a complex role profile, and running a basic technical and HR screen.',
  },
  {
    title: 'Security & Incident Response Automation',
    gloss: 'SOC / AI security',
    body:
      'Automates the work of security engineers: agents triage thousands of security alerts a day and filter out the false positives.',
  },
  {
    title: 'Enterprise Knowledge Management & Research Agent',
    gloss: 'GraphRAG',
    body:
      'Replaces plain keyword search with a research agent that finds the hidden connections across thousands of company documents and builds sourced reports from them.',
  },
  {
    title: 'Operational Workflow & Employee Onboarding',
    gloss: 'Internal ops',
    body:
      'Removes bureaucratic busywork inside IT, FinTech, and retail companies when a new employee joins or a resource is requested.',
  },
].map((p, i) => ({ ...p, id: `prj-${num(i)}`, num: num(i) }));

const SERVICE_PANELS = SERVICES.map((s) => ({
  id: s.id,
  title: s.title,
  rows: [
    ['Problem', s.problem],
    ['Result', s.result],
    ['Stack', s.stack],
  ] as [string, string][],
  // Names the row that should be set in the mono face; the others are prose.
  stack: 'Stack',
}));

const PROJECT_PANELS = PROJECTS.map((p) => ({
  id: p.id,
  title: p.title,
  gloss: p.gloss,
  body: p.body,
}));

const STEPS = [
  {
    title: 'Scope call',
    body: "Thirty minutes on what you're actually trying to achieve. If I'm not the right person, you'll know by the end of it.",
  },
  {
    title: 'Written proposal',
    body: 'Fixed scope, fixed price, explicit deliverables. No open-ended hourly billing.',
  },
  {
    title: 'Build in the open',
    body: 'Weekly updates and a working environment you can look at from week one — not a black box at the end.',
  },
  {
    title: 'Handover',
    body: 'Documented, tested, and yours. I leave when the system runs without me.',
  },
].map((s, i) => ({ ...s, num: num(i) }));
---

<Base title="Freelance" description="Freelance AI engineering: agent reliability audits, RAG quality, workflow automation, MCP tool integration, and architecture review.">
  <section class="hero">
    <span class="eyebrow" data-reveal>Freelance</span>
    <h1 data-reveal data-reveal-delay="60">Available for work</h1>
    <p class="lede" data-reveal data-reveal-delay="120">
      I take on a small number of engagements at a time — usually where AI
      automation and systems reliability overlap, and where the problem is hard
      enough that a template won't do.
    </p>

    <div class="btn-row" data-reveal data-reveal-delay="180">
      <a class="btn" href="/projects/">See the work</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">Services</h2>
    </div>

    <div class="card-grid svc-grid" data-anim="tilt">
      {
        SERVICES.map((s, i) => (
          <div class="card svc" data-reveal data-reveal-delay={i * 60}>
            <span class="svc-num" aria-hidden="true">
              {s.num}
            </span>
            {/* The button sits in the heading and its ::after is stretched over
                the whole card, so the entire tile is the hit target while the
                accessible name stays one clean label. A <button> cannot legally
                wrap an <h3>, so the heading wraps the button instead. */}
            <h3 class="svc-title">
              <button
                type="button"
                class="svc-open"
                data-open-dialog="serviceModal"
                data-panel={s.id}
              >
                {s.title}
                <span class="svc-cue">details</span>
              </button>
            </h3>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">Projects</h2>
    </div>

    <div class="card-grid" data-anim="tilt">
      {
        PROJECTS.map((p, i) => (
          <div class="card proj" data-reveal data-reveal-delay={i * 40}>
            <span class="proj-num" aria-hidden="true">
              {p.num}
            </span>
            <h3 class="proj-title">
              <button type="button" class="svc-open" data-open-dialog="projectModal" data-panel={p.id}>
                {p.title}
                <span class="proj-gloss">{p.gloss}</span>
                <span class="svc-cue">details</span>
              </button>
            </h3>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 data-reveal data-anim="underline">How it works</h2>
    <ol class="steps" data-reveal data-reveal-delay="60">
      {
        STEPS.map((s) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">
              {s.num}
            </span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <DetailModal id="serviceModal" panels={SERVICE_PANELS} />
  <DetailModal id="projectModal" panels={PROJECT_PANELS} />

  <script>
    import '../scripts/dialogs.js';
  </script>
</Base>

<style>
  /* ----- Services ---------------------------------------------------------
     Five offerings, each a tile that opens its brief in a dialog. The grid is
     a little wider than the default card minimum because the titles run to two
     lines on some of them.
     ---------------------------------------------------------------------- */
  .svc-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
  }

  .svc-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--braise);
  }

  /* ----- Openers ----------------------------------------------------------
     Both grids are tiles that open a dialog, so the trigger styling is shared.
     The card keeps its own heading and the button carries the label: a heading
     is flow content and a button may not wrap one, but a button inside a
     heading is valid and reads the way a reader expects.
     ---------------------------------------------------------------------- */
  .svc-title,
  .proj-title {
    margin: 0;
  }

  .svc-open {
    display: block;
    width: 100%;
    text-align: start;
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  /* Stretch the trigger over the whole tile. The card is the positioned parent,
     so the entire card becomes the hit target and the pointer highlight in
     animation.css still lands on the card rather than on a text-sized box. */
  .svc-open::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* The focus ring is drawn on the card: the button's own box is only as tall
     as its text, so a ring on it would not say how large the target is. */
  .card:has(.svc-open:focus-visible) {
    outline: var(--trait) solid var(--braise);
    outline-offset: 2px;
  }

  .svc-cue {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--braise);
  }

  /* Only the arrow moves, so the tile itself holds still the way the rest of
     the cards on the site lift. */
  .svc-cue::after {
    content: ' →';
    display: inline-block;
    transition: transform 160ms ease;
  }

  .card:hover .svc-cue::after,
  .svc-open:focus-visible .svc-cue::after {
    transform: translateX(3px);
  }

  /* ----- Projects --------------------------------------------------------- */
  .proj-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--braise);
  }

  .proj-gloss {
    display: block;
    margin-top: 0.25rem;
    font-style: italic;
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--fort);
  }

  /* ----- How it works -----------------------------------------------------
     Three across, full page width. The reading cap that held this to 68ch was
     right for a paragraph and wrong for four short steps, which left the block
     occupying a third of the canvas for no reason.
     ---------------------------------------------------------------------- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step {
    border-top: var(--trait) solid var(--braise);
    padding-top: 0.7rem;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--braise);
  }

  .step-title {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
  }

  .step-body {
    margin: 0.4rem 0 0;
    color: var(--fort);
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-cue::after {
      transition: none;
    }
  }
</style>