---
import Base from '../layouts/Base.astro';
import { contactMailto } from '../lib/schema';

/**
 * The engagements.
 *
 * Each one is a shape of work rather than a product: the symptom that brings
 * someone here, the thing they end up holding, and the tools it is built
 * with. They sit on the page in full, because they are the content.
 */
const ENGAGEMENTS = [
  {
    title: 'AI Agent Reliability Audit & Fix',
    when:
      'The agent already runs, but routes requests to the wrong place, calls the wrong tools, loses state, loops, or gives unstable answers.',
    deliverable:
      'Root-cause audit, reproducible tests, the fixes themselves, error handling, metrics, and a report on the risks that remain.',
    stack: 'LangGraph, Python, OpenAI/Anthropic, pytest, OpenTelemetry, Langfuse.',
  },
  {
    title: 'RAG Quality & Access-Control Audit',
    when:
      'The bot retrieves the wrong documents, hallucinates, cannot cite its sources, or shows information to the wrong user.',
    deliverable:
      'Retrieval diagnostics, access-control verification, an evaluation dataset, an improved pipeline, and regression tests to hold it there.',
    stack: 'PostgreSQL/pgvector or Qdrant, BM25, RRF, reranking, RAGAS, permission-aware retrieval.',
  },
  {
    title: 'AI Workflow & CRM Integration',
    when:
      'Staff sort leads by hand, update the CRM, draft emails, and pass requests along to each other.',
    deliverable:
      'Automation from the incoming event to the agreed action, with error handling, logging, and protection against duplicates.',
    stack: 'n8n, Python, REST, OAuth, CRM APIs, PostgreSQL.',
  },
  {
    title: 'MCP Server & Secure Tool Integration',
    when:
      'A client needs an agent wired into internal APIs, and that requires access limits, validation, audit, and safe execution.',
    deliverable:
      'An MCP server, tool schemas, authorization, tests, and documentation.',
    stack: 'Python/TypeScript, MCP SDK, OAuth, policy enforcement, structured logging.',
  },
  {
    title: 'Production Readiness & Architecture Review',
    when:
      'A company wants to ship an AI feature but does not know which models, components, limits, and operational machinery it actually needs.',
    deliverable:
      'Architecture review, threat model, a quality-evaluation plan, a cost estimate, and a rollout roadmap.',
    stack: 'LLM APIs, LangGraph, RAG, Docker, PostgreSQL, OpenTelemetry.',
  },
].map((e, i) => ({ ...e, num: String(i + 1).padStart(2, '0') }));

/**
 * The run of an engagement.
 *
 * Four steps, and the order matters: the first one is a conversation that
 * can end the engagement before it starts, and the last one is the handover,
 * which is the only step that has an end date.
 */
const STEPS = [
  {
    title: 'Scope call',
    body: "Thirty minutes on what you're actually trying to achieve. If I'm not the right person, you'll know by the end of it.",
  },
  {
    title: 'Written proposal',
    body: 'Fixed scope, fixed price, explicit deliverables. No open-ended hourly billing.',
  },
  {
    title: 'Build in the open',
    body: 'Weekly updates and a working environment you can look at from week one. No black box at the end.',
  },
  {
    title: 'Handover',
    body: 'Documented, tested, and yours. I leave when the system runs without me.',
  },
].map((s, i) => ({ ...s, num: String(i + 1).padStart(2, '0') }));

/**
 * The terms.
 *
 * Four lines that answer the question every client asks before the scope
 * call: what shape is this, what does it cost, and what do I own at the
 * end. They sit in the window beside the hero because they are the reason
 * to keep reading — the hero says what the work is, and this says what
 * agreeing to it means.
 */
const TERMS = [
  {
    k: 'fixed scope',
    v: 'One deliverable, agreed in writing before the work starts.',
  },
  {
    k: 'fixed price',
    v: 'A number, not an hourly meter.',
  },
  {
    k: 'open build',
    v: 'Weekly updates and a working environment you can look at from week one.',
  },
  {
    k: 'yours at the end',
    v: 'Code, tests and documentation. No dependency on me to run it.',
  },
];

/**
 * What this is not.
 *
 * The part of the page that does the selling. Every offer on this kind of
 * page reads the same — "AI solutions for your business" — and the reader
 * has no way to tell one from another. Saying plainly what an engagement is
 * not gives them something to check themselves against, and it is the
 * shortest honest version of the whole pitch.
 */
const NOT_THIS = [
  {
    title: 'Not a demo.',
    body: 'A working prototype is not an outcome. The engagement ends when the system runs without me, and you keep the code, the tests and the documentation.',
  },
  {
    title: 'Not an open-ended retainer.',
    body: 'Fixed scope, fixed price, explicit deliverables. If the scope moves, it moves in writing, on both sides.',
  },
  {
    title: 'Not a fit for everything.',
    body: 'If the honest answer is that your problem is a configuration change, a prompt, or a vendor that already does this, that is what the scope call will tell you.',
  },
];
---

<Base
  title="Engagements"
  description="Fixed-scope AI engineering engagements: agent reliability audits, RAG quality and access control, workflow automation, MCP tool integration, and architecture review."
>
  <!--
    The page is a machine with three directories in it: the terms, the
    engagements, and the way an engagement runs. Each is a window with its
    own title, so the reader can tell at a glance which file they are
    reading — the same way the shell tells you where you are.
  -->
  <section class="hero eng-hero">
    <!--
      The claim, in its own column. The terms window beside it is taller
      than the claim is, and when the two shared a grid the extra height was
      handed back to the rows between them — which left a band of dead space
      between the lede and the buttons. One column each, and the window
      simply hangs lower than the paragraph.
    -->
    <div class="eng-lead">
      <span class="eyebrow"><span class="pulse-dot"></span>Engagements</span>
      <h1 data-anim="type">Fixed-scope AI engineering</h1>

      <p class="tty-prompt" data-reveal>
        <span class="who">root</span><span class="sep">@</span><span
          >amaltsev</span>
        ><span class="sep">:</span><span class="path">~/engagements</span><span
          class="sep"
          >$</span
        >
        <span class="tty-cmd">ls -la</span>
      </p>

      <p class="lede" data-reveal data-reveal-delay="60">
        I take on a small number of engagements at a time, usually where AI
        automation and systems reliability overlap, and where the problem is
        hard enough that a template won't do.
      </p>

      <!--
        One way forward here. The page used to open with a "Start a
        conversation" button and close with a "Write a message" button that
        both opened the same form the status bar already opens from every
        page — the same offer twice, and a button on a page whose subject is
        work that has already been scoped. The form is still one click away,
        in the strip at the top of the screen; the close of the page is where
        the writing happens.
      -->
      <div class="btn-row eng-cta" data-reveal data-reveal-delay="120">
        <a class="btn" href="/projects/">See the work</a>
      </div>
    </div>

    <!--
      The terms, beside the hero. The right half of the band was empty on
      every page but this one; here it holds the four facts a client is
      actually looking for before the scope call.
    -->
    <div class="tty tty-terms" data-reveal data-reveal-delay="180">
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/engagements/terms</span>
        <span class="tty-right" aria-hidden="true">{TERMS.length} terms</span>
      </div>

      <div class="tty-body">
        <p class="tty-prompt tty-cmd-line">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/engagements</span><span
            class="sep"
            >$</span
          >
          <span class="tty-cmd">cat terms.txt</span>
        </p>

        <div class="ls ls-terms">
          {
            TERMS.map((term) => (
              <div class="ls-row">
                <span class="ls-term-k">{term.k}</span>
                <span class="ls-term-v">{term.v}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!--
    The offers. A ledger rather than a grid of tiles: each line is a full
    engagement, so it reads as a list of things that get done instead of a
    wall of headings that all have to be opened to be compared.
  -->
  <section class="section">
    <div class="tty-fit">
      <div class="section-head">
        <h2 data-reveal data-anim="underline">The engagements</h2>
        <span class="card-meta">{ENGAGEMENTS.length} shapes of work</span>
      </div>

      <div class="tty tty-eng" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/engagements</span>
        <span class="tty-right" aria-hidden="true">
          {ENGAGEMENTS.length} entries
        </span>
      </div>

      <div class="tty-body">
        <p class="tty-prompt tty-cmd-line">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/engagements</span><span
            class="sep"
            >$</span
          >
          <span class="tty-cmd">cat engagements/*.md</span>
        </p>

        {
          ENGAGEMENTS.map((e, i) => (
            <article
              class="eng"
              data-reveal
              data-reveal-delay={Math.min(i, 4) * 50}
            >
              <div class="eng-head">
                <span class="eng-num" aria-hidden="true">
                  {e.num}
                </span>
                <h3 class="eng-title">{e.title}</h3>
              </div>

              <dl class="eng-facts">
                <dt>symptom</dt>
                <dd>{e.when}</dd>
                <dt>deliver</dt>
                <dd>{e.deliverable}</dd>
                <dt>stack</dt>
                <dd class="eng-stack">{e.stack}</dd>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2 data-reveal data-anim="underline">How an engagement runs</h2>
      <span class="card-meta">{STEPS.length} steps, in order</span>
    </div>

    <div class="tty tty-run" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on"></i>
          <i class="led led-on"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/engagements/run</span>
        <span class="tty-right" aria-hidden="true">run --engagement</span>
      </div>

      <div class="tty-body">
        <p class="tty-prompt tty-cmd-line">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/engagements</span><span
            class="sep"
            >$</span
          >
          <span class="tty-cmd">make run</span>
        </p>

        <ol class="pipe">
          {
            STEPS.map((s, i) => (
              <li class="pipe-step">
                <span class="pipe-num">{s.num}</span>
                <h3 class="pipe-title">{s.title}</h3>
                <p class="pipe-body">{s.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!--
    The honest column. Three lines that say what an engagement is not, which
    is the part of the pitch that actually separates one from another.
  -->
  <section class="section">
    <div class="tty-fit">
      <div class="section-head">
        <h2 data-reveal data-anim="underline">What this is not</h2>
        <span class="card-meta">Read this one</span>
      </div>

      <div class="tty tty-limits" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-warn"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/engagements/limits</span>
        <span class="tty-right" aria-hidden="true">{NOT_THIS.length} exclusions</span>
      </div>

      <div class="tty-body">
        <p class="tty-prompt tty-cmd-line">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/engagements</span><span
            class="sep"
            >$</span
          >
          <span class="tty-cmd">cat limits.txt</span>
        </p>

        <ul class="not-list">
          {
            NOT_THIS.map((n, i) => (
              <li class="not" data-reveal data-reveal-delay={i * 60}>
                <span class="not-mark" aria-hidden="true">
                  ■
                </span>
                <div class="not-text">
                  <h3 class="not-title">{n.title}</h3>
                  <p class="not-body">{n.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    </div>
  </section>

  <!--
    The close. The page says what the work is, what it costs and what the
    reader ends up holding — and then it stops. A page about taking on work
    has to end with a way to start it, so this block is the one place on the
    site where the invitation is the whole point. The address is on the
    command line, the way a mail command is written: the way to start the
    conversation is the thing you type.
  -->
  <section class="section close-cta">
    <div class="tty tty-close" data-reveal>
      <div class="tty-bar">
        <span class="tty-leds" aria-hidden="true">
          <i class="led led-on led-blink"></i>
          <i class="led led-off"></i>
          <i class="led led-off"></i>
        </span>
        <span class="tty-title">~/engagements/contact</span>
        <span class="tty-right" aria-hidden="true">ready</span>
      </div>

      <div class="tty-body">
        <!--
          The command is written the way a shell writes a long one: the
          argument on the next line, under the continuation prompt. It is
          also the only way to write on this page, so it belongs on the
          command line rather than in the sentence under it.
        -->
        <p class="tty-prompt tty-cmd-line">
          <span class="who">root</span><span class="sep">@</span><span
            >amaltsev</span>
          ><span class="sep">:</span><span class="path">~/engagements</span><span
            class="sep"
            >$</span
          >
          <span class="tty-cmd">mail -s "engagement" \</span>
        </p>
        <p class="tty-prompt tty-cmd-line tty-cont-line">
          <span class="tty-cont" aria-hidden="true">&gt;</span>
          <a class="post-cta-mail" href={contactMailto('An engagement')}
            >mr.a.maltsev@gmail.com</a
          >
        </p>

        <p class="close-note">
          Tell me what you are trying to build and where it is stuck. Half an
          hour on a call is enough for both of us to know whether this is
          work I should be doing. I will say so if it is not.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----- The hero ----------------------------------------------------------
     Two columns on a wide screen: the claim on the left, the terms window on
     the right. Below the breakpoint they stack, because a four-row window
     beside a headline only works where there is width for both.
     ---------------------------------------------------------------------- */
  .eng-hero {
    display: grid;
    /* Stacked, the two halves of the hero need a gap between them: without
       one the window butts straight against the button above it. */
    gap: 2.2rem;
    padding-block: clamp(2.2rem, 8vh, 5rem) clamp(1.5rem, 4vh, 3rem);
  }

  @media (min-width: 62rem) {
    .eng-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      column-gap: clamp(2rem, 5vw, 4.5rem);
      row-gap: 0;
      align-items: start;
    }
  }

  .eng-cta {
    margin-block: var(--sp-5) 0;
  }

  /* The command line that sits under the headline. */
  .eng-hero .tty-prompt {
    margin-block: 0.9rem 0;
  }

  /* ----- The terms window -------------------------------------------------
     Four rows, each one a key and its value. The key column is fixed-width
     so the values line up under each other, the way a listing does.
     ---------------------------------------------------------------------- */
  .tty-terms .tty-body {
    padding-block: 1.9rem 1.2rem;
  }

  .ls-terms .ls-row {
    /* Wide enough for the longest key — "yours at the end" — so the value
       never starts on top of it. */
    grid-template-columns: 17ch minmax(0, 1fr);
    gap: 0 1.5ch;
    align-items: baseline;
  }

  .ls-term-k {
    color: var(--braise);
    letter-spacing: 0.06em;
  }

  .ls-term-v {
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  /* On a phone the key column leaves too little for the value, so the two
     stack: the key on its own row, the sentence under it. */
  @media (max-width: 40rem) {
    .ls-terms .ls-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .ls-terms .ls-term-v {
      margin-bottom: 0.5rem;
    }
  }

  /* ----- The engagements window -------------------------------------------
     Five entries, each one a title and three facts. The facts are labelled
     the way a file is labelled: symptom, deliver, stack.
     ---------------------------------------------------------------------- */
  .tty-eng .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  .eng {
    padding-block: 0.9rem;
    border-top: var(--filet) solid color-mix(in srgb, var(--grid) 60%, transparent);
  }

  .eng:first-of-type {
    border-top: 0;
    padding-top: 0.2rem;
  }

  .eng-head {
    display: flex;
    align-items: baseline;
    gap: 0.8ch;
  }

  .eng-num {
    color: var(--braise);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .eng-title {
    margin: 0;
    font-size: clamp(1rem, 2.1vw, 1.16rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .eng-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    margin: 0.55rem 0 0;
  }

  @media (min-width: 34rem) {
    .eng-facts {
      grid-template-columns: 7ch 1fr;
      gap: 0.5rem 1.2ch;
    }
  }

  .eng-facts dt {
    color: var(--faible);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-top: 0.24rem;
  }

  .eng-facts dd {
    margin: 0;
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .eng-facts dd.eng-stack {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--encre);
  }

  /* ----- The pipeline -----------------------------------------------------
     Four steps, left to right, with the arrow drawn in the art face between
     them — the box-drawing characters have to come from one face, or the
     line breaks up and the arrow does not meet the rule it points along.
     Below the breakpoint the steps stack and the arrows go away.
     ---------------------------------------------------------------------- */
  .pipe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem 3.4rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 58rem) {
    .pipe {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pipe-step {
    position: relative;
  }

  @media (min-width: 58rem) {
    .pipe-step:not(:last-child)::after {
      content: '──▶';
      position: absolute;
      right: -2.9rem;
      top: 0.05em;
      color: var(--faible);
      font-family: var(--font-art);
      font-size: 0.85rem;
      letter-spacing: 0;
    }
  }

  @media (max-width: 57.99rem) {
    /* Stacked, the steps are a list again: a dotted rule between them does
       the work the arrow did on one line. */
    .pipe-step + .pipe-step {
      border-top: var(--filet) dotted var(--grid);
      padding-top: 1.2rem;
    }
  }

  .pipe-num {
    color: var(--braise);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  .pipe-title {
    margin: 0.3rem 0 0;
    font-size: 1rem;
    line-height: 1.25;
  }

  .pipe-body {
    margin: 0.45rem 0 0;
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* ----- What this is not --------------------------------------------------
     Three exclusions. The marker is a filled block in the art face: it is
     the one glyph in the shipped face that says "not this" without needing
     a word next to it, and the word is still there for anyone who does not
     read the shape.
     ---------------------------------------------------------------------- */
  .tty-limits .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  .not-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .not {
    display: grid;
    grid-template-columns: 1.2ch minmax(0, 1fr);
    gap: 0 1ch;
    align-items: baseline;
  }

  .not-mark {
    color: var(--erreur);
    font-family: var(--font-art);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .not-title {
    margin: 0;
    font-size: 1rem;
    color: var(--braise);
  }

  .not-body {
    margin: 0.3rem 0 0;
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 74ch;
  }

  /* ----- Close ------------------------------------------------------------
     The block that says what to do next. It is the only thing on the page
     that asks for anything, so it is set apart: its own window, and a
     measure that reads as a paragraph rather than as a banner.
     ---------------------------------------------------------------------- */
  .close-cta {
    border-top: var(--trait) solid var(--braise);
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .tty-close .tty-body {
    padding-block: 1.9rem 1.4rem;
  }

  /* The close is a window around a paragraph and an address. It shares the
     width of the window above it — the two sit one under the other at the
     foot of the page, and they have to line up — and stands in the middle
     of the column. */
  .tty-limits,
  .tty-close {
    width: 45.25rem;
    max-width: 100%;
    margin-inline: auto;
  }

  .close-note {
    margin: 0.4rem 0 0;
    max-width: 62ch;
    color: var(--fort);
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* The address is on the command line, so it inherits the command's colour
     and the underline is the only thing marking it as a link. */
  .tty-close .post-cta-mail,
  .tty-close .post-cta-mail:hover {
    color: var(--creme);
    text-decoration-color: var(--creme);
  }
</style>
