---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/animation.css';
import '../styles/os.css';
import '../styles/tty.css';
import Head from '../components/Head.astro';
import StatusBar from '../components/StatusBar.astro';
import Header from '../components/Header.astro';
import LetterModal from '../components/LetterModal.astro';
import Palette from '../components/Palette.astro';
import Footer from '../components/Footer.astro';

// `skills.css` is not imported here. It styles one page and one page only —
// the toolkit tree on /experience/ — and importing it from the layout put it
// on every page of the site, including the ones that have no tree. The page
// imports it itself; Astro then emits it as a chunk that only that page
// loads.

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** What the social card shows. Defaults to the site's own line. */
  imageAlt?: string;
  type?: string;
  /** Extra schema.org nodes for this page, added to the site graph. */
  schema?: Record<string, unknown>[];
}

const { title, description, image, imageAlt, type, schema } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="phosphore">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Head
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      schema={schema}
    />
  </head>

  <body class="crt">
    <!--
      Boot readout. Painted by JS only, and only once per session: a second
      visitor to another page should not sit through it again. Under
      reduced-motion it is never painted at all.
    -->
    <div class="boot-overlay" id="bootOverlay" hidden aria-hidden="true">
      <div class="boot-box">
        <div id="bootLines"></div>
        <div class="boot-bar"><i></i></div>
      </div>
    </div>

    <div class="progress-rail" aria-hidden="true"><i id="progressBar"></i></div>

    <!-- Idle background: a drifting grid and two slow accent blooms. Both are
         fixed, pointer-events:none and transform-only, so they cost nothing
         while reading. -->
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow" aria-hidden="true"></div>

    <!--
      The tube. A single nearly-invisible layer that brightens and dims the
      whole page by about one percent, the way a CRT's refresh never quite
      settles. It sits above the content and takes no pointer events, so it
      costs one composited layer and no layout.

      Under `prefers-reduced-motion` the stylesheet drops it to nothing: a
      page that cannot stop moving should not have a light that never stops
      moving either.
    -->
    <div class="tube-flicker" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <!--
      The skip link has to move the focus, not only the scroll position.

      A fragment link scrolls the page, but the focus stays on the link: the
      next Tab press sends the reader back into the navigation they just
      tried to skip. The target is focusable — `tabindex="-1"` on `<main>` —
      so the browser can put the focus there; the script is what asks it to.

      It is inline and dependency-free on purpose: the skip link is the first
      thing a keyboard reader meets, and it must work before anything else
      has loaded.
    -->
    <script is:inline>
      (function () {
        var link = document.querySelector('.skip-link');
        if (!link) return;
        link.addEventListener('click', function () {
          var target = document.getElementById('main');
          if (!target) return;
          try {
            target.focus({ preventScroll: true });
          } catch (e) {
            target.focus();
          }
        });
      })();
    </script>

    <!--
      The site header is a landmark. Without a `<header>` element the banner
      was only implied by the class name, and a screen reader had no way to
      jump to it — the reader had to walk the whole navigation.

      `display: contents` keeps the two bars exactly as they were: the status
      bar sticks to the top of the viewport and the menu bar sticks just below
      it, and each does that against the page, not against each other. A
      wrapper with a box of its own would change that relationship.
    -->
    <header class="site-header" style="display: contents">
      <StatusBar />
      <Header currentPath={Astro.url.pathname} />
    </header>

    <!--
      `tabindex="-1"` makes the content programmatically focusable, which is
      what the skip link needs: a plain fragment link scrolls the page but
      leaves the focus on the link, so the next Tab press sends the reader
      back into the navigation they just tried to skip. With the target
      focusable, the browser moves the focus there as well.
    -->
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>

    <!--
      The dialogs come before the footer on purpose. The footer is the last
      thing in the document: a reader who reaches the end of a page should
      meet the footer's links, not the invisible controls of two dialogs that
      are closed.
    -->
    <LetterModal />
    <Palette />

    <Footer />

    <script>
      import '../scripts/os.js';
    </script>
  </body>
</html>
