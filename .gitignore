/static/processed_images/**
/public

# Astro build output. `npm run build` emits dist/, but verification runs used
# dist-verifyN/ and friends; one rule covers the family.
/dist*/

node_modules/
.astro/

# Python leftovers from the legacy build.py generator
__pycache__/
*.py[cod]
.venv/
venv/
.eggs/

# One-off scripts and audit artifacts from the Astro migration, all kept at the
# repo root with a leading underscore. The three the build depends on stay tracked.
# (`python _audit_links_astro.py` gates the deploy; `_gen_redirects.py` writes
# the legacy-URL stubs in static/; `_gen_og.mjs` draws static/og.png, which is
# committed as a binary — the generator has to be in the repo to change it.)
/_*
!/_audit_links_astro.py
!/_gen_redirects.py
!/_gen_og.mjs

# A single-line HTML fragment an audit script dumped here. It looks like Markdown
# but is a slice of about.astro; src/pages/ is the source.
/ELEMENTS.md

# Local tooling / editor state
.vscode/
.idea/
.claude/
.claude-flow/
tmp/

# Agent notes that are not part of the site
QWEN.md
CLAUDE.md

# Secrets and logs
.env
.env.*
!.env.example
*.log
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db
desktop.ini